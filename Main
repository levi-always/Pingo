	{"Mono", rgb(200, 200, 205), rgb(120, 122, 130)},
}

local BLACK = Color3.new(0, 0, 0)
local THEMES = {}
for _, t in ipairs(THEME_LIST) do
	local d = {Accent = t[2], Accent2 = t[3], AccentDark = t[2]:Lerp(BLACK, 0.35), Accent2Dark = t[3]:Lerp(BLACK, 0.35)}
	for k, v in pairs(BASE) do d[k] = v end
	THEMES[t[1]] = d
end

local currentTheme = "Ruby"
local function T(key) return THEMES[currentTheme][key] end

local bindings = setmetatable({}, {__mode = "k"})
local gradients = setmetatable({}, {__mode = "k"})
local ringRefreshers = {}

local function bind(obj, prop, key, animate)
	local b = bindings[obj]
	if not b then b = {}; bindings[obj] = b end
	b[prop] = key
	if animate then tw(obj, 0.25, {[prop] = T(key)}) else obj[prop] = T(key) end
end

local function seq(keys)
	local pts, n = {}, #keys
	for i, k in ipairs(keys) do
		pts[i] = ColorSequenceKeypoint.new((i - 1) / (n - 1), T(k))
	end
	return ColorSequence.new(pts)
end

local function grad(keys, parent, props)
	local g = new("UIGradient", props or {})
	g.Parent = parent
	gradients[g] = keys
	g.Color = seq(keys)
	return g
end

function PingoUI.SetTheme(name)
	if not THEMES[name] then return end
	currentTheme = name
	for obj, b in pairs(bindings) do
		if obj.Parent then
			for prop, key in pairs(b) do tw(obj, 0.35, {[prop] = T(key)}) end
		end
	end
	for g, keys in pairs(gradients) do
		if g.Parent then g.Color = seq(keys) end
	end
	for _, fn in pairs(ringRefreshers) do fn() end
end

local function mkText(class, props, key)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.Font = props.Font or Enum.Font.GothamMedium
	local o = new(class, props)
	bind(o, "TextColor3", key or "Text")
	return o
end

local function candidates()
	local list = {}
	if gethui then pcall(function() table.insert(list, gethui()) end) end
	pcall(function() table.insert(list, game:GetService("CoreGui")) end)
	local lp = Players.LocalPlayer
	if lp then table.insert(list, lp:WaitForChild("PlayerGui")) end
	return list
end

-- ============================================================
--  WINDOW
-- ============================================================
function PingoUI.CreateWindow(title, version, config)
	config = config or {}
	title = title or "Pingo"
	version = version or "Beta"
	local updateName = config.Update or "ThePerfect"
	local W, H = config.Width or 660, config.Height or 420
	local win = {SideTabs = {}, Elements = {}, Conns = {}, Counter = 0, Opened = false, SearchText = "", SizeMul = 1}

	local function A(signal, fn)
		local c = signal:Connect(fn)
		table.insert(win.Conns, c)
		return c
	end

	-- ---------- ScreenGui ----------
	local guiName = "PingoUI_" .. title
	for _, p in ipairs(candidates()) do
		local old = p:FindFirstChild(guiName)
		if old then old:Destroy() end
	end
	local gui = new("ScreenGui", {Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
	for _, p in ipairs(candidates()) do
		local ok = pcall(function() gui.Parent = p end)
		if ok and gui.Parent == p then break end
	end

	local function isPress(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end

	local function makeDraggable(handle, target, onTap)
		local dragging, moved, startMouse, startPos = false, false, nil, nil
		handle.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging, moved = true, false
				startMouse, startPos = input.Position, target.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						if dragging and not moved and onTap then onTap() end
						dragging = false
					end
				end)
			end
		end)
		A(UIS.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - startMouse
				if d.Magnitude > 6 then moved = true end
				if moved then
					target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
				end
			end
		end)
	end

	-- ---------- Holder / Main ----------
	local Holder = new("Frame", {Name = "Holder", Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, Parent = gui})
	local fitScale = new("UIScale", {Parent = Holder})
	local function targetScale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local fit = math.clamp(math.min((vp.X - 20) / W, (vp.Y - 20) / H), 0.4, 1)
		return math.clamp(fit * win.SizeMul, 0.3, 1.8)
	end
	local function refit(animate)
		if animate then tw(fitScale, 0.4, {Scale = targetScale()}, BACK) else fitScale.Scale = targetScale() end
	end
	refit(false)
	if workspace.CurrentCamera then
		A(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function() refit(false) end)
	end

	local Main = new("CanvasGroup", {Name = "Main", Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0, GroupTransparency = 1, Parent = Holder}, {corner(12)})
	bind(Main, "BackgroundColor3", "Background")
	local openScale = new("UIScale", {Scale = 0.88, Parent = Main})
	local mainStroke = new("UIStroke", {Thickness = 1.5, Parent = Main})
	bind(mainStroke, "Color", "Stroke")

	-- floating glow orbs
	local function aura(x, y, size, dx, dy, dur)
		local a = new("Frame", {Size = UDim2.fromOffset(size, size), Position = UDim2.fromScale(x, y), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0.93, BorderSizePixel = 0, Parent = Main}, {corner(size / 2)})
		bind(a, "BackgroundColor3", "Accent")
		TweenService:Create(a, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Position = UDim2.fromScale(x + dx, y + dy)}):Play()
	end
	aura(0.75, 0.3, 300, 0.12, 0.2, 7)
	aura(0.55, 0.85, 240, -0.15, -0.15, 9)

	-- ---------- Sidebar ----------
	local Sidebar = new("Frame", {Name = "Sidebar", Size = UDim2.new(0, 170, 1, 0), BorderSizePixel = 0, Parent = Main})
	bind(Sidebar, "BackgroundColor3", "Sidebar")
	local divider = new("Frame", {Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BorderSizePixel = 0, Parent = Sidebar})
	bind(divider, "BackgroundColor3", "Stroke")

	local dragArea = new("Frame", {Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, Active = true, Parent = Sidebar})
	makeDraggable(dragArea, Holder)

	local titleRow = new("Frame", {Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 30), BackgroundTransparency = 1, Parent = Sidebar}, {
		new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder}),
	})
	local titleLbl = mkText("TextLabel", {Text = title, Font = Enum.Font.GothamBold, TextSize = 24, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 30), LayoutOrder = 1, Parent = titleRow}, "White")
	local tg = grad({"Accent", "Accent2", "Accent"}, titleLbl, {Offset = Vector2.new(-0.6, 0)})
	TweenService:Create(tg, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.6, 0)}):Play()
	mkText("TextLabel", {Text = version, Font = Enum.Font.Gotham, TextSize = 11, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 20), LayoutOrder = 2, Parent = titleRow}, "SubText")

	-- Nav: deterministic layout (so the sliding pill always lands exactly)
	local navH = H - 62
	local Nav = new("Frame", {Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, -1, 1, -62), BackgroundTransparency = 1, Parent = Sidebar})
	local Pill = new("Frame", {Name = "Pill", Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, 38), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, Parent = Nav}, {corner(9)})
	grad({"AccentDark", "Accent2Dark"}, Pill)
	local pillStroke = new("UIStroke", {Thickness = 1, Transparency = 0.5, Parent = Pill})
	bind(pillStroke, "Color", "Accent")

	local pillY, pillToken = nil, 0
	local function movePill(y)
		if not pillY then
			Pill.Position = UDim2.fromOffset(10, y)
			Pill.Visible = true
			pillY = y
			return
		end
		if pillY == y then return end
		pillToken = pillToken + 1
		local my = pillToken
		local from = pillY
		pillY = y
		local top, span = math.min(from, y), math.abs(y - from) + 38
		tw(Pill, 0.16, {Position = UDim2.fromOffset(10, top), Size = UDim2.new(1, -20, 0, span)}, Enum.EasingStyle.Quad)
		task.delay(0.12, function()
			if pillToken ~= my then return end
			tw(Pill, 0.38, {Position = UDim2.fromOffset(10, y), Size = UDim2.new(1, -20, 0, 38)}, Q)
		end)
		task.delay(0.55, function()
			if pillToken == my then Pill.Position = UDim2.fromOffset(10, y); Pill.Size = UDim2.new(1, -20, 0, 38) end
		end)
	end

	-- ---------- Content ----------
	local Content = new("Frame", {Name = "Content", Position = UDim2.fromOffset(170, 0), Size = UDim2.new(1, -170, 1, 0), BackgroundTransparency = 1, Parent = Main})
	local dragTop = new("Frame", {Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Active = true, Parent = Content})
	makeDraggable(dragTop, Holder)

	-- animated top line
	local topLine = new("Frame", {Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 50, Parent = Main})
	local lg = grad({"Accent", "Accent2", "Accent"}, topLine, {Offset = Vector2.new(-1, 0)})
	TweenService:Create(lg, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false), {Offset = Vector2.new(1, 0)}):Play()

	-- Search
	local SearchBar = new("Frame", {Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -78, 0, 38), BorderSizePixel = 0, Parent = Content}, {corner(8)})
	bind(SearchBar, "BackgroundColor3", "Sidebar")
	local searchStroke = new("UIStroke", {Thickness = 1, Parent = SearchBar})
	bind(searchStroke, "Color", "Stroke")
	local searchIcon = new("ImageLabel", {Image = "rbxassetid://6031154871", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Parent = SearchBar})
	bind(searchIcon, "ImageColor3", "SubText")
	local SearchBox = mkText("TextBox", {Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -48, 1, 0), Text = "", PlaceholderText = "Search", Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = SearchBar}, "Text")
	bind(SearchBox, "PlaceholderColor3", "SubText")
	SearchBox.Focused:Connect(function() bind(searchStroke, "Color", "Accent", true); tw(searchIcon, 0.2, {Size = UDim2.fromOffset(21, 21)}, BACK) end)
	SearchBox.FocusLost:Connect(function() bind(searchStroke, "Color", "Stroke", true); tw(searchIcon, 0.2, {Size = UDim2.fromOffset(18, 18)}) end)

	local CloseBtn = mkText("TextButton", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(46, 38), Text = "×", Font = Enum.Font.GothamBold, TextSize = 24, AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 0, Parent = Content}, "Text")
	corner(8).Parent = CloseBtn
	bind(CloseBtn, "BackgroundColor3", "Card")
	local closeScale = new("UIScale", {Parent = CloseBtn})
	CloseBtn.MouseEnter:Connect(function() tw(CloseBtn, 0.15, {BackgroundColor3 = T("AccentDark")}); tw(CloseBtn, 0.3, {Rotation = 90}, BACK) end)
	CloseBtn.MouseLeave:Connect(function() tw(CloseBtn, 0.15, {BackgroundColor3 = T("Card")}); tw(CloseBtn, 0.3, {Rotation = 0}, BACK) end)
	CloseBtn.MouseButton1Down:Connect(function() tw(closeScale, 0.1, {Scale = 0.88}) end)
	CloseBtn.MouseButton1Up:Connect(function() tw(closeScale, 0.2, {Scale = 1}, BACK) end)

	local TabBarHolder = new("Frame", {Position = UDim2.fromOffset(16, 60), Size = UDim2.new(1, -32, 0, 36), BackgroundTransparency = 1, Parent = Content})
	local PagesHolder = new("Frame", {Position = UDim2.fromOffset(16, 106), Size = UDim2.new(1, -32, 1, -118), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Content})

	local SearchPage = new("ScrollingFrame", {Name = "SearchPage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false, Parent = PagesHolder}, {
		new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8)}),
		new("UIGridLayout", {CellSize = UDim2.new(0.5, -8, 0, 58), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder}),
	})
	bind(SearchPage, "ScrollBarImageColor3", "SubText")

	-- ---------- Selection logic ----------
	local selectTab, selectSideTab

	local function playIn(tab)
		for i, card in ipairs(tab.Cards) do
			if i > 24 then break end
			local s = card:FindFirstChild("Scale")
			local shine = card:FindFirstChild("Shine")
			if s then
				s.Scale = 0.86
				if shine then shine.BackgroundTransparency = 0.8 end
				task.delay((i - 1) * 0.025, function()
					if s.Parent then tw(s, 0.45, {Scale = 1}, BACK) end
					if shine and shine.Parent then tw(shine, 0.5, {BackgroundTransparency = 1}) end
				end)
			end
		end
	end

	local function hideAllPages()
		for _, st in ipairs(win.SideTabs) do
			for _, t in ipairs(st.Tabs) do t.Page.Visible = false end
		end
	end

	-- tab pill geometry (scale + offset, always exact)
	local function tabSpan(n, a, b)
		local lo, hi = math.min(a, b), math.max(a, b)
		local ls, lo_o = (lo - 1) / n, (lo - 1) * GAP / n
		local rs = (hi - 1) / n + 1 / n
		local ro = (hi - 1) * GAP / n - GAP * (n - 1) / n
		return UDim2.new(ls, lo_o, 0, 0), UDim2.new(rs - ls, ro - lo_o, 1, 0)
	end

	local function moveTabPill(st, idx, instant)
		local n = #st.Tabs
		if n == 0 then return end
		if instant or not st.IndIdx then
			local p, s = tabSpan(n, idx, idx)
			st.TabInd.Position, st.TabInd.Size = p, s
			st.TabInd.Visible = true
			st.IndIdx = idx
			return
		end
		if st.IndIdx == idx then return end
		st.IndToken = (st.IndToken or 0) + 1
		local my = st.IndToken
		local p1, s1 = tabSpan(n, st.IndIdx, idx)
		local p2, s2 = tabSpan(n, idx, idx)
		st.IndIdx = idx
		tw(st.TabInd, 0.15, {Position = p1, Size = s1}, Enum.EasingStyle.Quad)
		task.delay(0.11, function()
			if st.IndToken ~= my then return end
			tw(st.TabInd, 0.4, {Position = p2, Size = s2}, Q)
		end)
		task.delay(0.55, function()
			if st.IndToken == my then st.TabInd.Position, st.TabInd.Size = p2, s2 end
		end)
	end

	selectTab = function(tab)
		if win.SearchText ~= "" then SearchBox.Text = "" end
		local st = tab.SideTab
		local prev = win.CurrentTab
		local dir = 1
		if prev then
			if prev.SideTab == st then dir = (tab.Index >= prev.Index) and 1 or -1
			else dir = (st.Order >= prev.SideTab.Order) and 1 or -1 end
		end
		for _, o in ipairs(win.SideTabs) do
			for _, t in ipairs(o.Tabs) do
				t.Page.Visible = false
				bind(t.Button, "TextColor3", (t == tab) and "White" or "SubText", true)
			end
		end
		st.ActiveTab = tab
		win.ActiveSideTab = st
		win.CurrentTab = tab
		moveTabPill(st, tab.Index, false)
		tab.Page.Position = UDim2.fromOffset(dir * 44, 0)
		tab.Page.Visible = true
		tw(tab.Page, 0.45, {Position = UDim2.fromOffset(0, 0)}, Q)
		playIn(tab)
	end

	selectSideTab = function(st)
		if win.SearchText ~= "" then SearchBox.Text = "" end
		local was = win.ActiveSideTab
		for _, o in ipairs(win.SideTabs) do
			local active = (o == st)
			o.Active = active
			bind(o.Label, "TextColor3", active and "White" or "Text", true)
			tw(o.Label, 0.3, {Position = UDim2.new(0, o.Pad + (active and 5 or 0), 0, 0)}, Q)
			if o.Icon then
				bind(o.Icon, "ImageColor3", active and "White" or "Text", true)
				if active then o.Icon.Rotation = -25; tw(o.Icon, 0.5, {Rotation = 0}, BACK) end
			end
			o.TabBar.Visible = active and #o.Tabs > 0
		end
		win.ActiveSideTab = st
		movePill(st.Y)
		if was ~= st then
			st.TabBar.Position = UDim2.fromOffset(0, -12)
			tw(st.TabBar, 0.45, {Position = UDim2.fromOffset(0, 0)}, Q)
		end
		local t = st.ActiveTab or st.Tabs[1]
		if t then selectTab(t) else hideAllPages() end
	end

	-- ---------- Search ----------
	local function performSearch(q)
		q = string.lower(q):gsub("^%s+", ""):gsub("%s+$", "")
		win.SearchText = q
		if q == "" then
			for _, e in ipairs(win.Elements) do
				if e.Frame.Parent == SearchPage then e.Frame.Parent = e.Page end
			end
			SearchPage.Visible = false
			TabBarHolder.Visible = true
			local st = win.ActiveSideTab
			if st and st.ActiveTab then st.ActiveTab.Page.Visible = true end
			return
		end
		hideAllPages()
		TabBarHolder.Visible = false
		SearchPage.Visible = true
		for _, e in ipairs(win.Elements) do
			if string.find(e.Name, q, 1, true) then
				e.Frame.Parent = SearchPage
			elseif e.Frame.Parent == SearchPage then
				e.Frame.Parent = e.Page
			end
		end
	end
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function() performSearch(SearchBox.Text) end)

	-- ---------- Cards ----------
	local function newCard(name)
		win.Counter = win.Counter + 1
		local card = new("Frame", {Name = name, BorderSizePixel = 0, LayoutOrder = win.Counter})
		bind(card, "BackgroundColor3", "Card")
		corner(8).Parent = card
		local st = new("UIStroke", {Name = "CardStroke", Thickness = 1, Transparency = 0.35, Parent = card})
		bind(st, "Color", "Stroke")
		new("UIScale", {Name = "Scale", Parent = card})
		new("Frame", {Name = "Shine", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = card}, {corner(8)})
		new("Frame", {Name = "Ripples", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = card}, {corner(8)})
		return card
	end

	local function finish(tab, card, name, searchable)
		card.Parent = tab.Page
		table.insert(tab.Cards, card)
		if searchable ~= false then
			table.insert(win.Elements, {Name = string.lower(name), Frame = card, Page = tab.Page})
		end
	end

	local function hover(card, src)
		local shine, stroke = card.Shine, card.CardStroke
		src.MouseEnter:Connect(function()
			tw(shine, 0.15, {BackgroundTransparency = 0.94})
			tw(stroke, 0.2, {Color = T("Accent"), Transparency = 0.1})
		end)
		src.MouseLeave:Connect(function()
			tw(shine, 0.2, {BackgroundTransparency = 1})
			tw(stroke, 0.25, {Color = T("Stroke"), Transparency = 0.35})
		end)
	end

	local function ripple(card, input)
		local holder = card:FindFirstChild("Ripples")
		if not holder then return end
		local ap, as = card.AbsolutePosition, card.AbsoluteSize
		local fx = math.clamp((input.Position.X - ap.X) / math.max(as.X, 1), 0, 1)
		local fy = math.clamp((input.Position.Y - ap.Y) / math.max(as.Y, 1), 0, 1)
		local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(fx, fy), Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, BorderSizePixel = 0, Parent = holder}, {corner(200)})
		tw(r, 0.6, {Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 1}, Q)
		task.delay(0.65, function() r:Destroy() end)
	end

	local function hitButton(card)
		local hit = new("TextButton", {Name = "Hit", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3, Parent = card})
		hit.InputBegan:Connect(function(input) if isPress(input) then ripple(card, input) end end)
		return hit
	end

	local function pressFx(card, hit)
		local sc = card.Scale
		hit.MouseButton1Down:Connect(function() tw(sc, 0.1, {Scale = 0.95}) end)
		hit.MouseButton1Up:Connect(function() tw(sc, 0.35, {Scale = 1}, BACK) end)
		hit.MouseLeave:Connect(function() tw(sc, 0.2, {Scale = 1}) end)
	end

	-- ---------- Tabs ----------
	local function layoutTabs(st)
		local n = #st.Tabs
		for i, t in ipairs(st.Tabs) do
			t.Button.Position = UDim2.new((i - 1) / n, (i - 1) * GAP / n, 0, 0)
			t.Button.Size = UDim2.new(1 / n, -GAP * (n - 1) / n, 1, 0)
		end
		if st.IndIdx then moveTabPill(st, st.IndIdx, true) end
	end

	local function createTab(st, name, opts)
		opts = opts or {}
		local tab = {Name = name, SideTab = st, Cards = {}, Index = #st.Tabs + 1}

		local btn = new("TextButton", {Name = name, Text = name, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = st.TabInner})
		bind(btn, "TextColor3", "SubText")
		tab.Button = btn

		local page = new("ScrollingFrame", {Name = st.Name .. "_" .. name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = PagesHolder}, {
			new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8)}),
			new("UIGridLayout", {CellSize = opts.CellSize or UDim2.new(0.5, -8, 0, 58), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder}),
		})
		bind(page, "ScrollBarImageColor3", "SubText")
		tab.Page = page

		table.insert(st.Tabs, tab)
		layoutTabs(st)
		if win.ActiveSideTab == st then st.TabBar.Visible = true end

		btn.MouseButton1Click:Connect(function() selectTab(tab) end)
		btn.MouseEnter:Connect(function() if st.ActiveTab ~= tab then bind(btn, "TextColor3", "Text", true) end end)
		btn.MouseLeave:Connect(function() if st.ActiveTab ~= tab then bind(btn, "TextColor3", "SubText", true) end end)

		if win.ActiveSideTab == st and not st.ActiveTab then selectTab(tab) end

		-- ===== BUTTON =====
		function tab:AddButton(bname, callback)
			local card = newCard(bname)
			mkText("TextLabel", {Text = bname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), Parent = card})
			local hit = hitButton(card)
			hover(card, hit)
			pressFx(card, hit)
			hit.MouseButton1Click:Connect(function()
				if callback then task.spawn(callback) end
			end)
			finish(tab, card, bname)
			return {Card = card}
		end

		-- ===== TOGGLE =====
		function tab:AddToggle(tname, default, callback)
			local state = default == true
			local card = newCard(tname)
			mkText("TextLabel", {Text = tname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -72, 1, 0), Parent = card})
			local sw = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0, Parent = card}, {corner(11)})
			bind(sw, "BackgroundColor3", state and "Accent" or "Off")
			local knob = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(16, 16), Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sw}, {corner(8)})
			local hit = hitButton(card)
			hover(card, hit)
			pressFx(card, hit)

			local obj = {Card = card}
			local function apply(v, fire)
				state = v
				bind(sw, "BackgroundColor3", state and "Accent" or "Off", true)
				-- stretch then settle
				tw(knob, 0.12, {Size = UDim2.fromOffset(24, 16)})
				task.delay(0.1, function()
					tw(knob, 0.35, {Size = UDim2.fromOffset(16, 16), Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, BACK)
				end)
				if fire and callback then task.spawn(callback, state) end
			end
			function obj:Set(v) apply(v == true, true) end
			function obj:Get() return state end
			hit.MouseButton1Click:Connect(function() apply(not state, true) end)

			finish(tab, card, tname)
			if state and callback then task.spawn(callback, true) end
			return obj
		end

		-- ===== SLIDER =====
		function tab:AddSlider(sname, min, max, default, callback, increment)
			min, max = min or 0, max or 100
			increment = increment or 1
			local dec = 0
			local d = tostring(increment):match("%.(%d+)")
			if d then dec = #d end
			local function snap(v)
				v = math.floor((v - min) / increment + 0.5) * increment + min
				v = math.clamp(v, min, max)
				return tonumber(string.format("%." .. dec .. "f", v))
			end

			local card = newCard(sname)
			mkText("TextLabel", {Text = sname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -90, 0, 16), Parent = card})
			local valLbl = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8), Size = UDim2.fromOffset(64, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Text = "", Parent = card}, "SubText")
			local valScale = new("UIScale", {Parent = valLbl})
			local track = new("Frame", {Position = UDim2.fromOffset(14, 38), Size = UDim2.new(1, -28, 0, 6), BorderSizePixel = 0, Parent = card}, {corner(3)})
			bind(track, "BackgroundColor3", "Off")
			local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track}, {corner(3)})
			grad({"Accent", "Accent2"}, fill)
			local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = track}, {corner(6)})
			local knobStroke = new("UIStroke", {Thickness = 0, Transparency = 0.6, Parent = knob})
			bind(knobStroke, "Color", "Accent")

			local value
			local function apply(v, fire, animate)
				v = snap(v)
				local pct = (max - min) == 0 and 0 or (v - min) / (max - min)
				valLbl.Text = tostring(v)
				if animate then
					tw(fill, 0.25, {Size = UDim2.fromScale(pct, 1)}, Q)
					tw(knob, 0.25, {Position = UDim2.fromScale(pct, 0.5)}, Q)
				else
					fill.Size = UDim2.fromScale(pct, 1)
					knob.Position = UDim2.fromScale(pct, 0.5)
				end
				if v ~= value then
					value = v
					if fire then
						valScale.Scale = 1.18
						tw(valScale, 0.25, {Scale = 1}, BACK)
						if callback then task.spawn(callback, v) end
					end
				end
			end
			apply(default or min, false, false)

			local hit = new("TextButton", {Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3, Parent = card})
			hover(card, card)
			local dragging = false
			local function fromX(x)
				local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				apply(min + (max - min) * pct, true, false)
			end
			hit.InputBegan:Connect(function(input)
				if isPress(input) then
					dragging = true
					page.ScrollingEnabled = false
					tw(knob, 0.2, {Size = UDim2.fromOffset(18, 18)}, BACK)
					tw(knobStroke, 0.2, {Thickness = 5})
					fromX(input.Position.X)
				end
			end)
			A(UIS.InputChanged, function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					fromX(input.Position.X)
				end
			end)
			A(UIS.InputEnded, function(input)
				if dragging and isPress(input) then
					dragging = false
					page.ScrollingEnabled = true
					tw(knob, 0.3, {Size = UDim2.fromOffset(12, 12)}, BACK)
					tw(knobStroke, 0.25, {Thickness = 0})
				end
			end)

			local obj = {Card = card}
			function obj:Set(v) apply(v, true, true) end
			function obj:Get() return value end
			finish(tab, card, sname)
			return obj
		end

		-- ===== TEXTBOX =====
		function tab:AddTextbox(xname, placeholder, callback, default)
			local card = newCard(xname)
			mkText("TextLabel", {Text = xname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.5, -14, 1, 0), Parent = card})
			local box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.46, 0, 0, 30), ClipsDescendants = true, BorderSizePixel = 0, Parent = card}, {corner(6)})
			bind(box, "BackgroundColor3", "Sidebar")
			local bs = new("UIStroke", {Thickness = 1, Parent = box})
			bind(bs, "Color", "Stroke")
			local input = mkText("TextBox", {Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), Text = default or "", PlaceholderText = placeholder or "Type...", Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ClearTextOnFocus = false, Parent = box})
			bind(input, "PlaceholderColor3", "SubText")
			hover(card, card)
			input.Focused:Connect(function()
				bind(bs, "Color", "Accent", true)
				tw(bs, 0.2, {Thickness = 2})
			end)
			input.FocusLost:Connect(function(enter)
				bind(bs, "Color", "Stroke", true)
				tw(bs, 0.2, {Thickness = 1})
				if callback then task.spawn(callback, input.Text, enter) end
			end)
			local obj = {Card = card}
			function obj:Set(text) input.Text = tostring(text) end
			function obj:Get() return input.Text end
			finish(tab, card, xname)
			return obj
		end

		-- ===== LABEL (info) =====
		function tab:AddLabel(lname, value, shimmer)
			local card = newCard(lname)
			mkText("TextLabel", {Text = lname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.4, -14, 1, 0), Parent = card})
			local v = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0.6, -14, 0, 22), Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card}, shimmer and "White" or "SubText")
			if shimmer then
				local g = grad({"Accent", "Accent2", "Accent"}, v, {Offset = Vector2.new(-0.6, 0)})
				TweenService:Create(g, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.6, 0)}):Play()
			end
			hover(card, card)
			finish(tab, card, lname)
			local obj = {Card = card}
			function obj:Set(t) v.Text = tostring(t) end
			return obj
		end

		-- ===== STEPPER (-  value  +) =====
		function tab:AddStepper(stname, min, max, default, step, callback, minusImg, plusImg, fmt)
			step = step or 1
			fmt = fmt or function(v) return tostring(v) end
			local value = math.clamp(default or min, min, max)
			local card = newCard(stname)
			mkText("TextLabel", {Text = stname, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -150, 1, 0), Parent = card})
			local valLbl = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0), Size = UDim2.fromOffset(56, 24), Text = fmt(value), Font = Enum.Font.GothamBold, TextSize = 13, Parent = card}, "Text")
			local valScale = new("UIScale", {Parent = valLbl})

			local function apply(v, fire)
				v = math.clamp(v, min, max)
				if v == value and fire then
					tw(valScale, 0.08, {Scale = 0.85}); task.delay(0.08, function() tw(valScale, 0.25, {Scale = 1}, BACK) end)
					return
				end
				value = v
				valLbl.Text = fmt(v)
				valScale.Scale = 1.3
				tw(valScale, 0.35, {Scale = 1}, BACK)
				if fire and callback then task.spawn(callback, v) end
			end

			local function mkBtn(img, xoff, dir)
				local b = new("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xoff, 0.5, 0), Size = UDim2.fromOffset(28, 28), Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 4, Parent = card}, {corner(8)})
				bind(b, "BackgroundColor3", "Sidebar")
				local s = new("UIScale", {Parent = b})
				local im = new("ImageLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -8, 1, -8), BackgroundTransparency = 1, Image = icon(img) or "", ZIndex = 5, Parent = b})
				bind(im, "ImageColor3", "Text")
				local token = 0
				b.InputBegan:Connect(function(input)
					if isPress(input) then
						token = token + 1
						local my = token
						tw(s, 0.1, {Scale = 0.78})
						tw(b, 0.1, {BackgroundColor3 = T("AccentDark")})
						tw(im, 0.1, {Rotation = dir * 18})
						ripple(card, input)
						apply(value + dir * step, true)
						task.delay(0.4, function()
							while token == my and b.Parent do
								apply(value + dir * step, true)
								task.wait(0.07)
							end
						end)
					end
				end)
				local function release()
					token = token + 1
					tw(s, 0.35, {Scale = 1}, BACK)
					tw(b, 0.25, {BackgroundColor3 = T("Sidebar")})
					tw(im, 0.35, {Rotation = 0}, BACK)
				end
				b.InputEnded:Connect(function(input) if isPress(input) then release() end end)
				b.MouseLeave:Connect(release)
				return b
			end
			mkBtn(minusImg, -108, -1)
			mkBtn(plusImg, -12, 1)

			hover(card, card)
			finish(tab, card, stname)
			local obj = {Card = card}
			function obj:Set(v) apply(v, true) end
			function obj:Get() return value end
			return obj
		end

		return tab
	end

	-- ---------- Side tabs ----------
	local topCount, bottomCount = 0, 0
	local function createSideTab(name, iconId, bottom)
		local st = {Name = name, Tabs = {}, Bottom = bottom}
		if bottom then
			bottomCount = bottomCount + 1
			st.Y = navH - 48 - (bottomCount - 1) * 42
			st.Order = 1000 + bottomCount
		else
			topCount = topCount + 1
			st.Y = 2 + (topCount - 1) * 42
			st.Order = topCount
		end

		local btn = new("TextButton", {Name = name, Position = UDim2.fromOffset(10, st.Y), Size = UDim2.new(1, -20, 0, 38), Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = Nav})
		st.Button = btn

		local pad = 14
		local ico = icon(iconId)
		if ico then
			pad = 42
			st.Icon = new("ImageLabel", {Image = ico, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 13, 0.5, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 3, Parent = btn})
			bind(st.Icon, "ImageColor3", "Text")
		end
		st.Pad = pad
		st.Label = mkText("TextLabel", {Text = name, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(pad, 0), Size = UDim2.new(1, -pad - 8, 1, 0), ZIndex = 3, Parent = btn})

		-- tab bar (own sliding pill)
		st.TabBar = new("Frame", {Name = name, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Visible = false, Parent = TabBarHolder}, {corner(8)})
		bind(st.TabBar, "BackgroundColor3", "Sidebar")
		local tbs = new("UIStroke", {Thickness = 1, Parent = st.TabBar})
		bind(tbs, "Color", "Stroke")
		st.TabInner = new("Frame", {Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), BackgroundTransparency = 1, Parent = st.TabBar})
		st.TabInd = new("Frame", {Name = "Pill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, Parent = st.TabInner}, {corner(6)})
		grad({"AccentDark", "Accent2Dark"}, st.TabInd)

		btn.MouseEnter:Connect(function() if not st.Active then tw(st.Label, 0.25, {Position = UDim2.new(0, pad + 3, 0, 0)}, Q) end end)
		btn.MouseLeave:Connect(function() if not st.Active then tw(st.Label, 0.25, {Position = UDim2.new(0, pad, 0, 0)}, Q) end end)
		btn.MouseButton1Click:Connect(function() selectSideTab(st) end)

		table.insert(win.SideTabs, st)
		function st:CreateTab(tabName) return createTab(st, tabName) end
		return st
	end

	function win:CreateSideTab(name, iconId)
		local st = createSideTab(name, iconId, false)
		if not win.UserSelected then
			win.UserSelected = true
			selectSideTab(st)
		end
		return st
	end

	function win:SetSizeMultiplier(m)
		win.SizeMul = math.clamp(m, 0.3, 1.8)
		refit(true)
	end

	-- ---------- Menu Settings (built-in, bottom) ----------
	local MenuST = createSideTab("Menu Settings", nil, true)

	-- Tab 1: Theme
	local ThemeTab = createTab(MenuST, "Theme", {CellSize = UDim2.new(0.25, -9, 0, 96)})
	local ringList = {}
	local function refreshRings()
		for tname, rings in pairs(ringList) do
			for _, r in ipairs(rings) do tw(r, 0.25, {Transparency = (tname == currentTheme) and 0 or 1}) end
		end
	end
	ringRefreshers[win] = refreshRings
	for _, info in ipairs(THEME_LIST) do
		local tname = info[1]
		local card = newCard(tname)
		new("Frame", {Name = "Swatch", Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -34), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = card}, {
			corner(6),
			new("UIGradient", {Rotation = 25, Color = ColorSequence.new(info[2], info[3])}),
		})
		mkText("TextLabel", {Text = tname, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0, 10, 1, -26), Size = UDim2.new(1, -20, 0, 22), Parent = card})
		local ring = new("Frame", {Name = "Ring", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = card}, {corner(8)})
		local rs = new("UIStroke", {Thickness = 2, Color = info[2], Transparency = (tname == currentTheme) and 0 or 1, Parent = ring})
		ringList[tname] = {rs}
		local hit = hitButton(card)
		hover(card, hit)
		pressFx(card, hit)
		hit.MouseButton1Click:Connect(function() PingoUI.SetTheme(tname) end)
		finish(ThemeTab, card, tname, false)
	end

	-- Tab 2: UI (Menu Size + Update info)
	local UITab = createTab(MenuST, "UI")
	UITab:AddStepper("Menu Size", 60, 140, 100, 10, function(v) win:SetSizeMultiplier(v / 100) end, 12338394619, 12338396009, function(v) return v .. "%" end)
	UITab:AddLabel("Update", updateName, true)
	UITab:AddLabel("Name", title)
	UITab:AddLabel("Version", version)
	UITab:AddLabel("Library", "PingoUI " .. PingoUI.Version)

	-- ---------- Open / Close ----------
	local token = 0
	function win:Toggle(state)
		if state == nil then state = not win.Opened end
		if state == win.Opened then return end
		win.Opened = state
		token = token + 1
		local my = token
		if state then
			Holder.Visible = true
			openScale.Scale = 0.86
			Main.GroupTransparency = 1
			Sidebar.Position = UDim2.fromOffset(-40, 0)
			Content.Position = UDim2.fromOffset(210, 0)
			tw(openScale, 0.5, {Scale = 1}, BACK)
			tw(Main, 0.3, {GroupTransparency = 0})
			tw(Sidebar, 0.6, {Position = UDim2.fromOffset(0, 0)}, Q)
			tw(Content, 0.6, {Position = UDim2.fromOffset(170, 0)}, Q)
			local t = win.CurrentTab
			if t then playIn(t) end
		else
			tw(openScale, 0.25, {Scale = 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(Main, 0.22, {GroupTransparency = 1})
			task.delay(0.26, function()
				if token == my then Holder.Visible = false end
			end)
		end
	end
	CloseBtn.MouseButton1Click:Connect(function() win:Toggle(false) end)

	A(UIS.InputBegan, function(input, gp)
		if gp then return end
		if input.KeyCode == (config.Key or Enum.KeyCode.RightShift) then win:Toggle() end
	end)

	-- Floating open button
	local OpenBtn = new("TextButton", {Name = "PingoOpen", Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 10, Parent = gui}, {corner(12)})
	bind(OpenBtn, "BackgroundColor3", "Background")
	local ob = new("UIStroke", {Thickness = 2, Parent = OpenBtn})
	bind(ob, "Color", "Accent")
	local obScale = new("UIScale", {Parent = OpenBtn})
	if config.Icon then
		new("ImageLabel", {Image = icon(config.Icon), Size = UDim2.new(1, -12, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 1, Parent = OpenBtn})
	else
		mkText("TextLabel", {Text = string.sub(title, 1, 1), Font = Enum.Font.GothamBold, TextSize = 24, Size = UDim2.fromScale(1, 1), Parent = OpenBtn}, "Accent")
	end
	OpenBtn.MouseEnter:Connect(function() tw(obScale, 0.2, {Scale = 1.1}, BACK) end)
	OpenBtn.MouseLeave:Connect(function() tw(obScale, 0.2, {Scale = 1}, BACK) end)
	makeDraggable(OpenBtn, OpenBtn, function()
		obScale.Scale = 0.88
		tw(obScale, 0.35, {Scale = 1}, BACK)
		win:Toggle()
	end)

	-- ---------- Notifications ----------
	local NotifHolder = new("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.new(0, 270, 1, -32), BackgroundTransparency = 1, ZIndex = 20, Parent = gui}, {
		new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}),
	})
	local notifCount = 0
	function win:Notify(nTitle, text, duration)
		notifCount = notifCount + 1
		local wrap = new("Frame", {Size = UDim2.fromOffset(270, 58), BackgroundTransparency = 1, LayoutOrder = notifCount, Parent = NotifHolder})
		local n = new("Frame", {Position = UDim2.fromOffset(300, 0), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = wrap}, {corner(8)})
		bind(n, "BackgroundColor3", "Card")
		local ns = new("UIStroke", {Thickness = 1, Parent = n})
		bind(ns, "Color", "Stroke")
		local bar = new("Frame", {Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(8, 8), BorderSizePixel = 0, Parent = n}, {corner(2)})
		bind(bar, "BackgroundColor3", "Accent")
		mkText("TextLabel", {Text = tostring(nTitle or ""), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(20, 8), Size = UDim2.new(1, -30, 0, 18), Parent = n})
		mkText("TextLabel", {Text = tostring(text or ""), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Position = UDim2.fromOffset(20, 27), Size = UDim2.new(1, -30, 1, -32), Parent = n}, "SubText")
		tw(n, 0.5, {Position = UDim2.fromOffset(0, 0)}, BACK)
		task.delay(duration or 3, function()
			if not n.Parent then return end
			tw(n, 0.3, {Position = UDim2.fromOffset(300, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.32, function() wrap:Destroy() end)
		end)
	end

	function win:SetTheme(name) PingoUI.SetTheme(name) end

	function win:Destroy()
		for _, c in ipairs(win.Conns) do pcall(function() c:Disconnect() end) end
		ringRefreshers[win] = nil
		gui:Destroy()
	end

	-- ---------- Start ----------
	selectSideTab(MenuST)
	if not config.StartHidden then win:Toggle(true) end

	return win
end

return PingoUI
