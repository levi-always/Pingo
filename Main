--[[
    NovaUI v2  |  Single-file UI library
    ------------------------------------------------------------
    Every Button / Toggle / Slider:
      [↗]  Float   -> pops the element out as a floating widget (no hold)
      [▾]  Props   -> expands settings panel below the element (only if Settings given)
    Hold 0.8s on any element -> Favourite / Hide (Dropdown also Reset)
    Floating widget          -> drag, hold for Lock / Hide / Remove
    Config tab               -> Create / Save / Load / Auto-Load / Rename / Delete
    Dropdown                 -> animated, searchable, Multi + Max
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local HOLD_TIME = 0.8
local FOLDER = "NovaUI"
local AUTO_PATH = FOLDER .. "/autoload.txt"

local ICON = {
	Themes = "rbxassetid://88003022051687",
	Config = "rbxassetid://137882818389597",
	Settings = "rbxassetid://9405931578",
	Star = "rbxassetid://5078542968",
	Search = "rbxassetid://6031154871",
}

local BASE = {
	Background = Color3.fromRGB(18, 18, 24),
	Panel = Color3.fromRGB(26, 26, 34),
	Card = Color3.fromRGB(33, 33, 43),
	Stroke = Color3.fromRGB(52, 52, 66),
	Off = Color3.fromRGB(58, 58, 72),
	Text = Color3.fromRGB(240, 240, 246),
	SubText = Color3.fromRGB(150, 150, 166),
	White = Color3.new(1, 1, 1),
}

local THEMES = {
	Crimson = Color3.fromRGB(235, 55, 75),
	Ocean = Color3.fromRGB(40, 150, 255),
	Emerald = Color3.fromRGB(40, 200, 120),
	Amber = Color3.fromRGB(255, 170, 30),
	Violet = Color3.fromRGB(150, 90, 255),
	Mono = Color3.fromRGB(210, 210, 220),
}

-- ============================================================
--  HELPERS
-- ============================================================
local function make(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = o end
	return o
end

local function corner(r, parent)
	return make("UICorner", {CornerRadius = UDim.new(0, r), Parent = parent})
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local function sanitize(s)
	s = tostring(s or ""):gsub("[^%w_%- ]", "")
	s = s:gsub("^%s+", ""):gsub("%s+$", "")
	return s
end

local function asset(v)
	if type(v) == "number" or (type(v) == "string" and v:match("^%d+$")) then
		return "rbxassetid://" .. v
	end
	return v
end

local function protectedParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok2 and cg then return cg end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- ============================================================
--  THEME SYSTEM
-- ============================================================
local currentTheme = "Crimson"
local bound = setmetatable({}, {__mode = "k"})

local function color(key)
	if key == "Accent" then return THEMES[currentTheme] end
	return BASE[key]
end

local function tw(obj, t, props, style)
	local tween = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function bind(obj, prop, key, anim)
	bound[obj] = bound[obj] or {}
	bound[obj][prop] = key
	if anim then tw(obj, 0.25, {[prop] = color(key)}) else obj[prop] = color(key) end
	return obj
end

local function setTheme(name)
	if not THEMES[name] then return end
	currentTheme = name
	for obj, props in pairs(bound) do
		if obj.Parent then
			for prop, key in pairs(props) do
				tw(obj, 0.35, {[prop] = color(key)})
			end
		end
	end
end

-- ============================================================
--  FILE SYSTEM (executor APIs with in-memory fallback)
-- ============================================================
local FS_OK = writefile ~= nil and readfile ~= nil and isfile ~= nil
	and makefolder ~= nil and isfolder ~= nil and listfiles ~= nil and delfile ~= nil
local memFS = {}

local function cfgPath(name) return FOLDER .. "/" .. name .. ".json" end

local function fsWrite(path, data)
	if FS_OK then
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		writefile(path, data)
	else
		memFS[path] = data
	end
end

local function fsRead(path)
	if FS_OK then
		return isfile(path) and readfile(path) or nil
	end
	return memFS[path]
end

local function fsDelete(path)
	if FS_OK then
		if isfile(path) then delfile(path) end
	else
		memFS[path] = nil
	end
end

local function fsList()
	local out = {}
	if FS_OK then
		if isfolder(FOLDER) then
			for _, p in ipairs(listfiles(FOLDER)) do
				local n = p:match("([^/\\]+)%.json$")
				if n then table.insert(out, n) end
			end
		end
	else
		for k in pairs(memFS) do
			local n = k:match("^" .. FOLDER .. "/(.+)%.json$")
			if n then table.insert(out, n) end
		end
	end
	return out
end

-- ============================================================
--  INPUT HELPERS
-- ============================================================
local function makeDraggable(handle, frame, canDrag, onEnd)
	local dragging, startIn, startPos = false, nil, nil
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging, startIn, startPos = true, i.Position, frame.Position
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) and (not canDrag or canDrag()) then
			local d = i.Position - startIn
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if dragging and isPress(i) then
			dragging = false
			if onEnd then onEnd(frame) end
		end
	end)
end

-- Hold (0.8s) vs tap. Moving more than 8px cancels both.
local function attachHold(hit, onHold, onTap)
	local st = {pressing = false, held = false, moved = false, start = nil, token = 0}
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		st.pressing, st.held, st.moved = true, false, false
		st.start = input.Position
		st.token = st.token + 1
		local my = st.token
		task.delay(HOLD_TIME, function()
			if st.pressing and st.token == my and not st.moved then
				st.held = true
				if onHold then onHold() end
			end
		end)
	end)
	UIS.InputChanged:Connect(function(input)
		if st.pressing and st.start and isMove(input) and (input.Position - st.start).Magnitude > 8 then
			st.moved = true
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if isPress(input) then st.pressing = false end
	end)
	hit.MouseButton1Click:Connect(function()
		if st.held or st.moved then return end
		if onTap then onTap() end
	end)
end

-- ============================================================
--  ROW PRIMITIVES
-- ============================================================
local function newRow(container, h, bgKey)
	local row = bind(make("Frame", {
		Size = UDim2.new(1, 0, 0, h), BorderSizePixel = 0, ClipsDescendants = true, Parent = container,
	}), "BackgroundColor3", bgKey or "Card")
	corner(8, row)
	bind(make("UIStroke", {Thickness = 1, Transparency = 0.4, Parent = row}), "Color", "Stroke")
	local hit = make("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row})
	local star = bind(make("ImageLabel", {
		BackgroundTransparency = 1, Image = ICON.Star,
		Position = UDim2.new(0, 2, 1, -12), Size = UDim2.fromOffset(9, 9),
		Visible = false, Parent = row,
	}), "ImageColor3", "Accent")
	return row, hit, star
end

-- rp = extra right reserve (beyond the 12px margin)
local function header(row, h, name, desc, rp, forceTop)
	local top = desc ~= nil or forceTop == true
	rp = rp or 0
	local title = bind(make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, top and 8 or 0),
		Size = UDim2.new(1, -(12 + rp), 0, top and 18 or h),
		Font = Enum.Font.GothamMedium, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(name), Parent = row,
	}), "TextColor3", "Text")
	if desc then
		local d = make("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 26),
			Size = UDim2.new(1, -(12 + rp), 0, 14), Font = Enum.Font.Gotham, TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Text = desc, Parent = row,
		})
		bind(d, "TextColor3", "SubText")
	end
	return title
end

local function iconBtn(parent, glyph, order)
	local b = make("TextButton", {
		Size = UDim2.fromOffset(24, 24), BorderSizePixel = 0, AutoButtonColor = false,
		Font = Enum.Font.GothamBold, TextSize = 13, Text = glyph, LayoutOrder = order, ZIndex = 6, Parent = parent,
	})
	corner(6, b)
	bind(b, "BackgroundColor3", "Off")
	bind(b, "TextColor3", "Text")
	return b
end

local function makePage(parent)
	return make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false, Parent = parent,
	}, {
		make("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}),
		make("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 6)}),
	})
end

local function homeOf(win, r)
	if r.Hidden then return win.HiddenTab.Page end
	return r.Tab.Page
end

-- ============================================================
--  CLASSES
-- ============================================================
local Nova = {}
local Win = {}
Win.__index = Win
local Tab = {}
Tab.__index = Tab

-- ============================================================
--  ELEMENT FACTORY (top-level elements and Settings children)
-- ============================================================
local EXTRA_RESERVE = {Button = 0, Toggle = 52, Slider = 96, Dropdown = 170}

local function rowHeight(kind, hasDesc, isChild)
	if isChild then return kind == "Slider" and 50 or 40 end
	if kind == "Slider" then return hasDesc and 66 or 54 end
	return hasDesc and 56 or 46
end

local function makeElement(kind, target, o, parentRec)
	o = o or {}
	local isChild = parentRec ~= nil
	local win = isChild and parentRec.Win or target.Window
	local container = isChild and target or target.Page
	local tab = (not isChild) and target or nil

	local hasDesc = (not isChild) and o.Description ~= nil and o.Description ~= ""
	local descText = hasDesc and o.Description or nil
	local h = rowHeight(kind, hasDesc, isChild)

	-- Floating button: every top-level Button / Toggle / Slider
	local canFloat = (not isChild) and kind ~= "Dropdown"
	-- Properties panel: only when developer provides Settings
	local settings = (not isChild) and kind ~= "Dropdown" and o.Settings or nil
	local hasProp = type(settings) == "table" and #settings > 0

	local ctrlCount = (canFloat and 1 or 0) + (hasProp and 1 or 0)
	local ctrlW = ctrlCount * 24 + math.max(ctrlCount - 1, 0) * 6
	local ctrlReserve = ctrlW > 0 and (ctrlW + 10) or 0

	local name = tostring(o.Name or kind)
	local rec = {
		Name = name, Kind = kind, Win = win, Default = o.Default,
		Children = {}, Favourite = false, Hidden = false, Lower = string.lower(name),
	}
	if tab then
		rec.Tab = tab
		rec.Id = tab.Name .. "/" .. name
	else
		rec.Id = parentRec.Id .. "/" .. name
		rec.Child = true
	end

	local row, hit, star = newRow(container, h, isChild and "Panel" or "Card")
	rec.Row, rec.Star = row, star
	if isChild then star.Visible = false end

	header(row, h, name, descText, ctrlReserve + (EXTRA_RESERVE[kind] or 0), kind == "Slider")

	local function onTap(fn)
		if isChild then
			hit.MouseButton1Click:Connect(fn)
		else
			attachHold(hit, function() win:_elementMenu(rec) end, fn)
		end
	end

	-- Right-side controls (Float + Properties)
	local propBtn
	if ctrlCount > 0 then
		local ctrl = make("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 11), Size = UDim2.fromOffset(ctrlW, 24), ZIndex = 5, Parent = row,
		}, {
			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		if canFloat then
			local floatBtn = iconBtn(ctrl, "↗", 1)
			rec.FloatBtn = floatBtn
			floatBtn.MouseButton1Click:Connect(function() win:_toggleFloat(rec) end)
		end
		if hasProp then
			propBtn = iconBtn(ctrl, "▾", 2)
		end
	end

	-- ===== BUTTON =====
	if kind == "Button" then
		rec.Fire = function() if o.Callback then task.spawn(o.Callback) end end
		onTap(rec.Fire)

	-- ===== TOGGLE =====
	elseif kind == "Toggle" then
		local state = false
		local sw = bind(make("Frame", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(12 + ctrlReserve), 0.5, 0),
			Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0, Parent = row,
		}), "BackgroundColor3", "Off")
		corner(11, sw)
		local knob = make("Frame", {
			Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sw,
		})
		corner(8, knob)

		local function apply(v, fire)
			if fire and v == state then return end
			state = v
			bind(sw, "BackgroundColor3", state and "Accent" or "Off", true)
			tw(knob, 0.3, {Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)}, Enum.EasingStyle.Back)
			if rec.FloatUpdate then rec.FloatUpdate() end
			if fire and o.Callback then task.spawn(o.Callback, state) end
		end
		rec.Get = function() return state end
		rec.Set = function(v) apply(v == true, true) end
		apply(o.Default == true, false)
		onTap(function() rec.Set(not state) end)

	-- ===== SLIDER =====
	elseif kind == "Slider" then
		local min, max = o.Min or 0, o.Max or 100
		local inc = o.Increment or 1
		local suffix = o.Suffix or ""
		rec.Min, rec.Max, rec.Suffix = min, max, suffix

		local valLbl = bind(make("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(12 + ctrlReserve), 0, 8), Size = UDim2.fromOffset(90, 18),
			Font = Enum.Font.GothamBold, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right, Text = "", Parent = row,
		}), "TextColor3", "Accent")

		local track = bind(make("Frame", {
			Position = UDim2.new(0, 12, 0, h - 14), Size = UDim2.new(1, -24, 0, 6),
			BorderSizePixel = 0, Parent = row,
		}), "BackgroundColor3", "Off")
		corner(3, track)
		local fill = bind(make("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track}), "BackgroundColor3", "Accent")
		corner(3, fill)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = 2, Parent = track,
		})
		corner(6, knob)

		local value = min
		local function snap(v)
			v = math.floor((v - min) / inc + 0.5) * inc + min
			v = math.clamp(v, min, max)
			return tonumber(string.format("%.6g", v))
		end
		local function show(v, fire)
			value = snap(v)
			local pct = (max > min) and (value - min) / (max - min) or 0
			tw(fill, 0.12, {Size = UDim2.fromScale(pct, 1)}, Enum.EasingStyle.Quad)
			tw(knob, 0.12, {Position = UDim2.fromScale(pct, 0.5)}, Enum.EasingStyle.Quad)
			valLbl.Text = tostring(value) .. suffix
			if rec.FloatUpdate then rec.FloatUpdate() end
			if fire and o.Callback then task.spawn(o.Callback, value) end
		end
		rec.Get = function() return value end
		rec.Set = function(v) show(tonumber(v) or min, true) end
		show(tonumber(o.Default) or min, false)

		local dragging = false
		local function fromX(x)
			local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			show(min + (max - min) * pct, true)
		end
		hit.InputBegan:Connect(function(i)
			if isPress(i) then dragging = true; fromX(i.Position.X) end
		end)
		UIS.InputChanged:Connect(function(i)
			if dragging and isMove(i) then fromX(i.Position.X) end
		end)
		UIS.InputEnded:Connect(function(i)
			if isPress(i) then dragging = false end
		end)
		if not isChild then
			attachHold(hit, function() win:_elementMenu(rec) end, nil)
		end

	-- ===== DROPDOWN (top-level only) =====
	elseif kind == "Dropdown" then
		local options = o.Options or {}
		local multi = o.Multi == true
		local maxSel = multi and (o.Max or math.huge) or 1
		local visibleRows = math.min(math.max(#options, 1), o.MaxVisible or 5)
		local openH = h + 42 + visibleRows * 29 + 8

		local selLbl = bind(make("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -34, 0, 0),
			Size = UDim2.fromOffset(130, h), Font = Enum.Font.Gotham, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = row,
		}), "TextColor3", "SubText")

		local arrow = bind(make("TextLabel", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -16, 0, math.floor(h / 2)), Size = UDim2.fromOffset(14, 14),
			Font = Enum.Font.GothamBold, TextSize = 11, Text = "▼", Parent = row,
		}), "TextColor3", "Accent")

		local body = make("Frame", {
			Position = UDim2.fromOffset(0, h), Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1, ClipsDescendants = true, Parent = row,
		})
		local search = make("TextBox", {
			Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 28),
			BorderSizePixel = 0, Font = Enum.Font.Gotham, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, Text = "", PlaceholderText = "Search...",
			ClearTextOnFocus = false, Parent = body,
		}, {make("UIPadding", {PaddingLeft = UDim.new(0, 8)})})
		bind(search, "BackgroundColor3", "Panel")
		bind(search, "TextColor3", "Text")
		bind(search, "PlaceholderColor3", "SubText")
		corner(7, search)

		local list = make("ScrollingFrame", {
			Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 1, -44),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = body,
		}, {make("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder})})

		local selected, buttons, open = {}, {}, false

		local function values()
			local out = {}
			for _, n in ipairs(options) do
				if selected[n] then table.insert(out, n) end
			end
			return out
		end
		local function count()
			local n = 0
			for _ in pairs(selected) do n = n + 1 end
			return n
		end
		local function render()
			local vals = values()
			if #vals == 0 then
				selLbl.Text = "None"
			elseif multi then
				selLbl.Text = #vals .. " / " .. (maxSel == math.huge and "∞" or tostring(maxSel))
			else
				selLbl.Text = vals[1]
			end
			for _, b in ipairs(buttons) do
				bind(b.Btn, "BackgroundColor3", selected[b.Name] and "Accent" or "Panel", true)
			end
		end
		local function fire()
			if o.Callback then
				local v = values()
				task.spawn(o.Callback, multi and v or v[1])
			end
		end
		local function setOpen(v)
			open = v
			tw(row, 0.35, {Size = UDim2.new(1, 0, 0, v and openH or h)}, Enum.EasingStyle.Quint)
			tw(body, 0.35, {Size = UDim2.new(1, 0, 0, v and (openH - h) or 0)}, Enum.EasingStyle.Quint)
			tw(arrow, 0.3, {Rotation = v and 180 or 0}, Enum.EasingStyle.Back)
		end
		local function pick(n)
			if multi then
				if selected[n] then
					selected[n] = nil
				elseif count() >= maxSel then
					win:Notify(rec.Name, "Max " .. tostring(maxSel) .. " selections, remove one first")
					return
				else
					selected[n] = true
				end
			else
				selected = {[n] = true}
			end
			render()
			fire()
			if not multi then setOpen(false) end
		end

		for _, n in ipairs(options) do
			local b = make("TextButton", {
				Size = UDim2.new(1, -4, 0, 26), BorderSizePixel = 0, AutoButtonColor = false,
				Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
				Text = "   " .. tostring(n), Parent = list,
			}, {corner(6)})
			bind(b, "BackgroundColor3", "Panel")
			bind(b, "TextColor3", "Text")
			b.MouseButton1Click:Connect(function() pick(n) end)
			table.insert(buttons, {Name = n, Btn = b})
		end

		search:GetPropertyChangedSignal("Text"):Connect(function()
			local q = string.lower(search.Text)
			for _, b in ipairs(buttons) do
				b.Btn.Visible = q == "" or string.find(string.lower(b.Name), q, 1, true) ~= nil
			end
		end)

		local function setSel(v)
			selected = {}
			if type(v) == "table" then
				for _, n in ipairs(v) do selected[n] = true end
			elseif v ~= nil then
				selected[v] = true
			end
			if not multi then
				local first = values()[1]
				selected = {}
				if first then selected[first] = true end
			end
			render()
		end
		setSel(o.Default)
		rec.Get = function()
			if multi then return values() end
			return values()[1]
		end
		rec.Set = function(v) setSel(v); fire() end
		onTap(function() setOpen(not open) end)
	end

	-- ===== PROPERTIES PANEL (developer-defined settings under the element) =====
	if hasProp then
		local gap = 6
		local listH = 0
		for _, it in ipairs(settings) do
			it.Type = it.Type or "Toggle"
			listH = listH + (it.Type == "Slider" and 50 or 40)
		end
		listH = listH + math.max(#settings - 1, 0) * gap
		local panelH = 24 + listH + 10

		local panel = make("Frame", {
			Position = UDim2.fromOffset(0, h), Size = UDim2.new(1, 0, 0, panelH),
			BackgroundTransparency = 1, Active = true, Parent = row,
		})
		local head = make("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 14),
			Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
			Text = "PROPERTIES", Parent = panel,
		})
		bind(head, "TextColor3", "SubText")

		local inner = make("Frame", {
			Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 0, listH),
			BackgroundTransparency = 1, Parent = panel,
		}, {make("UIListLayout", {Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder})})

		for i, it in ipairs(settings) do
			local child = makeElement(it.Type, inner, it, rec)
			child.Row.LayoutOrder = i
		end

		local expanded = false
		rec.SetExpanded = function(v)
			expanded = v
			tw(row, 0.4, {Size = UDim2.new(1, 0, 0, v and (h + panelH) or h)}, Enum.EasingStyle.Quint)
			tw(propBtn, 0.3, {Rotation = v and 180 or 0}, Enum.EasingStyle.Back)
			bind(propBtn, "BackgroundColor3", v and "Accent" or "Off", true)
		end
		propBtn.MouseButton1Click:Connect(function() rec.SetExpanded(not expanded) end)
	end

	-- register
	if tab then
		win.Order = win.Order + 1
		rec.Order = win.Order
		table.insert(tab.Elements, rec)
		table.insert(win.Elements, rec)
		win:_refresh()
	else
		table.insert(parentRec.Children, rec)
		table.insert(win.Elements, rec)
	end
	return rec
end

-- ============================================================
--  TAB ELEMENTS (public API)
-- ============================================================
function Tab:AddButton(o) return makeElement("Button", self, o, nil) end
function Tab:AddToggle(o) return makeElement("Toggle", self, o, nil) end
function Tab:AddSlider(o) return makeElement("Slider", self, o, nil) end
function Tab:AddDropdown(o) return makeElement("Dropdown", self, o, nil) end

-- ============================================================
--  WINDOW INTERNALS
-- ============================================================
function Win:_newTab(name, icon, list)
	local btn = make("TextButton", {
		Name = name, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, BorderSizePixel = 0,
		Text = "", AutoButtonColor = false, LayoutOrder = 100 + #self.Tabs, Parent = list,
	}, {corner(8)})
	bind(btn, "BackgroundColor3", "Accent")

	local img
	if icon then
		img = bind(make("ImageLabel", {
			BackgroundTransparency = 1, Image = asset(icon), Position = UDim2.fromOffset(10, 8),
			Size = UDim2.fromOffset(18, 18), Parent = btn,
		}), "ImageColor3", "SubText")
	end
	local label = bind(make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(icon and 36 or 12, 0),
		Size = UDim2.new(1, -44, 1, 0), Text = name, Font = Enum.Font.GothamMedium, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
	}), "TextColor3", "SubText")

	local tab = setmetatable({
		Window = self, Name = name, Button = btn, Label = label, Icon = img,
		Page = makePage(self.Pages), Elements = {},
	}, Tab)

	btn.MouseButton1Click:Connect(function() self:_select(tab) end)
	btn.MouseEnter:Connect(function()
		if self.Current ~= tab then tw(btn, 0.2, {BackgroundTransparency = 0.8}) end
	end)
	btn.MouseLeave:Connect(function()
		if self.Current ~= tab then tw(btn, 0.2, {BackgroundTransparency = 1}) end
	end)

	table.insert(self.Tabs, tab)
	return tab
end

function Win:_select(tab)
	if not tab then return end
	self.Current = tab
	if self.SearchQuery ~= "" then self.SearchBox.Text = "" end
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		tw(t.Button, 0.25, {BackgroundTransparency = on and 0 or 1})
		bind(t.Label, "TextColor3", on and "White" or "SubText", true)
		if t.Icon then bind(t.Icon, "ImageColor3", on and "White" or "SubText", true) end
		if on then
			t.Page.Visible = true
			t.Page.Position = UDim2.fromOffset(16, 0)
			tw(t.Page, 0.35, {Position = UDim2.fromOffset(0, 0)})
		else
			t.Page.Visible = false
		end
	end
end

function Win:_refresh()
	for _, t in ipairs(self.UserTabs) do
		local list = {}
		for _, r in ipairs(t.Elements) do
			if not r.Hidden then table.insert(list, r) end
		end
		table.sort(list, function(a, b)
			if a.Favourite ~= b.Favourite then return a.Favourite end
			return a.Order < b.Order
		end)
		for i, r in ipairs(list) do r.Row.LayoutOrder = i end
	end

	local hid = {}
	for _, r in ipairs(self.Elements) do
		if not r.Child and r.Hidden then table.insert(hid, r) end
	end
	table.sort(hid, function(a, b) return a.Order < b.Order end)
	for i, r in ipairs(hid) do r.Row.LayoutOrder = i end

	self.HiddenTab.Button.Visible = #hid > 0
	if #hid == 0 and self.Current == self.HiddenTab then
		self:_select(self.UserTabs[1])
	end

	local q = self.SearchQuery
	for _, r in ipairs(self.Elements) do
		if not r.Child then
			r.Star.Visible = r.Favourite
			if q == "" then
				r.Row.Parent = homeOf(self, r)
			else
				r.Row.Parent = string.find(r.Lower, q, 1, true) and self.SearchPage or nil
			end
		end
	end
end

function Win:_search(text)
	local q = string.lower(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	self.SearchQuery = q
	if q == "" then
		self.SearchPage.Visible = false
		self:_refresh()
		if self.Current then self.Current.Page.Visible = true end
		return
	end
	for _, t in ipairs(self.Tabs) do t.Page.Visible = false end
	self.SearchPage.Visible = true
	self:_refresh()
end

function Win:_closeMenu()
	if self.Menu then
		self.Menu:Destroy()
		self.Menu = nil
	end
end

function Win:_menu(title, items, pos)
	self:_closeMenu()
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local W = 180
	local H = 30 + #items * 34 + 8
	pos = pos or Vector2.new(vp.X / 2 - W / 2, vp.Y / 2 - H / 2)
	local x = math.clamp(pos.X, 8, vp.X - W - 8)
	local y = math.clamp(pos.Y, 8, vp.Y - H - 8)

	local ov = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 50, Parent = self.Gui,
	})
	ov.MouseButton1Click:Connect(function() self:_closeMenu() end)
	self.Menu = ov

	local panel = bind(make("Frame", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(W, H),
		BorderSizePixel = 0, ZIndex = 51, Parent = ov,
	}), "BackgroundColor3", "Panel")
	corner(10, panel)
	bind(make("UIStroke", {Thickness = 1, Parent = panel}), "Color", "Stroke")
	local sc = make("UIScale", {Scale = 0.9, Parent = panel})
	tw(sc, 0.35, {Scale = 1}, Enum.EasingStyle.Back)

	local tl = make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 20),
		Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.upper(title), ZIndex = 52, Parent = panel,
	})
	bind(tl, "TextColor3", "SubText")

	for i, it in ipairs(items) do
		local b = make("TextButton", {
			Position = UDim2.fromOffset(6, 28 + (i - 1) * 34), Size = UDim2.new(1, -12, 0, 30),
			BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, Text = "   " .. it.Text, ZIndex = 52, Parent = panel,
		}, {corner(7)})
		bind(b, "BackgroundColor3", "Card")
		bind(b, "TextColor3", "Text")
		b.MouseEnter:Connect(function() bind(b, "BackgroundColor3", "Off", true) end)
		b.MouseLeave:Connect(function() bind(b, "BackgroundColor3", "Card", true) end)
		b.MouseButton1Click:Connect(function()
			self:_closeMenu()
			task.spawn(it.Run)
		end)
	end
end

-- Hold menu: Favourite / Hide (+ Reset for Dropdown)
function Win:_elementMenu(rec)
	local items = {
		{Text = rec.Favourite and "Unfavourite" or "Favourite", Run = function()
			rec.Favourite = not rec.Favourite
			self:_refresh()
			self:Notify(rec.Name, rec.Favourite and "Pinned to the top" or "Unpinned")
		end},
		{Text = rec.Hidden and "Unhide" or "Hide", Run = function()
			rec.Hidden = not rec.Hidden
			self:_refresh()
		end},
	}
	if rec.Kind == "Dropdown" then
		table.insert(items, {Text = "Reset Value", Run = function()
			if rec.Set then rec.Set(rec.Default) end
		end})
	end
	local p = rec.Row.AbsolutePosition
	local s = rec.Row.AbsoluteSize
	self:_menu("Properties", items, Vector2.new(p.X + s.X - 188, p.Y + s.Y + 4))
end

-- ============================================================
--  FLOATING WIDGETS
-- ============================================================
function Win:_syncFloat(rec)
	if not rec.FloatBtn then return end
	local fl = rec.Floating
	local on = fl ~= nil and fl.Frame ~= nil and not fl.Hidden
	bind(rec.FloatBtn, "BackgroundColor3", on and "Accent" or "Off", true)
end

function Win:_toggleFloat(rec)
	local fl = rec.Floating
	if fl and fl.Frame and not fl.Hidden then
		self:_removeFloat(rec)
	elseif fl and fl.Frame then
		self:_showFloat(rec, true)
	else
		self:_makeFloat(rec)
	end
end

function Win:_makeFloat(rec, x, y)
	if rec.Floating and rec.Floating.Frame then rec.Floating.Frame:Destroy() end
	local isSlider = rec.Kind == "Slider"
	local W = isSlider and 150 or 124
	local fl = rec.Floating or {}
	rec.Floating = fl
	fl.X = x or fl.X or (140 + (#self.Floats % 6) * 28)
	fl.Y = y or fl.Y or (120 + (#self.Floats % 6) * 28)
	fl.Locked = fl.Locked or false
	fl.Hidden = false

	local frame = bind(make("Frame", {
		Size = UDim2.fromOffset(W, 34), Position = UDim2.fromOffset(fl.X, fl.Y),
		BorderSizePixel = 0, ClipsDescendants = true, Parent = self.FloatGui,
	}), "BackgroundColor3", "Panel")
	corner(8, frame)
	bind(make("UIStroke", {Thickness = 1.2, Parent = frame}), "Color", "Accent")
	fl.Frame = frame

	local label = bind(make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, isSlider and 3 or 0),
		Size = UDim2.new(1, -36, 0, isSlider and 16 or 34), Font = Enum.Font.GothamMedium,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = rec.Name, Parent = frame,
	}), "TextColor3", "Text")

	local dot, barFill
	if rec.Kind == "Toggle" then
		dot = bind(make("Frame", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(10, 10), BorderSizePixel = 0, Parent = frame,
		}), "BackgroundColor3", "Off")
		corner(5, dot)
	elseif isSlider then
		local bar = bind(make("Frame", {
			Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -20, 0, 4),
			BorderSizePixel = 0, Parent = frame,
		}), "BackgroundColor3", "Off")
		corner(2, bar)
		barFill = bind(make("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = bar}), "BackgroundColor3", "Accent")
		corner(2, barFill)

		local sliderHit = make("TextButton", {
			Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3, Parent = frame,
		})
		local sd = false
		local function fromX(x2)
			local pct = math.clamp((x2 - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
			rec.Set(rec.Min + (rec.Max - rec.Min) * pct)
		end
		sliderHit.InputBegan:Connect(function(i) if isPress(i) then sd = true; fromX(i.Position.X) end end)
		UIS.InputChanged:Connect(function(i) if sd and isMove(i) then fromX(i.Position.X) end end)
		UIS.InputEnded:Connect(function(i) if isPress(i) then sd = false end end)
	end

	local function sync()
		local v = rec.Get and rec.Get()
		if rec.Kind == "Toggle" then
			label.Text = rec.Name
			bind(dot, "BackgroundColor3", v and "Accent" or "Off", true)
		elseif rec.Kind == "Slider" then
			label.Text = rec.Name .. "  " .. tostring(v) .. (rec.Suffix or "")
			local pct = (rec.Max > rec.Min) and (v - rec.Min) / (rec.Max - rec.Min) or 0
			tw(barFill, 0.15, {Size = UDim2.fromScale(pct, 1)})
		end
	end
	rec.FloatUpdate = sync
	sync()

	local hit = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 2, Parent = frame,
	})
	makeDraggable(hit, frame, function() return not fl.Locked end, function(f)
		fl.X, fl.Y = f.Position.X.Offset, f.Position.Y.Offset
	end)
	attachHold(hit, function() self:_floatMenu(rec) end, function()
		if rec.Kind == "Button" then
			rec.Fire()
		elseif rec.Kind == "Toggle" then
			rec.Set(not rec.Get())
		end
	end)

	if not table.find(self.Floats, rec) then table.insert(self.Floats, rec) end
	self:_syncFloat(rec)
	return fl
end

function Win:_showFloat(rec, show)
	local fl = rec.Floating
	if not fl or not fl.Frame then return end
	fl.Hidden = not show
	local f = fl.Frame
	local w = f.Size.X.Offset
	if show then
		f.Visible = true
		tw(f, 0.35, {Size = UDim2.fromOffset(w, 34), BackgroundTransparency = 0}, Enum.EasingStyle.Back)
	else
		tw(f, 0.25, {Size = UDim2.fromOffset(w, 0), BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
		task.delay(0.27, function()
			if fl.Hidden and fl.Frame then fl.Frame.Visible = false end
		end)
	end
	self:_syncFloat(rec)
end

function Win:_removeFloat(rec)
	local fl = rec.Floating
	if fl and fl.Frame then fl.Frame:Destroy() end
	rec.Floating = nil
	rec.FloatUpdate = nil
	for i, r in ipairs(self.Floats) do
		if r == rec then table.remove(self.Floats, i) break end
	end
	self:_syncFloat(rec)
end

function Win:_floatMenu(rec)
	local fl = rec.Floating
	if not fl or not fl.Frame then return end
	local p = fl.Frame.AbsolutePosition
	local s = fl.Frame.AbsoluteSize
	self:_menu("Floating  " .. rec.Name, {
		{Text = fl.Locked and "Unlock Position" or "Lock Position", Run = function()
			fl.Locked = not fl.Locked
			self:Notify(rec.Name, fl.Locked and "Position locked" or "Position unlocked")
		end},
		{Text = "Hide", Run = function() self:_showFloat(rec, false) end},
		{Text = "Remove", Run = function() self:_removeFloat(rec) end},
	}, Vector2.new(p.X + s.X + 6, p.Y))
end

-- ============================================================
--  DIALOG + NOTIFY
-- ============================================================
function Win:_dialog(title, default, onOk, confirmOnly)
	self:_closeMenu()
	if self.Dialog then self.Dialog:Destroy() end
	local ov = make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, ZIndex = 70, Parent = self.Gui,
	})
	self.Dialog = ov

	local p = bind(make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(300, confirmOnly and 128 or 158), BorderSizePixel = 0,
		ZIndex = 71, Parent = ov,
	}), "BackgroundColor3", "Panel")
	corner(12, p)
	tw(make("UIScale", {Scale = 0.9, Parent = p}), 0.4, {Scale = 1}, Enum.EasingStyle.Back)

	local t = make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 22),
		Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = title, ZIndex = 72, Parent = p,
	})
	bind(t, "TextColor3", "Text")

	local box
	if not confirmOnly then
		box = make("TextBox", {
			Position = UDim2.fromOffset(16, 46), Size = UDim2.new(1, -32, 0, 34), BorderSizePixel = 0,
			Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			Text = default or "", ClearTextOnFocus = false, ZIndex = 72, Parent = p,
		}, {corner(8), make("UIPadding", {PaddingLeft = UDim.new(0, 10)})})
		bind(box, "BackgroundColor3", "Card")
		bind(box, "TextColor3", "Text")
	end

	local y = confirmOnly and 68 or 92
	local function close()
		if self.Dialog == ov then self.Dialog = nil end
		ov:Destroy()
	end

	local cancel = make("TextButton", {
		Position = UDim2.fromOffset(16, y), Size = UDim2.fromOffset(126, 34), BorderSizePixel = 0,
		AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = 13, Text = "Cancel",
		ZIndex = 72, Parent = p,
	}, {corner(8)})
	bind(cancel, "BackgroundColor3", "Off")
	bind(cancel, "TextColor3", "Text")
	cancel.MouseButton1Click:Connect(close)

	local okBtn = make("TextButton", {
		Position = UDim2.fromOffset(158, y), Size = UDim2.fromOffset(126, 34), BorderSizePixel = 0,
		AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 13,
		Text = confirmOnly and "Delete" or "OK", ZIndex = 72, Parent = p,
	}, {corner(8)})
	bind(okBtn, "BackgroundColor3", confirmOnly and "Off" or "Accent")
	bind(okBtn, "TextColor3", "White")
	okBtn.MouseButton1Click:Connect(function()
		local v = box and box.Text or nil
		close()
		if onOk then onOk(v) end
	end)
end

function Win:Notify(title, text)
	if not self.NotifyOn then return end
	local toast = bind(make("Frame", {
		Size = UDim2.fromOffset(250, 50), BorderSizePixel = 0, ZIndex = 60, Parent = self.ToastHolder,
	}), "BackgroundColor3", "Panel")
	corner(9, toast)
	bind(make("UIStroke", {Thickness = 1, Parent = toast}), "Color", "Accent")

	local t1 = make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 18),
		Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(title), ZIndex = 61, Parent = toast,
	})
	bind(t1, "TextColor3", "Text")
	local t2 = make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -24, 0, 20),
		Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(text), ZIndex = 61, Parent = toast,
	})
	bind(t2, "TextColor3", "SubText")

	task.delay(3, function() toast:Destroy() end)
end

-- ============================================================
--  CONFIG SYSTEM
-- ============================================================
function Win:_snapshot()
	local data = {version = 2, elements = {}}
	for _, r in ipairs(self.Elements) do
		local e = {fav = r.Favourite == true, hid = r.Hidden == true}
		if r.Get then e.v = r.Get() end
		if r.Floating then
			e.fl = {x = r.Floating.X, y = r.Floating.Y, locked = r.Floating.Locked, hidden = r.Floating.Hidden}
		end
		data.elements[r.Id] = e
	end
	return data
end

function Win:_apply(data)
	local els = data.elements or {}
	for _, r in ipairs(self.Elements) do
		local e = els[r.Id]
		if e then
			if not r.Child then
				r.Favourite = e.fav == true
				r.Hidden = e.hid == true
			end
			if e.v ~= nil and r.Set then r.Set(e.v) end
			if not r.Child then
				if r.Floating then self:_removeFloat(r) end
				if e.fl then
					self:_makeFloat(r, e.fl.x, e.fl.y)
					r.Floating.Locked = e.fl.locked == true
					if e.fl.hidden then self:_showFloat(r, false) end
				end
			end
		end
	end
	self:_refresh()
end

function Win:_saveConfig(name)
	local ok, json = pcall(function() return HttpService:JSONEncode(self:_snapshot()) end)
	if not ok then return self:Notify("Config", "Failed to encode data") end
	fsWrite(cfgPath(name), json)
	self:Notify("Config", "Saved '" .. name .. "'")
	self:_refreshConfigs()
end

function Win:_loadConfig(name)
	local raw = fsRead(cfgPath(name))
	if not raw then return self:Notify("Config", "'" .. name .. "' not found") end
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(data) ~= "table" then return self:Notify("Config", "File is corrupted") end
	self:_apply(data)
	self.SelectedConfig = name
	self:Notify("Config", "Loaded '" .. name .. "'")
	self:_refreshConfigs()
end

function Win:_cfgMenu(name)
	local isAuto = fsRead(AUTO_PATH) == name
	self:_menu("Config  " .. name, {
		{Text = isAuto and "Disable Auto-Load" or "Auto-Load", Run = function()
			fsWrite(AUTO_PATH, isAuto and "" or name)
			self:Notify("Auto-Load", isAuto and "Disabled" or (name .. " loads on start"))
			self:_refreshConfigs()
		end},
		{Text = "Load", Run = function() self:_loadConfig(name) end},
		{Text = "Rename", Run = function()
			self:_dialog("Rename config", name, function(v)
				local new = sanitize(v)
				if new == "" or new == name then return end
				if fsRead(cfgPath(new)) then return self:Notify("Config", "'" .. new .. "' already exists") end
				fsWrite(cfgPath(new), fsRead(cfgPath(name)) or "")
				fsDelete(cfgPath(name))
				if fsRead(AUTO_PATH) == name then fsWrite(AUTO_PATH, new) end
				if self.SelectedConfig == name then self.SelectedConfig = new end
				self:_refreshConfigs()
			end)
		end},
		{Text = "Delete", Run = function()
			self:_dialog("Delete '" .. name .. "'?", nil, function()
				fsDelete(cfgPath(name))
				if fsRead(AUTO_PATH) == name then fsWrite(AUTO_PATH, "") end
				if self.SelectedConfig == name then self.SelectedConfig = nil end
				self:Notify("Config", "Deleted '" .. name .. "'")
				self:_refreshConfigs()
			end, true)
		end},
	})
end

function Win:_refreshConfigs()
	for _, r in ipairs(self.CfgRows) do r:Destroy() end
	self.CfgRows = {}
	local names = fsList()
	table.sort(names)
	local auto = fsRead(AUTO_PATH) or ""
	self.EmptyLbl.Visible = #names == 0

	for i, name in ipairs(names) do
		local row, hit = newRow(self.ConfigTab.Page, 46)
		row.LayoutOrder = 10 + i
		header(row, 46, name, nil, auto == name and 58 or 0)
		if self.SelectedConfig == name then
			local st = row:FindFirstChildOfClass("UIStroke")
			if st then bind(st, "Color", "Accent") end
		end
		if auto == name then
			local tag = make("TextLabel", {
				BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(60, 16),
				Font = Enum.Font.GothamBold, TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Right, Text = "AUTO", Parent = row,
			})
			bind(tag, "TextColor3", "Accent")
		end
		attachHold(hit, function() self:_cfgMenu(name) end, function()
			self.SelectedConfig = name
			self:_loadConfig(name)
		end)
		table.insert(self.CfgRows, row)
	end
end

local function buildConfigTab(win, tab)
	local bar = make("Frame", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 0, Parent = tab.Page,
	}, {
		make("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}),
	})

	local nameBox = make("TextBox", {
		Size = UDim2.new(0.4, -6, 1, 0), BorderSizePixel = 0, Font = Enum.Font.Gotham, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, PlaceholderText = "Config name...",
		Text = "", ClearTextOnFocus = false, LayoutOrder = 1, Parent = bar,
	}, {corner(7), make("UIPadding", {PaddingLeft = UDim.new(0, 10)})})
	bind(nameBox, "BackgroundColor3", "Panel")
	bind(nameBox, "TextColor3", "Text")
	bind(nameBox, "PlaceholderColor3", "SubText")

	local function actionBtn(text, primary, order, cb)
		local b = make("TextButton", {
			Size = UDim2.new(0.2, -6, 1, 0), BorderSizePixel = 0, AutoButtonColor = false,
			Font = Enum.Font.GothamMedium, TextSize = 12, Text = text, LayoutOrder = order, Parent = bar,
		}, {corner(7)})
		bind(b, "BackgroundColor3", primary and "Accent" or "Panel")
		bind(b, "TextColor3", "Text")
		b.MouseButton1Click:Connect(cb)
		return b
	end

	actionBtn("Create", true, 2, function()
		local name = sanitize(nameBox.Text)
		if name == "" then return win:Notify("Config", "Type a name first") end
		if fsRead(cfgPath(name)) then return win:Notify("Config", "'" .. name .. "' already exists") end
		win.SelectedConfig = name
		win:_saveConfig(name)
		nameBox.Text = ""
	end)

	actionBtn("Save", false, 3, function()
		if not win.SelectedConfig then return win:Notify("Config", "Select a config to overwrite") end
		win:_saveConfig(win.SelectedConfig)
	end)

	actionBtn("Folder", false, 4, function()
		win:Notify("Folder", FOLDER .. "/")
	end)

	win.EmptyLbl = make("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Font = Enum.Font.Gotham,
		TextSize = 12, Text = "No saved profiles yet", LayoutOrder = 1, Parent = tab.Page,
	})
	bind(win.EmptyLbl, "TextColor3", "SubText")
end

function Win:CreateTab(name, icon)
	local tab = self:_newTab(name, icon, self.TabList)
	table.insert(self.UserTabs, tab)
	if not self.Current then self:_select(tab) end
	self:_refresh()
	return tab
end

function Win:Toggle(state)
	if state == nil then state = not self.Open end
	if state == self.Open then return end
	self.Open = state
	if state then
		self.Main.Visible = true
		self.Main.GroupTransparency = 1
		self.Main.Position = UDim2.new(0.5, 0, 0.5, 30)
		tw(self.Main, 0.45, {Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 0})
	else
		tw(self.Main, 0.25, {Position = UDim2.new(0.5, 0, 0.5, 30), GroupTransparency = 1}, Enum.EasingStyle.Quad)
		task.delay(0.27, function()
			if not self.Open then self.Main.Visible = false end
		end)
	end
end

function Win:Destroy()
	for _, c in ipairs(self.Conns) do c:Disconnect() end
	self:_closeMenu()
	self.Gui:Destroy()
	self.FloatGui:Destroy()
end

-- ============================================================
--  WINDOW CREATION
-- ============================================================
function Nova.CreateWindow(title, opts)
	opts = opts or {}
	local self = setmetatable({}, Win)
	self.Title = title or "NovaUI"
	self.Key = opts.Key or Enum.KeyCode.RightShift
	self.Elements, self.Tabs, self.UserTabs = {}, {}, {}
	self.Floats, self.Conns, self.CfgRows = {}, {}, {}
	self.Order, self.Open, self.SearchQuery, self.NotifyOn = 0, false, "", true

	local parent = protectedParent()
	local guiName = "NovaUI_" .. self.Title
	for _, n in ipairs({guiName, guiName .. "_Float"}) do
		local old = parent:FindFirstChild(n)
		if old then old:Destroy() end
	end
	self.Gui = make("ScreenGui", {Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 500, Parent = parent})
	self.FloatGui = make("ScreenGui", {Name = guiName .. "_Float", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 499, Parent = parent})

	local W, H = opts.Width or 640, opts.Height or 420
	local Main = make("CanvasGroup", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H), BorderSizePixel = 0, GroupTransparency = 1, Visible = false, Parent = self.Gui,
	})
	bind(Main, "BackgroundColor3", "Background")
	corner(12, Main)
	bind(make("UIStroke", {Thickness = 1, Parent = Main}), "Color", "Stroke")
	self.Main = Main
	self.Scale = make("UIScale", {Parent = Main})

	-- Sidebar
	local Side = bind(make("Frame", {Size = UDim2.new(0, 170, 1, 0), BorderSizePixel = 0, Parent = Main}), "BackgroundColor3", "Panel")
	corner(12, Side)
	local dragBar = make("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Active = true, Parent = Side})
	makeDraggable(dragBar, Main)
	local titleLbl = make("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 26),
		Font = Enum.Font.GothamBold, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left,
		Text = self.Title, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Side,
	})
	bind(titleLbl, "TextColor3", "Accent")

	self.TabList = make("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 52), Size = UDim2.new(1, -16, 1, -184),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Side,
	}, {make("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})})

	bind(make("Frame", {Position = UDim2.new(0, 12, 1, -124), Size = UDim2.new(1, -24, 0, 1), BorderSizePixel = 0, Parent = Side}), "BackgroundColor3", "Stroke")
	local bottomList = make("Frame", {
		Position = UDim2.new(0, 8, 1, -116), Size = UDim2.new(1, -16, 0, 110), BackgroundTransparency = 1, Parent = Side,
	}, {make("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})})

	-- Content
	local Content = make("Frame", {Position = UDim2.fromOffset(170, 0), Size = UDim2.new(1, -170, 1, 0), BackgroundTransparency = 1, Parent = Main})
	local sBar = bind(make("Frame", {Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 32), BorderSizePixel = 0, Parent = Content}), "BackgroundColor3", "Panel")
	corner(8, sBar)
	local sIcon = make("ImageLabel", {BackgroundTransparency = 1, Image = ICON.Search, Position = UDim2.fromOffset(10, 7), Size = UDim2.fromOffset(18, 18), Parent = sBar})
	bind(sIcon, "ImageColor3", "SubText")
	self.SearchBox = make("TextBox", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -44, 1, 0),
		Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "", PlaceholderText = "Search elements...", ClearTextOnFocus = false, Parent = sBar,
	})
	bind(self.SearchBox, "TextColor3", "Text")
	bind(self.SearchBox, "PlaceholderColor3", "SubText")
	self.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self:_search(self.SearchBox.Text)
	end)

	self.Pages = make("Frame", {
		Position = UDim2.fromOffset(14, 54), Size = UDim2.new(1, -28, 1, -66),
		BackgroundTransparency = 1, ClipsDescendants = true, Parent = Content,
	})
	self.SearchPage = makePage(self.Pages)

	-- Special tabs
	self.HiddenTab = self:_newTab("Hidden", nil, self.TabList)
	self.HiddenTab.Button.Visible = false
	self.HiddenTab.Button.LayoutOrder = 999

	local ThemesTab = self:_newTab("Themes", ICON.Themes, bottomList)
	local ConfigTab = self:_newTab("Config", ICON.Config, bottomList)
	local SettingsTab = self:_newTab("Settings", ICON.Settings, bottomList)
	self.ConfigTab = ConfigTab

	-- Toast holder
	self.ToastHolder = make("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(260, 400), BackgroundTransparency = 1, ZIndex = 60, Parent = self.Gui,
	}, {make("UIListLayout", {
		Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder,
	})})

	-- Themes tab
	local themeNames = {}
	for k in pairs(THEMES) do table.insert(themeNames, k) end
	table.sort(themeNames)
	ThemesTab:AddDropdown({
		Name = "Theme", Options = themeNames, Default = currentTheme, Max = 1,
		Description = "Changes accent color everywhere",
		Callback = function(v) setTheme(v) end,
	})

	-- Config tab
	buildConfigTab(self, ConfigTab)
	self:_refreshConfigs()

	-- Settings tab
	SettingsTab:AddSlider({
		Name = "UI Scale", Min = 60, Max = 140, Default = 100, Increment = 5, Suffix = "%",
		Description = "Resize the whole menu",
		Callback = function(v) self.Scale.Scale = v / 100 end,
	})
	SettingsTab:AddToggle({
		Name = "Notifications", Default = true, Description = "Show toast messages",
		Callback = function(v) self.NotifyOn = v end,
	})
	SettingsTab:AddDropdown({
		Name = "Menu Key", Options = {"RightShift", "RightControl", "Insert", "Home"}, Default = "RightShift",
		Callback = function(v) self.Key = Enum.KeyCode[v] end,
	})
	SettingsTab:AddButton({
		Name = "Unload", Description = "Remove the UI completely",
		Callback = function() self:Destroy() end,
	})

	-- Keybind
	table.insert(self.Conns, UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == self.Key then self:Toggle() end
	end))

	-- Auto-Load (runs after your script has created its elements)
	task.delay(0.5, function()
		local name = fsRead(AUTO_PATH)
		if name and name ~= "" and fsRead(cfgPath(name)) then
			self:_loadConfig(name)
		end
	end)

	self:Toggle(opts.StartOpen ~= false)
	return self
end

-- ============================================================
--  EXAMPLE USAGE (remove or edit as needed)
-- ============================================================
local Hub = Nova.CreateWindow("Nova Hub", {Key = Enum.KeyCode.RightShift})

local Farm = Hub:CreateTab("Farm")

Farm:AddButton({
	Name = "Say Hello", Description = "Prints a message",
	Callback = function() print("Hello from NovaUI") end,
})

Farm:AddToggle({
	Name = "Auto Farm", Default = false, Description = "Farms automatically",
	Callback = function(v) print("Auto Farm:", v) end,
	Settings = {
		{Type = "Toggle", Name = "Farm Shop", Default = false,
			Callback = function(v) print("Farm Shop:", v) end},
		{Type = "Toggle", Name = "Sell When Complete", Default = true,
			Callback = function(v) print("Sell When Complete:", v) end},
		{Type = "Slider", Name = "Farm Radius", Min = 10, Max = 200, Default = 50, Suffix = " studs",
			Callback = function(v) print("Farm Radius:", v) end},
	},
})

Farm:AddSlider({
	Name = "Speed", Min = 16, Max = 100, Default = 16, Increment = 1, Suffix = " studs/s",
	Callback = function(v) print("Speed:", v) end,
})

Farm:AddDropdown({
	Name = "Targets", Options = {"Head", "Torso", "Arms", "Legs", "Random"},
	Multi = true, Max = 3, Default = {"Head"},
	Callback = function(v) print("Targets:", table.concat(v, ", ")) end,
})
