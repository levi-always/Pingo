--[[
    PingoUI v1.0.0
    Hub UI library for Roblox executors

    local PingoUI = loadstring(game:HttpGet("RAW_URL"))()
    local Win = PingoUI.CreateWindow("My Hub", "v1.0.0", {Theme = "Ruby"})
    local Main = Win:CreateSideTab("Main", Icons.Settings)
    local Tab = Main:CreateTab("General")
    Tab:AddButton("Hello", function() Win:Notify("Hi", "Works!", 3) end, {Description = "Test"})
]]

local PingoUI = {Version = "1.0.0", Name = "PingoUI"}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local LP = Players.LocalPlayer
local QUINT, QUAD, BACK = Enum.EasingStyle.Quint, Enum.EasingStyle.Quad, Enum.EasingStyle.Back
local OUT, IN = Enum.EasingDirection.Out, Enum.EasingDirection.In

local DEFAULT_W, DEFAULT_H = 720, 440
local SIDE_W = 170
local CELL_H = 74
local GAP = 4
local NAV_Y = 62
local ROOT_FOLDER = "PingoUI"

-- ============================================================
--  ASSETS  (paste your own links here, 0 = none)
-- ============================================================
local Icons = {
	Star = 5078542968,
	Info = 80303879583492,
	Themes = 88003022051687,
	Config = 137882818389597,
	Settings = 9405931578,
	Minus = 12338394619,
	Plus = 12338396009,
	Search = 6031154871,
	Link = 0,
	Float = 0,
	Custom = 0,
	Lock = 0,
}

-- ============================================================
--  SOUNDS  (fill the IDs you want, "" = silent)
--  Suggested: ToggleOn, ToggleOff, Tick (slider), Stepper,
--  Open, Close, Notify, Error
-- ============================================================
local Sounds = {
	Click = "rbxassetid://139719503904449",
	ToggleOn = "",
	ToggleOff = "",
	Tick = "",
	Stepper = "",
	Open = "",
	Close = "",
	Notify = "",
	Error = "",
}

-- ============================================================
--  THEMES
-- ============================================================
local BASE = {
	Background = Color3.fromRGB(18, 19, 24), Sidebar = Color3.fromRGB(24, 25, 31),
	Card = Color3.fromRGB(32, 34, 42), Off = Color3.fromRGB(55, 58, 70),
	Text = Color3.fromRGB(240, 240, 245), SubText = Color3.fromRGB(140, 145, 160),
	White = Color3.fromRGB(255, 255, 255), Stroke = Color3.fromRGB(44, 46, 58),
}

local THEME_LIST = {
	{"Ruby", Color3.fromRGB(255, 59, 83), Color3.fromRGB(255, 110, 80)},
	{"Crimson", Color3.fromRGB(220, 40, 60), Color3.fromRGB(255, 70, 110)},
	{"Rose", Color3.fromRGB(255, 100, 140), Color3.fromRGB(255, 150, 170)},
	{"Magenta", Color3.fromRGB(255, 70, 180), Color3.fromRGB(255, 95, 110)},
	{"Coral", Color3.fromRGB(255, 110, 100), Color3.fromRGB(255, 160, 120)},
	{"Tangerine", Color3.fromRGB(255, 130, 37), Color3.fromRGB(255, 190, 60)},
	{"Amber", Color3.fromRGB(255, 176, 0), Color3.fromRGB(255, 215, 80)},
	{"Gold", Color3.fromRGB(255, 200, 40), Color3.fromRGB(255, 235, 120)},
	{"Sun", Color3.fromRGB(240, 225, 50), Color3.fromRGB(190, 255, 70)},
	{"Lemon", Color3.fromRGB(235, 255, 90), Color3.fromRGB(160, 255, 130)},
	{"Lime", Color3.fromRGB(110, 255, 70), Color3.fromRGB(50, 230, 140)},
	{"Mint", Color3.fromRGB(120, 255, 190), Color3.fromRGB(90, 230, 230)},
	{"Emerald", Color3.fromRGB(46, 220, 130), Color3.fromRGB(30, 200, 200)},
	{"Forest", Color3.fromRGB(60, 180, 90), Color3.fromRGB(140, 220, 90)},
	{"Teal", Color3.fromRGB(20, 200, 180), Color3.fromRGB(40, 150, 230)},
	{"Aurora", Color3.fromRGB(110, 255, 190), Color3.fromRGB(150, 110, 255)},
	{"Cyan", Color3.fromRGB(40, 230, 255), Color3.fromRGB(60, 150, 255)},
	{"Sky", Color3.fromRGB(120, 200, 255), Color3.fromRGB(170, 150, 255)},
	{"Azure", Color3.fromRGB(60, 130, 255), Color3.fromRGB(90, 210, 255)},
	{"Ocean", Color3.fromRGB(0, 190, 210), Color3.fromRGB(40, 110, 255)},
	{"Sapphire", Color3.fromRGB(40, 90, 255), Color3.fromRGB(100, 60, 230)},
	{"Indigo", Color3.fromRGB(90, 80, 255), Color3.fromRGB(160, 90, 255)},
	{"Violet", Color3.fromRGB(190, 80, 255), Color3.fromRGB(255, 90, 200)},
	{"Orchid", Color3.fromRGB(165, 130, 230), Color3.fromRGB(120, 140, 255)},
	{"Gurple", Color3.fromRGB(140, 60, 235), Color3.fromRGB(60, 120, 255)},
	{"Grape", Color3.fromRGB(160, 90, 255), Color3.fromRGB(225, 90, 255)},
	{"Lavender", Color3.fromRGB(190, 160, 255), Color3.fromRGB(255, 170, 220)},
	{"Neon", Color3.fromRGB(0, 235, 255), Color3.fromRGB(220, 70, 220)},
	{"Sunset", Color3.fromRGB(255, 115, 90), Color3.fromRGB(255, 160, 20)},
	{"Candy", Color3.fromRGB(255, 120, 200), Color3.fromRGB(120, 200, 255)},
	{"Ice", Color3.fromRGB(200, 240, 255), Color3.fromRGB(130, 190, 255)},
	{"Mono", Color3.fromRGB(200, 200, 205), Color3.fromRGB(120, 122, 130)},
}

local BLACK = Color3.new(0, 0, 0)
local THEMES = {}

local function buildTheme(acc, acc2)
	local d = {
		Accent = acc, Accent2 = acc2,
		AccentDark = acc:Lerp(BLACK, 0.35), Accent2Dark = acc2:Lerp(BLACK, 0.35),
	}
	for k, v in pairs(BASE) do d[k] = v end
	return d
end

for _, t in ipairs(THEME_LIST) do
	THEMES[t[1]] = buildTheme(t[2], t[3])
end

local currentTheme = "Ruby"
local function T(key)
	return THEMES[currentTheme][key]
end

-- ============================================================
--  HELPERS
-- ============================================================
local bound = setmetatable({}, {__mode = "k"})      -- obj -> {prop = key}
local gradients = setmetatable({}, {__mode = "k"})  -- UIGradient -> keys
local themeHooks = {}

local function tw(obj, t, props, style, dir)
	if not obj then return end
	local tween = TweenService:Create(obj, TweenInfo.new(t or 0.2, style or QUAD, dir or OUT), props)
	tween:Play()
	return tween
end

local function new(class, props, children)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

local function corner(r, parent)
	return new("UICorner", {CornerRadius = UDim.new(0, r), Parent = parent})
end

local function icon(v)
	if v == nil or v == 0 or v == "" then return nil end
	if type(v) == "number" then return "rbxassetid://" .. v end
	v = tostring(v)
	if v:match("^%d+$") then return "rbxassetid://" .. v end
	return v
end

local function bind(obj, prop, key, animate)
	local b = bound[obj]
	if not b then b = {}; bound[obj] = b end
	b[prop] = key
	if animate then tw(obj, 0.25, {[prop] = T(key)}) else obj[prop] = T(key) end
end

local function seq(keys)
	local n, pts = #keys, {}
	for i, k in ipairs(keys) do
		pts[i] = ColorSequenceKeypoint.new(n == 1 and 0 or (i - 1) / (n - 1), T(k))
	end
	return ColorSequence.new(pts)
end

local function grad(keys, parent, props)
	local g = new("UIGradient", props or {})
	g.Color = seq(keys)
	g.Parent = parent
	gradients[g] = keys
	return g
end

local function text(props, key)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 13
	local o = new("TextLabel", props)
	bind(o, "TextColor3", key or "Text")
	return o
end

local function fit(lbl, max, min)
	lbl.TextScaled = true
	new("UITextSizeConstraint", {MaxTextSize = max or 15, MinTextSize = min or 8, Parent = lbl})
end

local function shimmer(g, t)
	TweenService:Create(g, TweenInfo.new(t or 2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.6, 0)}):Play()
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local function pointIn(p, g)
	if not g or not g.Parent then return false end
	local a, s = g.AbsolutePosition, g.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

local function sanitize(n)
	n = tostring(n or ""):gsub("[^%w%s%-_%.]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return string.sub(n, 1, 32)
end

local function copyText(s)
	if type(setclipboard) == "function" then
		pcall(setclipboard, tostring(s or ""))
		return true
	end
	return false
end

local function makeOpts(name, extra)
	local o = {}
	if type(extra) == "table" then
		for k, v in pairs(extra) do o[k] = v end
	end
	o.Name = name
	return o
end

-- ============================================================
--  GLOBAL THEME API
-- ============================================================
function PingoUI.SetTheme(name)
	if not THEMES[name] then return end
	currentTheme = name
	for obj, b in pairs(bound) do
		if obj.Parent then
			for prop, key in pairs(b) do
				tw(obj, 0.35, {[prop] = T(key)})
			end
		end
	end
	for g, keys in pairs(gradients) do
		if g.Parent then g.Color = seq(keys) end
	end
	for _, fn in ipairs(themeHooks) do pcall(fn, name) end
end

function PingoUI.GetThemeNames()
	local out = {}
	for _, t in ipairs(THEME_LIST) do table.insert(out, t[1]) end
	return out
end

function PingoUI.SetCustomColor(color)
	THEMES.Custom = buildTheme(color, color:Lerp(Color3.new(1, 1, 1), 0.35))
	PingoUI.SetTheme("Custom")
end

-- ============================================================
--  CREATE WINDOW
-- ============================================================
function PingoUI.CreateWindow(title, version, config)
	config = config or {}
	title = tostring(title or PingoUI.Name)
	version = tostring(version or PingoUI.Version)
	if config.Theme and THEMES[config.Theme] then currentTheme = config.Theme end
	local W, H = config.Width or DEFAULT_W, config.Height or DEFAULT_H

	local win = {
		SideTabs = {}, Elements = {}, Registry = {}, Floats = {}, Conns = {},
		Counter = 0, FavCounter = 0, FloatCounter = 0,
		Opened = false, Unloaded = false, SizeMul = 1, Opacity = 0,
		Locked = false, NotifyOn = true, ReduceMotion = false, Volume = 50,
		Search = "", ActiveSide = nil, ActiveTab = nil,
	}

	local function connect(sig, fn)
		local c = sig:Connect(fn)
		table.insert(win.Conns, c)
		return c
	end

	local function sfx(key)
		local id = Sounds[key]
		if not id or id == "" or win.Volume <= 0 then return end
		local s = new("Sound", {SoundId = id, Volume = win.Volume / 100, Parent = SoundService})
		s:Play()
		Debris:AddItem(s, 4)
	end

	-- ---------- GUI ROOT ----------
	local parent
	if gethui then pcall(function() parent = gethui() end) end
	if not parent then pcall(function() parent = game:GetService("CoreGui") end) end
	if not parent then parent = LP:WaitForChild("PlayerGui") end
	local old = parent:FindFirstChild(ROOT_FOLDER)
	if old then old:Destroy() end

	local gui = new("ScreenGui", {
		Name = ROOT_FOLDER, ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	if not pcall(function() gui.Parent = parent end) or not gui.Parent then
		gui.Parent = LP:WaitForChild("PlayerGui")
	end

	-- ---------- HOLDER (fade + scale) ----------
	local Holder = new("CanvasGroup", {
		Name = "Holder", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = UDim2.fromOffset(W, H), BackgroundTransparency = 1,
		GroupTransparency = 1, Visible = false, Parent = gui,
	})
	local fitScale = new("UIScale", {Parent = Holder})

	local function targetScale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local fit = math.min((vp.X - 24) / W, (vp.Y - 90) / H, 1)
		return math.clamp(fit * win.SizeMul, 0.3, 1.8)
	end

	local function refit(anim)
		local s = targetScale()
		if anim then tw(fitScale, 0.3, {Scale = s}, QUINT) else fitScale.Scale = s end
	end
	refit(false)
	if workspace.CurrentCamera then
		connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function() refit(false) end)
	end

	-- ---------- MAIN (transparency group) ----------
	local Main = new("CanvasGroup", {
		Name = "Main", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0,
		ClipsDescendants = true, Parent = Holder,
	}, {corner(12)})
	bind(Main, "BackgroundColor3", "Background")
	local mainStroke = new("UIStroke", {Thickness = 1.5, Parent = Main})
	bind(mainStroke, "Color", "Stroke")

	local topLine = new("Frame", {Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, ZIndex = 20, Parent = Main})
	topLine.BackgroundColor3 = Color3.new(1, 1, 1)
	local topG = grad({"Accent", "Accent2", "Accent"}, topLine, {Offset = Vector2.new(-1, 0)})
	TweenService:Create(topG, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), {Offset = Vector2.new(1, 0)}):Play()

	-- ---------- SIDEBAR ----------
	local Sidebar = new("Frame", {Name = "Sidebar", Size = UDim2.new(0, SIDE_W, 1, 0), BorderSizePixel = 0, Parent = Main})
	bind(Sidebar, "BackgroundColor3", "Sidebar")
	local divider = new("Frame", {Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0), BorderSizePixel = 0, Parent = Sidebar})
	bind(divider, "BackgroundColor3", "Stroke")

	local Header = new("Frame", {Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 46), BackgroundTransparency = 1, Parent = Sidebar})
	local titleLbl = text({
		Text = title, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, 24), Parent = Header,
	}, "White")
	fit(titleLbl, 17, 9)
	shimmer(grad({"Accent", "Accent2", "Accent"}, titleLbl, {Offset = Vector2.new(-.6, 0)}), 2.6)

	local versionLbl = text({
		Text = version, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 16), Parent = Header,
	}, "SubText")
	fit(versionLbl, 12, 8)

	local sysSep = new("Frame", {Position = UDim2.new(0, 16, 1, -(12 + 3 * 42 + 6)), Size = UDim2.new(1, -32, 0, 1), BorderSizePixel = 0, Parent = Sidebar})
	bind(sysSep, "BackgroundColor3", "Stroke")

	local NavPill = new("Frame", {Name = "NavPill", Position = UDim2.new(0, 10, 0, NAV_Y), Size = UDim2.new(1, -20, 0, 38), BorderSizePixel = 0, Visible = false, ZIndex = 1, Parent = Sidebar}, {corner(9)})
	grad({"AccentDark", "Accent2Dark"}, NavPill)

	-- ---------- CONTENT ----------
	local Content = new("Frame", {Name = "Content", Position = UDim2.fromOffset(SIDE_W, 0), Size = UDim2.new(1, -SIDE_W, 1, 0), BackgroundTransparency = 1, Parent = Main})
	local SearchBar = new("Frame", {Position = UDim2.fromOffset(14, 14), Size = UDim2.new(1, -28, 0, 36), BorderSizePixel = 0, Parent = Content}, {corner(9)})
	bind(SearchBar, "BackgroundColor3", "Sidebar")
	local searchStroke = new("UIStroke", {Thickness = 1, Parent = SearchBar})
	bind(searchStroke, "Color", "Stroke")
	local searchIcon = new("ImageLabel", {Image = icon(Icons.Search) or "", AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Parent = SearchBar})
	bind(searchIcon, "ImageColor3", "SubText")
	local searchBox = text({
		Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -48, 1, 0), Text = "",
		PlaceholderText = "Search", Font = Enum.Font.Gotham, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = SearchBar,
	}, "Text")
	bind(searchBox, "PlaceholderColor3", "SubText")
	searchBox.Focused:Connect(function() bind(searchStroke, "Color", "Accent", true) end)
	searchBox.FocusLost:Connect(function() bind(searchStroke, "Color", "Stroke", true) end)

	local TabBarHolder = new("Frame", {Position = UDim2.fromOffset(14, 58), Size = UDim2.new(1, -28, 0, 34), BackgroundTransparency = 1, Parent = Content})
	local PagesHolder = new("Frame", {Position = UDim2.fromOffset(14, 100), Size = UDim2.new(1, -28, 1, -112), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Content})

	local Results = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		Visible = false, Parent = PagesHolder,
	})
	new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), Parent = Results})
	new("UIGridLayout", {CellSize = UDim2.new(0.5, -5, 0, CELL_H), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Results})
	bind(Results, "ScrollBarImageColor3", "SubText")

	-- ---------- BOTTOM BAR ----------
	local Bar = new("Frame", {
		Name = "BottomBar", AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 1, 12),
		Size = UDim2.new(1, -40, 0, 34), BackgroundTransparency = 1, Parent = Holder,
	})

	-- ---------- PILL HELPER ----------
	local function hoverPop(b)
		local sc = new("UIScale", {Parent = b})
		b.MouseEnter:Connect(function() tw(sc, 0.18, {Scale = 1.04}, BACK) end)
		b.MouseLeave:Connect(function() tw(sc, 0.2, {Scale = 1}) end)
		b.MouseButton1Down:Connect(function() tw(sc, 0.08, {Scale = 0.95}) end)
		b.MouseButton1Up:Connect(function() tw(sc, 0.25, {Scale = 1.04}, BACK) end)
	end

	local function pill(par, spec, props)
		spec, props = spec or {}, props or {}
		local style = spec.Style or "Default"
		local b = new("TextButton", {
			Text = "", AutoButtonColor = false, BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = props.Size or UDim2.fromOffset(100, 32),
			Position = props.Position or UDim2.new(),
			AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
			LayoutOrder = props.LayoutOrder or 0,
			Parent = par,
		}, {corner(props.Radius or 8)})
		if style == "Primary" then
			grad({"Accent", "Accent2"}, b, {Rotation = 15})
		elseif style == "Danger" then
			new("UIGradient", {Rotation = 15, Color = ColorSequence.new(Color3.fromRGB(225, 45, 70), Color3.fromRGB(255, 80, 105)), Parent = b})
		else
			bind(b, "BackgroundColor3", "Off")
			local st = new("UIStroke", {Thickness = 1, Transparency = .3, Parent = b})
			bind(st, "Color", "Stroke")
		end
		local x = 0
		local ico = icon(spec.Icon)
		if ico then
			new("ImageLabel", {Image = ico, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 10, .5, 0), Size = UDim2.fromOffset(15, 15), BackgroundTransparency = 1, Parent = b})
			x = 32
		end
		local lbl = text({
			Text = tostring(spec.Text or ""), Font = Enum.Font.GothamBold, TextSize = props.TextSize or 12,
			Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 6, 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
		}, style == "Default" and "Text" or "White")
		hoverPop(b)
		return b, lbl
	end

	-- ---------- OPEN / HIDE / UNLOAD ----------
	local hideBtn = pill(Bar, {Text = config.HideText or "Hide Menu", Icon = config.HideIcon}, {Size = UDim2.new(.5, -5, 1, 0), Radius = 9, TextSize = 13})
	local unloadBtn = pill(Bar, {Text = config.UnloadText or "Unload Menu", Icon = config.UnloadIcon, Style = "Primary"}, {Size = UDim2.new(.5, -5, 1, 0), Position = UDim2.new(.5, 5, 0, 0), Radius = 9, TextSize = 13})

	local OpenBtn = new("TextButton", {
		Name = "PingoOpen", Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(150, 44),
		Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 30, Parent = gui,
	}, {corner(12)})
	grad({"AccentDark", "Accent2Dark"}, OpenBtn, {Rotation = 20})
	local obStroke = new("UIStroke", {Thickness = 1.5, Transparency = .15, Parent = OpenBtn})
	bind(obStroke, "Color", "Accent")
	local obScale = new("UIScale", {Parent = OpenBtn})
	local obIcon = new("Frame", {Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = .82, BorderSizePixel = 0, ZIndex = 31, Parent = OpenBtn}, {corner(9)})
	local obIconPop = new("UIScale", {Parent = obIcon})
	local obImg = icon(config.Icon)
	if obImg then
		new("ImageLabel", {Image = obImg, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.new(1, -6, 1, -6), BackgroundTransparency = 1, ZIndex = 32, Parent = obIcon})
	else
		text({Text = string.upper(string.sub(title, 1, 1)), Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), ZIndex = 32, Parent = obIcon}, "White")
	end
	local obLbl = text({Text = tostring(config.ButtonText or title), Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -54, 1, 0), ZIndex = 31, Parent = OpenBtn}, "White")
	fit(obLbl, 15, 9)

	OpenBtn.MouseEnter:Connect(function() tw(obScale, .25, {Scale = 1.05}, BACK) end)
	OpenBtn.MouseLeave:Connect(function() tw(obScale, .25, {Scale = 1}, BACK) end)

	do
		local dragging, moved, startM, startP = false, false, nil, nil
		OpenBtn.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging, moved = true, false
				startM, startP = input.Position, OpenBtn.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						if dragging and not moved then
							tw(obScale, .1, {Scale = .92})
							tw(obScale, .35, {Scale = 1}, BACK)
							win:Toggle()
						end
						dragging = false
					end
				end)
			end
		end)
		connect(UIS.InputChanged, function(input)
			if dragging and isMove(input) then
				local d = input.Position - startM
				if d.Magnitude > 6 then moved = true end
				if moved then
					OpenBtn.Position = UDim2.new(startP.X.Scale, startP.X.Offset + d.X, startP.Y.Scale, startP.Y.Offset + d.Y)
				end
			end
		end)
	end

	-- ---------- SIDE TABS ----------
	local customCount = 0

	local function layoutTabs(side)
		local n = #side.Tabs
		if n == 0 then return end
		for i, t in ipairs(side.Tabs) do
			t.Button.Position = UDim2.new((i - 1) / n, (i - 1) * GAP / n, 0, 0)
			t.Button.Size = UDim2.new(1 / n, -GAP * (n - 1) / n, 1, 0)
		end
		if side.ActiveTab then
			side.Indicator.Position = side.ActiveTab.Button.Position
			side.Indicator.Size = side.ActiveTab.Button.Size
		end
	end

	local function showTab(tab, dir)
		local g = tab.Group
		tab.Token = (tab.Token or 0) + 1
		g.Visible = true
		g.Position = UDim2.fromOffset(dir * 40, 0)
		g.GroupTransparency = 1
		tw(g, .38, {Position = UDim2.new(), GroupTransparency = 0}, QUINT)
		if not win.ReduceMotion then
			local i = 0
			for _, c in ipairs(tab.Page:GetChildren()) do
				local body = c:FindFirstChild("Body")
				if body and c:IsA("GuiObject") then
					i = i + 1
					if i <= 16 then
						body.Position = UDim2.new(.5, 0, .5, 16)
						task.delay((i - 1) * .03, function()
							if body.Parent then tw(body, .4, {Position = UDim2.fromScale(.5, .5)}, QUINT) end
						end)
					end
				end
			end
		end
	end

	local function hideTab(tab, dir)
		local g = tab.Group
		if not g.Visible then return end
		tab.Token = (tab.Token or 0) + 1
		local my = tab.Token
		tw(g, .18, {GroupTransparency = 1, Position = UDim2.fromOffset(-dir * 30, 0)}, QUAD, IN)
		task.delay(.2, function()
			if tab.Token == my then g.Visible = false end
		end)
	end

	local function indexOf(list, v)
		for i, x in ipairs(list) do if x == v then return i end end
		return 1
	end

	local selectTab
	selectTab = function(tab)
		if win.Search ~= "" then searchBox.Text = "" end
		local side = tab.Side
		local prev = side.ActiveTab
		if prev == tab and tab.Group.Visible then return end
		side.ActiveTab = tab
		win.ActiveTab = tab
		local dir = 1
		if prev and prev ~= tab then
			dir = (indexOf(side.Tabs, tab) >= indexOf(side.Tabs, prev)) and 1 or -1
			hideTab(prev, dir)
		end
		tw(side.Indicator, .4, {Position = tab.Button.Position, Size = tab.Button.Size}, QUINT)
		for _, t in ipairs(side.Tabs) do
			bind(t.Button, "TextColor3", (t == tab) and "Accent" or "SubText", true)
		end
		showTab(tab, dir)
	end

	local function createTab(side, name, opts)
		opts = opts or {}
		local tab = {Name = name, Side = side, Recs = {}, System = opts.System == true}
		tab.CardSize = opts.CardSize or (opts.List and UDim2.new(1, 0, 0, CELL_H) or UDim2.new(.5, -5, 0, CELL_H))

		local btn = new("TextButton", {
			Name = name, Text = name, Font = Enum.Font.GothamMedium, TextSize = 13,
			AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
			ZIndex = 2, Parent = side.Bar,
		})
		bind(btn, "TextColor3", "SubText")
		tab.Button = btn

		local group = new("CanvasGroup", {
			Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			BorderSizePixel = 0, GroupTransparency = 1, Visible = false, Parent = PagesHolder,
		})
		local page = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, Parent = group,
		})
		bind(page, "ScrollBarImageColor3", "SubText")
		new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), Parent = page})
		if opts.List then
			new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
		else
			new("UIGridLayout", {CellSize = opts.CellSize or UDim2.new(.5, -5, 0, CELL_H), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
		end
		tab.Group, tab.Page = group, page

		table.insert(side.Tabs, tab)
		layoutTabs(side)
		btn.MouseButton1Click:Connect(function() selectTab(tab) end)
		return tab
	end

	local function newCard(tab, name)
		win.Counter = win.Counter + 1
		local outer = new("Frame", {Name = tostring(name), Size = tab.CardSize, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = win.Counter})
		local body = new("Frame", {Name = "Body", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = outer}, {corner(10)})
		bind(body, "BackgroundColor3", "Card")
		local st = new("UIStroke", {Thickness = 1, Transparency = .35, Parent = body})
		bind(st, "Color", "Stroke")
		new("UIScale", {Name = "Pop", Parent = body})
		return outer, body
	end

	local function pop(body)
		local sc = body:FindFirstChild("Pop")
		if not sc then return end
		tw(sc, .08, {Scale = .97})
		task.delay(.08, function() tw(sc, .3, {Scale = 1}, BACK) end)
	end

	local function hover(body, src)
		local stroke = body:FindFirstChildOfClass("UIStroke")
		src.MouseEnter:Connect(function()
			if stroke then tw(stroke, .2, {Color = T("Accent"), Transparency = .1}) end
		end)
		src.MouseLeave:Connect(function()
			if stroke then tw(stroke, .25, {Color = T("Stroke"), Transparency = .35}) end
		end)
	end

	local function hitFill(body)
		local hit = new("TextButton", {Name = "Hit", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2, Parent = body})
		hit.MouseButton1Down:Connect(function() pop(body) end)
		return hit
	end

	local function header(body, o, rp, desc, noIcon)
		local x = 14
		local ico = (not noIcon) and icon(o.Icon)
		if ico then
			new("ImageLabel", {Name = "Icon", AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 0), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Image = ico, ZIndex = 3, Parent = body})
			x = 42
		end
		local hasDesc = desc ~= nil and desc ~= ""
		local nameLbl = text({
			Text = tostring(o.Name), Font = Enum.Font.GothamBold, TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, x, 0, hasDesc and 12 or 27),
			Size = UDim2.new(1, -(x + rp), 0, 20), ZIndex = 2, Parent = body,
		}, "Text")
		fit(nameLbl, 14, 9)
		local descLbl
		if hasDesc then
			descLbl = text({
				Text = tostring(desc), Font = Enum.Font.Gotham, TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				Position = UDim2.new(0, x, 0, 32), Size = UDim2.new(1, -(x + rp), 0, 14), ZIndex = 2, Parent = body,
			}, "SubText")
		end
		return nameLbl, descLbl
	end

	-- ---------- ELEMENT REGISTRY + INFO PANEL ----------
	local openInfo = nil

	local function refreshAll() end

	local flipPage
	flipPage = function(page, fn)
		local before = {}
		for _, c in ipairs(page:GetChildren()) do
			local b = c:FindFirstChild("Body")
			if b and c:IsA("GuiObject") then before[b] = b.AbsolutePosition end
		end
		fn()
		RunService.RenderStepped:Wait()
		for b, oldPos in pairs(before) do
			if b.Parent and b.Parent.Parent == page then
				local d = oldPos - b.AbsolutePosition
				if d.Magnitude > 0.5 then
					b.Position = UDim2.new(.5, d.X, .5, d.Y)
					tw(b, .4, {Position = UDim2.fromScale(.5, .5)}, QUINT)
				end
			end
		end
	end

	local setFav, createFloat, removeFloat

	setFav = function(rec, on)
		rec.Fav = on and true or false
		flipPage(rec.Tab.Page, function()
			if rec.Fav then
				win.FavCounter = win.FavCounter + 1
				rec.FavOrder = win.FavCounter
				rec.Outer.LayoutOrder = -100000 + rec.FavOrder
			else
				rec.Outer.LayoutOrder = rec.BaseOrder
			end
		end)
		rec.Star.Visible = rec.Fav
		if rec.Fav then
			rec.Star.Size = UDim2.fromOffset(4, 4)
			tw(rec.Star, .35, {Size = UDim2.fromOffset(14, 14)}, BACK)
		end
	end

	createFloat = function(rec)
		if rec.Float then return end
		if rec.Kind ~= "button" and rec.Kind ~= "toggle" then return end
		local size = rec.Body.AbsoluteSize
		win.FloatCounter = win.FloatCounter + 1
		local k = win.FloatCounter % 6
		local f = new("TextButton", {
			Name = "Float", AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.new(.5, k * 18, .3, k * 22),
			Size = UDim2.fromOffset(math.max(size.X, 170), math.max(size.Y, 44)),
			Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 40, Parent = gui,
		}, {corner(10)})
		bind(f, "BackgroundColor3", "Card")
		local fs = new("UIStroke", {Thickness = 1.5, Transparency = .2, Parent = f})
		bind(fs, "Color", "Accent")
		local ico = icon(rec.Icon)
		local tx = 14
		if ico then
			new("ImageLabel", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, Image = ico, ZIndex = 41, Parent = f})
			tx = 40
		end
		local nm = text({Text = rec.Name, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -tx - 34, 1, 0), ZIndex = 41, Parent = f}, "White")
		local dot
		if rec.Kind == "toggle" then
			dot = new("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(10, 10), BorderSizePixel = 0, ZIndex = 41, Parent = f}, {corner(5)})
			dot.BackgroundColor3 = rec.Obj:Get() and Color3.new(1, 1, 1) or Color3.fromRGB(110, 115, 130)
			if rec.Obj.Listeners then
				table.insert(rec.Obj.Listeners, function(state)
					tw(dot, .25, {BackgroundColor3 = state and Color3.new(1, 1, 1) or Color3.fromRGB(110, 115, 130)})
				end)
			end
		end
		local grabbing, moved, startIn, startPos = false, false, nil, nil
		f.InputBegan:Connect(function(input)
			if isPress(input) then
				grabbing, moved = true, false
				startIn, startPos = input.Position, f.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						if grabbing and not moved then
							if rec.Kind == "toggle" then rec.Obj:Set(not rec.Obj:Get(), true)
							else rec.Obj.Fire() end
						end
						grabbing = false
					end
				end)
			end
		end)
		connect(UIS.InputChanged, function(input)
			if grabbing and isMove(input) then
				local d = input.Position - startIn
				if d.Magnitude > 5 then moved = true end
				if moved and not win.Locked then
					f.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
				end
			end
		end)
		tw(f, .3, {Size = UDim2.fromOffset(math.max(size.X, 170), math.max(size.Y, 44))}, BACK)
		rec.Float = f
		win.Floats[rec.Id] = f
	end

	removeFloat = function(rec)
		if not rec.Float then return end
		local f = rec.Float
		rec.Float = nil
		win.Floats[rec.Id] = nil
		tw(f, .2, {Size = UDim2.fromOffset(0, 0)}, QUAD, IN)
		task.delay(.22, function() f:Destroy() end)
	end

	local function attachInfo(rec, body)
		local ii = icon(Icons.Info)
		local infoBtn = new("TextButton", {
			Name = "InfoBtn", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 4),
			Size = UDim2.fromOffset(20, 20), Text = ii and "" or "i", Font = Enum.Font.GothamBold,
			TextSize = 12, AutoButtonColor = false, BackgroundTransparency = 1, ZIndex = 8, Parent = body,
		})
		bind(infoBtn, "TextColor3", "SubText")
		if ii then
			local img = new("ImageLabel", {Image = ii, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 9, Parent = infoBtn})
			bind(img, "ImageColor3", "SubText")
		end

		local rows = {}
		if rec.Link then
			table.insert(rows, {Text = "Copy Link", Icon = Icons.Link, Fn = function()
				if copyText(rec.Link) then win:Notify("Copied", "Link copied to clipboard.", 2) end
			end})
		end
		local favLbl, floatLbl
		table.insert(rows, {Text = "Favourite", Icon = Icons.Star, Fn = function() setFav(rec, not rec.Fav) end, Ref = "fav"})
		if rec.Kind == "button" or rec.Kind == "toggle" then
			table.insert(rows, {Text = "Float", Icon = Icons.Float, Fn = function()
				if rec.Float then removeFloat(rec) else createFloat(rec) end
			end, Ref = "float"})
		end

		local open = false
		local panel = new("Frame", {
			Name = "InfoPanel", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 30),
			Size = UDim2.fromOffset(160, 0), ClipsDescendants = true, BorderSizePixel = 0,
			Visible = false, ZIndex = 20, Parent = body,
		}, {corner(9)})
		bind(panel, "BackgroundColor3", "Sidebar")
		local ps = new("UIStroke", {Thickness = 1, Parent = panel})
		bind(ps, "Color", "Accent")
		new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel})
		new("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = panel})

		local function refreshLabels()
			if favLbl then favLbl.Text = rec.Fav and "Unfavourite" or "Favourite" end
			if floatLbl then floatLbl.Text = rec.Float and "Unfloat" or "Float" end
		end

		local height = #rows * 32 + 10
		for i, r in ipairs(rows) do
			local b, lbl = pill(panel, {Text = r.Text, Icon = r.Icon}, {Size = UDim2.new(1, 0, 0, 28), Radius = 7, TextSize = 12, LayoutOrder = i})
			b.ZIndex = 21
			if r.Ref == "fav" then favLbl = lbl end
			if r.Ref == "float" then floatLbl = lbl end
			b.MouseButton1Click:Connect(function()
				sfx("Click")
				r.Fn()
				refreshLabels()
			end)
		end

		local function closePanel()
			if not open then return end
			open = false
			if openInfo and openInfo.panel == panel then openInfo = nil end
			tw(panel, .2, {Size = UDim2.fromOffset(160, 0)}, QUAD, IN)
			task.delay(.2, function() if not open then panel.Visible = false end end)
		end

		local function openPanel()
			if openInfo and openInfo.close then openInfo.close() end
			open = true
			openInfo = {close = closePanel, panel = panel, btn = infoBtn}
			refreshLabels()
			panel.Visible = true
			tw(panel, .3, {Size = UDim2.fromOffset(160, height)}, QUINT)
		end

		infoBtn.MouseButton1Click:Connect(function()
			sfx("Click")
			if open then closePanel() else openPanel() end
		end)
	end

	local function register(tab, outer, body, o, kind, obj)
		local rec = {
			Name = tostring(o.Name), Kind = kind, Tab = tab, Outer = outer, Body = body,
			Obj = obj, Fav = false, Link = o.Link, Icon = o.Icon, Desc = o.Description or "",
			BaseOrder = outer.LayoutOrder,
		}
		rec.Id = tab.Side.Name .. "/" .. tab.Name .. "/" .. rec.Name
		local base, n = rec.Id, 1
		while win.Registry[rec.Id] do
			n = n + 1
			rec.Id = base .. "#" .. n
		end
		rec.Search = string.lower(rec.Name .. " " .. rec.Desc)

		local starIco = icon(Icons.Star)
		if starIco then
			rec.Star = new("ImageLabel", {Image = starIco, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 8), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Visible = false, ZIndex = 7, Parent = body})
			bind(rec.Star, "ImageColor3", "Accent")
		else
			rec.Star = text({Text = "★", Font = Enum.Font.GothamBold, TextSize = 14, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 6), Size = UDim2.fromOffset(16, 16), Visible = false, ZIndex = 7, Parent = body}, "Accent")
		end

		win.Registry[rec.Id] = rec
		table.insert(tab.Recs, rec)
		if o.Searchable ~= false and not tab.System then
			table.insert(win.Elements, rec)
		end
		if not tab.System then attachInfo(rec, body) end
		if obj then obj.Rec = rec end
		return rec
	end

	-- ---------- ELEMENT BUILDERS ----------
	local function buildElementsOn(tab)
		local ok = true
		return ok
	end

	local function addTabMethods(tab)
		function tab:AddButton(name, callback, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local outer, body = newCard(tab, o.Name)
			header(body, o, 50, o.Description)
			local hit = hitFill(body)
			hover(body, hit)
			local obj = {}
			function obj.Fire()
				sfx("Click")
				if o.Callback then task.spawn(o.Callback) end
			end
			hit.MouseButton1Click:Connect(obj.Fire)
			register(tab, outer, body, o, "button", obj)
			return obj
		end

		function tab:AddToggle(name, default, callback, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local state = default == true
			local outer, body = newCard(tab, o.Name)
			local nameLbl = header(body, o, 66, o.Description)
			if o.Format then nameLbl.Text = o.Format(state, o.Name) end
			local sw = new("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0, Parent = body}, {corner(11)})
			bind(sw, "BackgroundColor3", state and "Accent" or "Off")
			local knob = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = state and UDim2.new(1, -19, .5, 0) or UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0, Parent = sw}, {corner(8)})
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
			local hit = hitFill(body)
			hover(body, hit)
			local obj = {Listeners = {}}
			local function apply(v, fire)
				state = v
				bind(sw, "BackgroundColor3", state and "Accent" or "Off", true)
				tw(knob, .3, {Position = state and UDim2.new(1, -19, .5, 0) or UDim2.new(0, 3, .5, 0)}, BACK)
				if o.Format then nameLbl.Text = o.Format(state, o.Name) end
				sfx(state and "ToggleOn" or "ToggleOff")
				for _, f in ipairs(obj.Listeners) do pcall(f, state) end
				if fire and o.Callback then task.spawn(o.Callback, state) end
			end
			function obj:Set(v, fire)
				v = v == true
				if fire == nil then fire = true end
				if v ~= state then apply(v, fire) end
			end
			function obj:Get() return state end
			function obj:Reset() obj:Set(default == true, true) end
			function obj:SetText(t) nameLbl.Text = tostring(t) end
			hit.MouseButton1Click:Connect(function() apply(not state, true) end)
			register(tab, outer, body, o, "toggle", obj)
			return obj
		end

		function tab:AddSlider(name, mn, mx, default, callback, increment, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local min, max = mn or 0, mx or 100
			local inc = increment or o.Increment or 1
			local suffix = o.Suffix or ""
			local dec = 0
			local frac = tostring(inc):match("%.(%d+)")
			if frac then dec = #frac end
			local function snap(v)
				v = math.clamp(math.floor((v - min) / inc + .5) * inc + min, min, max)
				return tonumber(string.format("%." .. dec .. "f", v))
			end

			local outer, body = newCard(tab, o.Name)
			local hasDesc = o.Description ~= nil and o.Description ~= ""
			header(body, o, 60, o.Description, true)

			local lx = o.Icon and 40 or 14
			local rx = o.IconRight and 40 or 14

			local valLbl = text({
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10),
				Size = UDim2.fromOffset(60, 18), Text = "", Font = Enum.Font.GothamBold,
				TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = body,
			}, "Accent")

			if icon(o.Icon) then
				local li = new("ImageLabel", {Image = icon(o.Icon), AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, 0, 51), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Parent = body})
				bind(li, "ImageColor3", "Accent")
			end
			if icon(o.IconRight) then
				local ri = new("ImageLabel", {Image = icon(o.IconRight), AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, 0, 51), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Parent = body})
				bind(ri, "ImageColor3", "Accent")
			end

			local track = new("Frame", {Position = UDim2.new(0, lx, 0, 48), Size = UDim2.new(1, -(lx + rx), 0, 6), BorderSizePixel = 0, Parent = body}, {corner(3)})
			bind(track, "BackgroundColor3", "Off")
			local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track}, {corner(3)})
			grad({"Accent", "Accent2"}, fill)

			local knob = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(0, .5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3, Parent = track}, {corner(7)})
			local thumbIco = icon(o.ThumbIcon)
			if thumbIco then
				knob.Size = UDim2.fromOffset(20, 20)
				new("ImageLabel", {Image = thumbIco, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 4, Parent = knob}, {corner(10)})
			end

			local hit = new("TextButton", {Position = UDim2.new(0, lx - 6, 0, 36), Size = UDim2.new(1, -(lx + rx) + 12, 0, 30), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = body})

			local obj = {Listeners = {}}
			local value
			local function render(p, instant)
				if instant then
					fill.Size = UDim2.fromScale(p, 1)
					knob.Position = UDim2.fromScale(p, .5)
				else
					tw(fill, .12, {Size = UDim2.fromScale(p, 1)})
					tw(knob, .12, {Position = UDim2.fromScale(p, .5)})
				end
			end
			local function apply(v, fire, instant)
				v = snap(v)
				local pct = (max - min) == 0 and 0 or (v - min) / (max - min)
				valLbl.Text = tostring(v) .. suffix
				render(pct, instant)
				if v ~= value then
					value = v
					for _, f in ipairs(obj.Listeners) do pcall(f, v) end
					if fire then
						sfx("Tick")
						if o.Callback then task.spawn(o.Callback, v) end
					end
				end
			end

			local dragging = false
			local function fromX(x)
				local a, s = track.AbsolutePosition.X, track.AbsoluteSize.X
				local p = math.clamp((x - a) / math.max(s, 1), 0, 1)
				apply(min + (max - min) * p, true, false)
			end
			hit.InputBegan:Connect(function(input)
				if isPress(input) then
					dragging = true
					tab.Page.ScrollingEnabled = false
					fromX(input.Position.X)
				end
			end)
			connect(UIS.InputChanged, function(input)
				if dragging and isMove(input) then fromX(input.Position.X) end
			end)
			connect(UIS.InputEnded, function(input)
				if dragging and isPress(input) then
					dragging = false
					tab.Page.ScrollingEnabled = true
				end
			end)

			apply(default or min, false, true)
			function obj:Set(v, fire)
				if fire == nil then fire = true end
				apply(v, fire, false)
			end
			function obj:Get() return value end
			function obj:Reset() apply(default or min, true, false) end

			hover(body, body)
			register(tab, outer, body, o, "slider", obj)
			return obj
		end

		function tab:AddStepper(name, mn, mx, default, step, callback, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local min, max = mn or 0, mx or 100
			local st = step or 1
			local fmt = o.Format or tostring
			local value = math.clamp(default or min, min, max)

			local outer, body = newCard(tab, o.Name)
			header(body, o, 14, o.Description)

			local row = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -8), Size = UDim2.new(1, -24, 0, 30), BackgroundTransparency = 1, Parent = body})
			local valLbl = text({
				AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
				Size = UDim2.new(.4, 0, 1, 0), Text = fmt(value), Font = Enum.Font.GothamBold,
				TextSize = 14, ClipsDescendants = true, Parent = row,
			}, "Text")

			local function setValue(v, dir, fire)
				v = math.clamp(v, min, max)
				if v == value then return end
				value = v
				valLbl.Text = fmt(v)
				valLbl.Position = UDim2.new(.5, 0, .5, dir * 8)
				valLbl.TextTransparency = .5
				tw(valLbl, .12, {Position = UDim2.fromScale(.5, .5), TextTransparency = 0}, QUAD, OUT)
				sfx("Stepper")
				if fire and o.Callback then task.spawn(o.Callback, v) end
			end

			local function mkBtn(side, ico, glyph)
				local b = pill(row, {Text = ico and "" or glyph, Icon = ico}, {
					Size = UDim2.fromOffset(46, 30),
					AnchorPoint = Vector2.new(side < 0 and 0 or 1, 0),
					Position = side < 0 and UDim2.new(0, 0, 0, 0) or UDim2.new(1, 0, 0, 0),
					Radius = 8,
				})
				return b
			end

			local minusBtn = mkBtn(-1, Icons.Minus, "−")
			local plusBtn = mkBtn(1, Icons.Plus, "+")

			local function hold(btn, dir)
				local token
				btn.MouseButton1Down:Connect(function()
					token = {}
					local mine = token
					setValue(value + dir * st, dir, true)
					task.spawn(function()
						task.wait(.35)
						while token == mine do
							setValue(value + dir * st, dir, true)
							task.wait(.07)
						end
					end)
				end)
				btn.MouseButton1Up:Connect(function() token = nil end)
				btn.MouseLeave:Connect(function() token = nil end)
			end
			hold(minusBtn, -1)
			hold(plusBtn, 1)

			local obj = {}
			function obj:Set(v, fire)
				if fire == nil then fire = true end
				local dir = (v >= value) and 1 or -1
				setValue(v, dir, fire)
			end
			function obj:Get() return value end
			function obj:Reset() obj:Set(default or min, true) end
			hover(body, body)
			register(tab, outer, body, o, "stepper", obj)
			return obj
		end

		function tab:AddTextbox(name, placeholder, callback, default, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local outer, body = newCard(tab, o.Name)
			header(body, o, 14, o.Description)
			local box = new("Frame", {Position = UDim2.new(0, 14, 1, -36), Size = UDim2.new(1, -28, 0, 28), BorderSizePixel = 0, Parent = body}, {corner(7)})
			bind(box, "BackgroundColor3", "Sidebar")
			local bs = new("UIStroke", {Thickness = 1, Parent = box})
			bind(bs, "Color", "Stroke")
			local input = text({
				Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
				Text = tostring(default or ""), PlaceholderText = tostring(placeholder or "Type..."),
				Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false, Parent = box,
			}, "Text")
			bind(input, "PlaceholderColor3", "SubText")
			input.Focused:Connect(function()
				bind(bs, "Color", "Accent", true)
			end)
			input.FocusLost:Connect(function(enter)
				bind(bs, "Color", "Stroke", true)
				if o.Callback then task.spawn(o.Callback, input.Text, enter) end
			end)
			local obj = {}
			function obj:Set(t, fire)
				input.Text = tostring(t)
				if fire and o.Callback then task.spawn(o.Callback, input.Text, false) end
			end
			function obj:Get() return input.Text end
			function obj:Reset() obj:Set(default or "", true) end
			hover(body, body)
			register(tab, outer, body, o, "textbox", obj)
			return obj
		end

		function tab:AddLabel(name, value, shimmerOn, extra)
			local o = makeOpts(name, extra)
			local outer, body = newCard(tab, o.Name)
			header(body, o, 14, o.Description)
			local v = text({
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -8),
				Size = UDim2.new(1, -28, 0, 18), Text = tostring(value or ""),
				Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, Parent = body,
			}, shimmerOn and "White" or "SubText")
			if shimmerOn then shimmer(grad({"Accent", "Accent2", "Accent"}, v, {Offset = Vector2.new(-.6, 0)}), 2.4) end
			local obj = {}
			function obj:Set(t) v.Text = tostring(t) end
			function obj:Get() return v.Text end
			register(tab, outer, body, o, "label", obj)
			return obj
		end

		function tab:AddPopup(name, cfg, extra)
			local o = makeOpts(name, extra)
			local outer, body = newCard(tab, o.Name)
			header(body, o, 46, o.Description)
			text({AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(16, 20), Text = "›", Font = Enum.Font.GothamBold, TextSize = 22, Parent = body}, "SubText")
			local hit = hitFill(body)
			hover(body, hit)
			local obj = {}
			function obj.Show()
				local c = {}
				for k, v in pairs(cfg or {}) do c[k] = v end
				c.Title = c.Title or o.Name
				return win:Popup(c)
			end
			hit.MouseButton1Click:Connect(function()
				sfx("Click")
				obj.Show()
			end)
			register(tab, outer, body, o, "popup", obj)
			return obj
		end

		function tab:AddDropdown(name, options, default, callback, extra)
			local o = makeOpts(name, extra)
			o.Callback = callback
			local dd = {
				Name = tostring(name), Options = options or {},
				Max = (o.Max == nil) and 1 or o.Max,
				Placeholder = o.Placeholder or "Select...",
				Swatches = o.Swatches, Callback = callback, Selected = {},
			}
			if dd.Max <= 0 then dd.Max = math.huge end
			local function load(v)
				dd.Selected = {}
				if type(v) == "string" then
					dd.Selected = {v}
				elseif type(v) == "table" then
					for _, x in ipairs(v) do
						if #dd.Selected < dd.Max then table.insert(dd.Selected, x) end
					end
				end
			end
			load(default)
			local default0 = {}
			for _, v in ipairs(dd.Selected) do table.insert(default0, v) end

			local outer, body = newCard(tab, o.Name)
			header(body, o, 14, o.Description)
			local box = new("Frame", {Position = UDim2.new(0, 14, 1, -36), Size = UDim2.new(1, -28, 0, 28), BorderSizePixel = 0, Parent = body}, {corner(7)})
			bind(box, "BackgroundColor3", "Sidebar")
			local bst = new("UIStroke", {Thickness = 1, Parent = box})
			bind(bst, "Color", "Stroke")
			local valLbl = text({Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = box}, "Text")
			text({AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(14, 16), Text = "▾", Font = Enum.Font.GothamBold, TextSize = 13, Parent = box}, "SubText")

			local function refresh()
				local n = #dd.Selected
				if n == 0 then
					valLbl.Text = dd.Placeholder
					bind(valLbl, "TextColor3", "SubText")
				else
					bind(valLbl, "TextColor3", "Text")
					valLbl.Text = (n == 1) and tostring(dd.Selected[1]) or (n .. " selected")
				end
			end
			refresh()

			local function fire()
				if dd.Callback then
					if dd.Max == 1 then
						task.spawn(dd.Callback, dd.Selected[1])
					else
						local copy = {}
						for _, v in ipairs(dd.Selected) do table.insert(copy, v) end
						task.spawn(dd.Callback, copy)
					end
				end
			end
			dd.Refresh = refresh
			dd.Fire = fire

			local hit = hitFill(body)
			hover(body, hit)
			hit.MouseButton1Click:Connect(function()
				sfx("Click")
				if dd.OpenPanel then dd.OpenPanel() end
			end)

			local obj = {}
			function obj:Set(v, fireCb)
				load(v)
				refresh()
				if fireCb then fire() end
			end
			function obj:Get()
				if dd.Max == 1 then return dd.Selected[1] end
				local copy = {}
				for _, x in ipairs(dd.Selected) do table.insert(copy, x) end
				return copy
			end
			function obj:GetList()
				local copy = {}
				for _, x in ipairs(dd.Selected) do table.insert(copy, x) end
				return copy
			end
			function obj:SetOptions(list) dd.Options = list or {} end
			function obj:Reset() obj:Set(default0, true) end
			dd.Obj = obj
			o.Dropdown = dd
			register(tab, outer, body, o, "dropdown", obj)
			return obj
		end
	end

	-- ---------- DROPDOWN PANEL ----------
	local activeDD
	local function openDropdown(dd)
		if activeDD then activeDD.close(true) end
		local PW = 236
		local multi = dd.Max ~= 1
		local footerH = multi and 52 or 10

		local overlay = new("TextButton", {Name = "DDOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 55, Parent = Main})
		local panel = new("CanvasGroup", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, PW + 20, 0, 12), Size = UDim2.new(0, PW, 1, -24), BorderSizePixel = 0, ZIndex = 56, Parent = overlay}, {corner(12)})
		bind(panel, "BackgroundColor3", "Sidebar")
		local pst = new("UIStroke", {Thickness = 1.5, Parent = panel})
		bind(pst, "Color", "Accent")

		text({Text = dd.Name, Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 22), ZIndex = 57, Parent = panel}, "White")

		local counter = text({AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.fromOffset(70, 22), Text = "", Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 57, Parent = panel}, "Accent")
		local function updateCounter()
			if multi then
				counter.Text = (dd.Max == math.huge) and (#dd.Selected .. " selected") or (#dd.Selected .. "/" .. dd.Max)
			end
		end

		local sbox = new("Frame", {Position = UDim2.fromOffset(12, 42), Size = UDim2.new(1, -24, 0, 32), BorderSizePixel = 0, ZIndex = 57, Parent = panel}, {corner(8)})
		bind(sbox, "BackgroundColor3", "Card")
		local sbs = new("UIStroke", {Thickness = 1, Parent = sbox})
		bind(sbs, "Color", "Stroke")
		local search = text({Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = "", PlaceholderText = "Search options...", Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 58, Parent = sbox}, "Text")
		bind(search, "PlaceholderColor3", "SubText")
		search.Focused:Connect(function() bind(sbs, "Color", "Accent", true) end)
		search.FocusLost:Connect(function() bind(sbs, "Color", "Stroke", true) end)

		local list = new("ScrollingFrame", {Position = UDim2.fromOffset(8, 84), Size = UDim2.new(1, -16, 1, -(84 + footerH)), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 57, Parent = panel})
		new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list})
		new("UIPadding", {PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingBottom = UDim.new(0, 6), Parent = list})
		bind(list, "ScrollBarImageColor3", "SubText")

		local rows = {}
		local function refreshRows()
			for _, r in ipairs(rows) do
				local sel = table.find(dd.Selected, r.opt) ~= nil
				r.bar.Visible = sel
				bind(r.lbl, "TextColor3", sel and "Accent" or "Text", true)
			end
			updateCounter()
			dd.Refresh()
		end

		local function pick(opt)
			if not multi then
				dd.Selected = {opt}
				dd.Refresh()
				dd.Fire()
				refreshRows()
				task.delay(.12, function() close() end)
				return
			end
			local idx = table.find(dd.Selected, opt)
			if idx then
				table.remove(dd.Selected, idx)
			else
				if #dd.Selected >= dd.Max then
					win:Notify("Limit reached", "You can select up to " .. dd.Max .. " options.", 2.5)
					return
				end
				table.insert(dd.Selected, opt)
			end
			dd.Refresh()
			dd.Fire()
			refreshRows()
		end

		local function buildRows(filter)
			for _, r in ipairs(rows) do r.outer:Destroy() end
			rows = {}
			filter = string.lower(filter or "")
			for i, opt in ipairs(dd.Options) do
				if filter == "" or string.find(string.lower(tostring(opt)), filter, 1, true) then
					local outer = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 57, Parent = list})
					local btn = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 58, Parent = outer}, {corner(9)})
					local bar = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(3, 18), BorderSizePixel = 0, Visible = false, ZIndex = 59, Parent = btn}, {corner(2)})
					bind(bar, "BackgroundColor3", "Accent")
					local tx = 14
					local sw = dd.Swatches and dd.Swatches[opt]
					if sw then
						new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 14, .5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 59, Parent = btn}, {
							corner(8),
							new("UIGradient", {Rotation = 35, Color = ColorSequence.new(sw[1], sw[2])}),
						})
						tx = 40
					end
					local lbl = text({Text = tostring(opt), Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -tx - 10, 1, 0), ZIndex = 59, Parent = btn}, "Text")
					table.insert(rows, {opt = opt, outer = outer, bar = bar, lbl = lbl})
					btn.MouseEnter:Connect(function() tw(btn, .15, {BackgroundTransparency = .92}) end)
					btn.MouseLeave:Connect(function() tw(btn, .2, {BackgroundTransparency = 1}) end)
					btn.MouseButton1Click:Connect(function()
						sfx("Click")
						pick(opt)
					end)
				end
			end
			refreshRows()
		end

		local footerY = -(footerH - 8)
		if multi then
			local clearB = pill(panel, {Text = "Clear"}, {Size = UDim2.new(.4, -14, 0, 34), Position = UDim2.new(0, 12, 1, -44), Radius = 9, TextSize = 13})
			local doneB = pill(panel, {Text = "Done", Style = "Primary"}, {Size = UDim2.new(.6, -20, 0, 34), Position = UDim2.new(.4, 6, 1, -44), Radius = 9, TextSize = 13})
			clearB.ZIndex = 58
			doneB.ZIndex = 58
			clearB.MouseButton1Click:Connect(function()
				dd.Selected = {}
				dd.Refresh()
				dd.Fire()
				refreshRows()
			end)
			doneB.MouseButton1Click:Connect(function() close() end)
		end

		local closed = false
		close = function(instant)
			if closed then return end
			closed = true
			if activeDD and activeDD.overlay == overlay then activeDD = nil end
			if instant then overlay:Destroy() return end
			tw(overlay, .25, {BackgroundTransparency = 1})
			tw(panel, .35, {Position = UDim2.new(1, PW + 20, 0, 12)}, QUINT, IN)
			task.delay(.4, function() overlay:Destroy() end)
		end
		activeDD = {close = close, overlay = overlay}
		overlay.MouseButton1Click:Connect(function() close() end)

		search:GetPropertyChangedSignal("Text"):Connect(function() buildRows(search.Text) end)
		buildRows("")

		tw(overlay, .3, {BackgroundTransparency = .5})
		tw(panel, .55, {Position = UDim2.new(1, -12, 0, 12)}, QUINT)
	end

	-- ---------- POPUP ----------
	local activePopup
	function win:Popup(cfg)
		cfg = cfg or {}
		if activePopup then activePopup.Close(true) end
		local PW = 340
		local inner = PW - 36
		local buttons = cfg.Buttons
		if not buttons or #buttons == 0 then buttons = {{Text = "OK", Style = "Primary"}} end
		local textStr = tostring(cfg.Text or "")
		local th = 0
		if textStr ~= "" then
			th = TextService:GetTextSize(textStr, 13, Enum.Font.Gotham, Vector2.new(inner, 600)).Y
		end
		local textEnd = 46 + th
		local inputY
		local btnY
		if cfg.Input then
			inputY = textEnd + 12
			btnY = inputY + 36 + 14
		else
			btnY = textEnd + 16
		end
		local nb = #buttons
		local cols = math.min(nb, 3)
		local rows = math.ceil(nb / cols)
		local BH, BG = 34, 8
		local btnH = rows * BH + (rows - 1) * BG
		local PH = btnY + btnH + 16

		local overlay = new("TextButton", {Name = "PopupOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 60, Parent = Main})
		local dlg = new("CanvasGroup", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(.5, 0, .5, 24), Size = UDim2.fromOffset(PW, PH), BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 61, Parent = overlay}, {corner(14)})
		bind(dlg, "BackgroundColor3", "Sidebar")
		local dscale = new("UIScale", {Scale = .92, Parent = dlg})
		local dst = new("UIStroke", {Thickness = 1.5, Transparency = .35, Parent = dlg})
		bind(dst, "Color", "Accent")
		local topBar = new("Frame", {Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, ZIndex = 62, Parent = dlg})
		topBar.BackgroundColor3 = Color3.new(1, 1, 1)
		grad({"Accent", "Accent2"}, topBar)

		local titleLbl = text({Text = tostring(cfg.Title or ""), Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -36, 0, 24), ZIndex = 62, Parent = dlg}, "White")
		fit(titleLbl, 16, 11)
		if textStr ~= "" then
			text({Text = textStr, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Position = UDim2.fromOffset(18, 46), Size = UDim2.fromOffset(inner, th), ZIndex = 62, Parent = dlg}, "SubText")
		end

		local inputBox
		if cfg.Input then
			local ib = new("Frame", {Position = UDim2.fromOffset(18, inputY), Size = UDim2.fromOffset(inner, 36), BorderSizePixel = 0, ZIndex = 62, Parent = dlg}, {corner(9)})
			bind(ib, "BackgroundColor3", "Card")
			local ibs = new("UIStroke", {Thickness = 1, Parent = ib})
			bind(ibs, "Color", "Stroke")
			inputBox = text({Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Text = tostring(cfg.Input.Default or ""), PlaceholderText = tostring(cfg.Input.Placeholder or "Type here..."), Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 63, Parent = ib}, "Text")
			bind(inputBox, "PlaceholderColor3", "SubText")
			inputBox.Focused:Connect(function() bind(ibs, "Color", "Accent", true) end)
			inputBox.FocusLost:Connect(function() bind(ibs, "Color", "Stroke", true) end)
		end

		local handle = {}
		local closed = false
		local function close(instant)
			if closed then return end
			closed = true
			if activePopup == handle then activePopup = nil end
			if instant then overlay:Destroy() return end
			tw(overlay, .22, {BackgroundTransparency = 1})
			tw(dlg, .2, {GroupTransparency = 1, Position = UDim2.new(.5, 0, .5, 12)}, QUAD, IN)
			tw(dscale, .2, {Scale = .94}, QUAD, IN)
			task.delay(.26, function() overlay:Destroy() end)
		end
		handle.Close = close
		activePopup = handle

		local grid = new("Frame", {Position = UDim2.fromOffset(18, btnY), Size = UDim2.fromOffset(inner, btnH), BackgroundTransparency = 1, ZIndex = 62, Parent = dlg})
		new("UIGridLayout", {CellSize = UDim2.new(1 / cols, -(BG * (cols - 1)) / cols, 0, BH), CellPadding = UDim2.fromOffset(BG, BG), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid})
		for i, spec in ipairs(buttons) do
			local pb = pill(grid, spec, {Radius = 9, TextSize = 13, LayoutOrder = i})
			pb.ZIndex = 63
			pb.MouseButton1Click:Connect(function()
				sfx("Click")
				local txt = inputBox and inputBox.Text or nil
				if spec.RequireInput and (txt or ""):gsub("%s", "") == "" then
					dlg.Position = UDim2.new(.5, 8, .5, 0)
					tw(dlg, .35, {Position = UDim2.fromScale(.5, .5)}, BACK)
					return
				end
				if spec.Callback then task.spawn(spec.Callback, txt) end
				if spec.Keep ~= true then close() end
			end)
		end

		if cfg.Dismissable ~= false then
			overlay.MouseButton1Click:Connect(function() close() end)
		end
		tw(overlay, .25, {BackgroundTransparency = .45})
		tw(dlg, .5, {Position = UDim2.fromScale(.5, .5)}, QUINT)
		tw(dlg, .3, {GroupTransparency = 0})
		tw(dscale, .5, {Scale = 1}, BACK)
		if inputBox then
			task.delay(.35, function() if inputBox.Parent then inputBox:CaptureFocus() end end)
		end
		return handle
	end

	-- ---------- NOTIFICATIONS ----------
	local NotifHolder = new("Frame", {
		Name = "Notifications", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.new(0, 300, 1, -28), BackgroundTransparency = 1, ZIndex = 80, Parent = gui,
	})
	new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = NotifHolder})
	local notifCounter = 0

	function win:Notify(nTitle, nText, duration, extra)
		local o = {}
		if type(nTitle) == "table" then
			o = nTitle
			nTitle, nText, duration = o.Title, o.Text, o.Duration
		elseif type(extra) == "table" then
			o = extra
		end
		if not win.NotifyOn and not o.Force then return {Dismiss = function() end} end
		local buttons = o.Buttons or {}
		local nb = #buttons
		if duration == nil then duration = nb > 0 and 8 or 4 end
		notifCounter = notifCounter + 1

		local NW = 300
		local h = 66 + (nb > 0 and 38 or 0)
		local wrap = new("Frame", {Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, LayoutOrder = notifCounter, ClipsDescendants = false, Parent = NotifHolder})
		local card = new("CanvasGroup", {Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(NW + 40, 0), BorderSizePixel = 0, GroupTransparency = 1, Parent = wrap}, {corner(12)})
		bind(card, "BackgroundColor3", "Sidebar")
		local cs = new("UIStroke", {Thickness = 1, Parent = card})
		bind(cs, "Color", "Stroke")
		local accentBar = new("Frame", {Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, Parent = card})
		accentBar.BackgroundColor3 = Color3.new(1, 1, 1)
		grad({"Accent", "Accent2"}, accentBar, {Rotation = 90})

		local ico = icon(o.Icon)
		if ico then
			new("ImageLabel", {Image = ico, Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(34, 34), BackgroundTransparency = 1, Parent = card})
		end
		local tx = ico and 58 or 14
		local tl = text({Text = tostring(nTitle or ""), Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(tx, 12), Size = UDim2.new(1, -tx - 14, 0, 18), Parent = card}, "Text")
		fit(tl, 14, 10)
		text({Text = tostring(nText or ""), Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(tx, 32), Size = UDim2.new(1, -tx - 14, 0, 28), Parent = card}, "SubText")

		local dead = false
		local dismiss
		dismiss = function()
			if dead then return end
			dead = true
			tw(card, .3, {Position = UDim2.fromOffset(NW + 40, 0), GroupTransparency = 1}, QUAD, IN)
			task.delay(.32, function() wrap:Destroy() end)
		end

		local clickArea = new("TextButton", {Size = UDim2.new(1, 0, 0, 62), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2, Parent = card})
		clickArea.MouseButton1Click:Connect(dismiss)

		if nb > 0 then
			local bar = new("Frame", {Position = UDim2.new(0, 12, 1, -34), Size = UDim2.new(1, -24, 0, 28), BackgroundTransparency = 1, Parent = card})
			new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar})
			for i, spec in ipairs(buttons) do
				local pb = pill(bar, {Text = spec.Text, Icon = spec.Icon, Style = spec.Style or "Default"}, {Size = UDim2.new(1 / nb, -6, 1, 0), Radius = 7, TextSize = 11, LayoutOrder = i})
				pb.MouseButton1Click:Connect(function()
					if spec.Callback then task.spawn(spec.Callback) end
					if spec.Keep ~= true then dismiss() end
				end)
			end
		end

		local progress = new("Frame", {Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0, Parent = card})
		progress.BackgroundColor3 = Color3.new(1, 1, 1)
		grad({"Accent", "Accent2"}, progress)
		if duration > 0 then
			tw(progress, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
			task.delay(duration, dismiss)
		end

		sfx("Notify")
		tw(card, .45, {Position = UDim2.fromOffset(0, 0)}, QUINT)
		tw(card, .3, {GroupTransparency = 0})
		return {Dismiss = dismiss}
	end

	-- ---------- SIDE TAB CREATION ----------
	local function createSide(name, iconId, sysSlot)
		local side = {Name = name, Tabs = {}, System = sysSlot ~= nil}
		if sysSlot then
			side.Y = H - 12 - (4 - sysSlot) * 42
		else
			customCount = customCount + 1
			side.Y = NAV_Y + (customCount - 1) * 42
		end

		local btn = new("TextButton", {
			Name = name, Position = UDim2.new(0, 10, 0, side.Y), Size = UDim2.new(1, -20, 0, 38),
			Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = Sidebar,
		})
		side.Button = btn

		local pad = 14
		local ico = icon(iconId)
		if ico then
			pad = 42
			side.Icon = new("ImageLabel", {Image = ico, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 13, .5, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 3, Parent = btn})
			bind(side.Icon, "ImageColor3", "SubText")
		end
		side.Pad = pad
		side.Label = text({
			Text = name, Font = Enum.Font.GothamMedium, TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(pad, 0), Size = UDim2.new(1, -pad - 8, 1, 0), ZIndex = 3, Parent = btn,
		}, "SubText")
		fit(side.Label, 14, 9)

		side.Bar = new("Frame", {Name = name .. "_Bar", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = TabBarHolder})
		local barBg = new("Frame", {Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = side.Bar}, {corner(8)})
		bind(barBg, "BackgroundColor3", "Sidebar")
		local barSt = new("UIStroke", {Thickness = 1, Parent = barBg})
		bind(barSt, "Color", "Stroke")
		side.Indicator = new("Frame", {Name = "Indicator", Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 1, Parent = side.Bar}, {corner(7)})
		grad({"AccentDark", "Accent2Dark"}, side.Indicator)

		btn.MouseEnter:Connect(function()
			if win.ActiveSide ~= side and side.Label then tw(side.Label, .25, {Position = UDim2.fromOffset(pad + 3, 0)}, QUAD) end
		end)
		btn.MouseLeave:Connect(function()
			if win.ActiveSide ~= side and side.Label then tw(side.Label, .25, {Position = UDim2.fromOffset(pad, 0)}, QUAD) end
		end)

		table.insert(win.SideTabs, side)
		return side
	end

	local selectSide
	selectSide = function(side)
		if win.Search ~= "" then searchBox.Text = "" end
		if win.ActiveSide == side then return end
		local prev = win.ActiveSide
		if prev then
			if prev.ActiveTab then hideTab(prev.ActiveTab, 1) end
			prev.Bar.Visible = false
			if prev.Label then
				bind(prev.Label, "TextColor3", "SubText", true)
				tw(prev.Label, .25, {Position = UDim2.fromOffset(prev.Pad, 0)}, QUAD)
			end
			if prev.Icon then bind(prev.Icon, "ImageColor3", "SubText", true) end
		end
		win.ActiveSide = side
		NavPill.Visible = true
		tw(NavPill, .4, {Position = UDim2.new(0, 10, 0, side.Y)}, QUINT)
		bind(side.Label, "TextColor3", "White", true)
		tw(side.Label, .3, {Position = UDim2.fromOffset(side.Pad + 4, 0)}, QUINT)
		if side.Icon then
			bind(side.Icon, "ImageColor3", "White", true)
			side.Icon.Rotation = -20
			tw(side.Icon, .5, {Rotation = 0}, BACK)
		end
		side.Bar.Visible = true
		local t = side.ActiveTab or side.Tabs[1]
		if t then
			side.ActiveTab = nil
			selectTab(t)
		end
	end

	-- Search
	local function performSearch(q)
		q = string.lower(q or "")
		q = q:gsub("^%s+", ""):gsub("%s+$", "")
		win.Search = q
		if q == "" then
			for _, rec in ipairs(win.Elements) do
				if rec.Outer.Parent == Results then rec.Outer.Parent = rec.Tab.Page end
			end
			Results.Visible = false
			TabBarHolder.Visible = true
			if win.ActiveTab then
				local g = win.ActiveTab.Group
				g.Visible = true
				g.Position = UDim2.new()
				g.GroupTransparency = 0
			end
			return
		end
		TabBarHolder.Visible = false
		for _, side in ipairs(win.SideTabs) do
			for _, t in ipairs(side.Tabs) do t.Group.Visible = false end
		end
		Results.Visible = true
		for _, rec in ipairs(win.Elements) do
			local match = string.find(rec.Search, q, 1, true) ~= nil
			if match then
				if rec.Outer.Parent ~= Results then rec.Outer.Parent = Results end
			else
				if rec.Outer.Parent == Results then rec.Outer.Parent = rec.Tab.Page end
			end
		end
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() performSearch(searchBox.Text) end)

	-- ---------- TOGGLE ----------
	local transToken = 0
	local function playOpenStagger()
		for i, side in ipairs(win.SideTabs) do
			side.Button.Position = UDim2.new(0, -40, 0, side.Y)
			task.delay(.1 + i * .035, function()
				tw(side.Button, .4, {Position = UDim2.new(0, 10, 0, side.Y)}, QUINT)
			end)
		end
	end

	function win:Toggle(state)
		if state == nil then state = not win.Opened end
		if state == win.Opened then return end
		win.Opened = state
		transToken = transToken + 1
		local my = transToken

		if state then
			sfx("Open")
			Holder.Visible = true
			Holder.GroupTransparency = 1
			Holder.Position = UDim2.new(.5, 0, .5, 70)
			tw(Holder, .42, {GroupTransparency = 0, Position = UDim2.fromScale(.5, .5)}, QUINT)

			Sidebar.Position = UDim2.new(0, -SIDE_W - 20, 0, 0)
			task.delay(.08, function()
				if transToken == my then tw(Sidebar, .42, {Position = UDim2.new()}, QUINT) end
			end)
			playOpenStagger()

			Bar.Position = UDim2.new(.5, 0, 1, 40)
			task.delay(.14, function()
				if transToken == my then tw(Bar, .4, {Position = UDim2.new(.5, 0, 1, 12)}, QUINT) end
			end)

			if win.ActiveTab and not win.Search or win.ActiveTab then
				local t = win.ActiveTab
				if t then
					t.Group.Visible = true
					t.Group.GroupTransparency = 0
				end
			end
		else
			sfx("Close")
			for _, side in ipairs(win.SideTabs) do
				if side.Button then tw(side.Button, .12, {Position = UDim2.new(0, -40, 0, side.Y)}, QUAD, IN) end
			end
			tw(Sidebar, .18, {Position = UDim2.new(0, -SIDE_W - 20, 0, 0)}, QUAD, IN)
			tw(Bar, .15, {Position = UDim2.new(.5, 0, 1, 40)}, QUAD, IN)
			task.delay(.1, function()
				if transToken == my then
					tw(Holder, .22, {GroupTransparency = 1, Position = UDim2.new(.5, 0, .5, 60)}, QUAD, IN)
				end
			end)
			task.delay(.34, function()
				if transToken == my then Holder.Visible = false end
			end)
			if openInfo and openInfo.close then openInfo.close() end
		end
	end

	-- Hide / Unload buttons
	hideBtn.MouseButton1Click:Connect(function() win:Toggle(false) end)
	unloadBtn.MouseButton1Click:Connect(function()
		if config.ConfirmUnload == false then
			win:Unload()
			return
		end
		win:Popup({
			Title = "Unload " .. title .. "?",
			Text = "This removes the menu and stops its features until the script runs again.",
			Buttons = {
				{Text = "Cancel"},
				{Text = "Unload", Style = "Primary", Callback = function() win:Unload() end},
			},
		})
	end)

	connect(UIS.InputBegan, function(input, gp)
		if gp then return end
		if input.KeyCode == (config.Key or Enum.KeyCode.RightShift) then win:Toggle() end
		if openInfo and isPress(input) then
			if not pointIn(input.Position, openInfo.panel) and not pointIn(input.Position, openInfo.btn) then
				openInfo.close()
			end
		end
	end)

	-- ---------- PUBLIC SIDE TAB API ----------
	function win:CreateSideTab(name, iconId)
		local side = createSide(name, iconId, nil)
		if not win.ActiveSide then selectSide(side) end
		function side:CreateTab(tabName, opts)
			local tab = createTab(side, tabName, opts)
			addTabMethods(tab)
			if not win.ActiveTab and win.ActiveSide == side then selectTab(tab) end
			return tab
		end
		return side
	end

	-- ---------- PERSISTENCE ----------
	local dirPath = ROOT_FOLDER .. "/" .. sanitize(title) .. "/configs"
	local autoPath = ROOT_FOLDER .. "/" .. sanitize(title) .. "/autoload.txt"
	local hasFS = writefile ~= nil and readfile ~= nil and isfile ~= nil and isfolder ~= nil and makefolder ~= nil and listfiles ~= nil and delfile ~= nil
	local memStore, memAuto = {}, nil

	local function ensureDir()
		if not hasFS then return end
		pcall(function()
			for _, p in ipairs({ROOT_FOLDER, ROOT_FOLDER .. "/" .. sanitize(title), dirPath}) do
				if not isfolder(p) then makefolder(p) end
			end
		end)
	end

	local function listProfiles()
		local out = {}
		if hasFS then
			ensureDir()
			local ok, files = pcall(listfiles, dirPath)
			if ok and type(files) == "table" then
				for _, f in ipairs(files) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n then table.insert(out, n) end
				end
			end
		else
			for n in pairs(memStore) do table.insert(out, n) end
		end
		table.sort(out, function(a, b) return a:lower() < b:lower() end)
		return out
	end

	local function profileExists(n)
		if hasFS then
			local ok, r = pcall(isfile, dirPath .. "/" .. n .. ".json")
			return ok and r == true
		end
		return memStore[n] ~= nil
	end

	local function writeProfile(n, data)
		if hasFS then
			ensureDir()
			return (pcall(writefile, dirPath .. "/" .. n .. ".json", data))
		end
		memStore[n] = data
		return true
	end

	local function readProfile(n)
		local raw
		if hasFS then
			local ok, r = pcall(readfile, dirPath .. "/" .. n .. ".json")
			if ok then raw = r end
		else
			raw = memStore[n]
		end
		if not raw then return nil end
		local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if ok and type(data) == "table" then return data end
		return nil
	end

	local function deleteProfile(n)
		if hasFS then pcall(delfile, dirPath .. "/" .. n .. ".json") else memStore[n] = nil end
	end

	local function getAuto()
		if hasFS then
			local ok, r = pcall(function()
				if isfile(autoPath) then return readfile(autoPath) end
			end)
			if ok and type(r) == "string" and r ~= "" then return r end
			return nil
		end
		return memAuto
	end

	local function setAuto(n)
		if hasFS then
			pcall(function()
				ensureDir()
				if n then
					writefile(autoPath, n)
				elseif isfile(autoPath) then
					delfile(autoPath)
				end
			end)
		else
			memAuto = n
		end
	end

	local STATEFUL = {toggle = true, slider = true, stepper = true, textbox = true, dropdown = true}

	local function collectState()
		local s = {
			v = 1, theme = currentTheme, saved = os.time(),
			menu = {size = win.SizeMul, opacity = win.Opacity, volume = win.Volume, locked = win.Locked, notify = win.NotifyOn, reduce = win.ReduceMotion},
			elements = {},
		}
		for id, rec in pairs(win.Registry) do
			if not rec.Tab.System then
				local d = {}
				if STATEFUL[rec.Kind] and rec.Obj then
					d.value = rec.Obj:Get()
				end
				if rec.Fav then d.fav = true; d.order = rec.FavOrder end
				if rec.Float then
					d.float = {
						x = rec.Float.Position.X.Scale, y = rec.Float.Position.Y.Scale,
						ox = rec.Float.Position.X.Offset, oy = rec.Float.Position.Y.Offset,
					}
				end
				if next(d) ~= nil then s.elements[id] = d end
			end
		end
		return s
	end

	local function applyState(st)
		if type(st) ~= "table" then return false end
		if st.theme and THEMES[st.theme] then PingoUI.SetTheme(st.theme) end
		local m = st.menu or {}
		if m.size and win.SetSizeFromConfig then win.SetSizeFromConfig(m.size) end
		if m.opacity and win.SetOpacityFromConfig then win.SetOpacityFromConfig(m.opacity) end
		if m.volume and win.SetVolumeFromConfig then win.SetVolumeFromConfig(m.volume) end
		if m.locked ~= nil and win.LockToggle then win.LockToggle:Set(m.locked == true, true) end
		if m.notify ~= nil and win.NotifyToggle then win.NotifyToggle:Set(m.notify == true, false) end
		if m.reduce ~= nil and win.MotionToggle then win.MotionToggle:Set(m.reduce == true, false) end

		local els = st.elements or {}
		for id, rec in pairs(win.Registry) do
			if not rec.Tab.System then
				local d = els[id] or {}
				if d.fav then
					if d.order and d.order > win.FavCounter then win.FavCounter = d.order end
					rec.FavOrder = d.order or rec.FavOrder
					setFav(rec, true)
				elseif rec.Fav then
					setFav(rec, false)
				end
				if STATEFUL[rec.Kind] and d.value ~= nil and rec.Obj then
					pcall(function() rec.Obj:Set(d.value, true) end)
				end
				if d.float then
					if not rec.Float then createFloat(rec) end
					if rec.Float then
						rec.Float.Position = UDim2.new(d.float.x or .5, d.float.ox or 0, d.float.y or .3, d.float.oy or 0)
					end
				elseif rec.Float then
					removeFloat(rec)
				end
			end
		end
		return true
	end

	function win:ListConfigs() return listProfiles() end
	function win:SaveConfig(name)
		name = sanitize(name)
		if name == "" then return false end
		return writeProfile(name, HttpService:JSONEncode(collectState()))
	end
	function win:LoadConfig(name)
		local data = readProfile(sanitize(name))
		if not data then return false end
		return applyState(data)
	end
	function win:LoadAutoConfig()
		local n = getAuto()
		if n and profileExists(n) then
			if win:LoadConfig(n) then
				win:Notify("Auto-Load", "Loaded \"" .. n .. "\".", 3)
				return true
			end
		end
		return false
	end

	-- ---------- SYSTEM SIDE TABS ----------
	local ThemesST = createSide("Themes", Icons.Themes, 1)
	local ConfigST = createSide("Config", Icons.Config, 2)
	local SettingsST = createSide("Settings", Icons.Settings, 3)

	-- ----- THEMES: Gallery -----
	local Gallery = createTab(ThemesST, "Gallery", {System = true, CardSize = UDim2.new(.25, -8, 0, 96), CellSize = UDim2.new(.25, -8, 0, 96)})
	local ringList = {}
	for _, info in ipairs(THEME_LIST) do
		local tname = info[1]
		local outer, body = newCard(Gallery, tname)
		outer.Size = UDim2.new(.25, -8, 0, 96)
		new("Frame", {Name = "Swatch", Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -34), BorderSizePixel = 0, Parent = body}, {
			corner(7),
			new("UIGradient", {Rotation = 25, Color = ColorSequence.new(info[2], info[3])}),
		})
		text({Text = tname, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.new(0, 10, 1, -24), Size = UDim2.new(1, -20, 0, 18), Parent = body}, "Text")
		local ring = new("Frame", {Name = "Ring", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body}, {corner(10)})
		local rs = new("UIStroke", {Thickness = 2, Color = info[2], Transparency = (tname == currentTheme) and 0 or 1, Parent = ring})
		ringList[tname] = rs
		local hit = hitFill(body)
		hover(body, hit)
		hit.MouseButton1Click:Connect(function()
			sfx("Click")
			PingoUI.SetTheme(tname)
		end)
	end

	-- ----- THEMES: Select -----
	local SelectTab = createTab(ThemesST, "Select", {System = true, List = true})
	local names, swatches = {}, {}
	for _, info in ipairs(THEME_LIST) do
		table.insert(names, info[1])
		swatches[info[1]] = {info[2], info[3]}
	end
	local themeDD = SelectTab:AddDropdown("Theme", names, currentTheme, function(v)
		if v and v ~= currentTheme then PingoUI.SetTheme(v) end
	end, {Description = "Search and pick a theme", Swatches = swatches, Placeholder = "Choose theme"})
	SelectTab:AddButton("Random Theme", function()
		PingoUI.SetTheme(names[math.random(1, #names)])
	end, {Description = "Surprise me"})

	-- ----- THEMES: Custom -----
	local CustomTab = createTab(ThemesST, "Custom", {System = true, List = true})
	do
		local outer, body = newCard(CustomTab, "Custom")
		outer.Size = UDim2.new(1, 0, 0, 84)
		local tile = new("Frame", {Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(64, 64), BorderSizePixel = 0, Parent = body}, {corner(12)})
		tile.BackgroundColor3 = Color3.new(1, 1, 1)
		local customIco = icon(Icons.Custom)
		if customIco then
			new("ImageLabel", {Image = customIco, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(38, 38), BackgroundTransparency = 1, Parent = tile})
		else
			text({Text = "C", Font = Enum.Font.GothamBold, TextSize = 26, TextColor3 = Color3.fromRGB(30, 30, 30), Size = UDim2.fromScale(1, 1), Parent = tile}, "Text")
		end
		text({Text = "Custom", Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(94, 22), Size = UDim2.new(1, -110, 0, 22), Parent = body}, "Text")
		text({Text = "Pick your own color below", Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(94, 46), Size = UDim2.new(1, -110, 0, 16), Parent = body}, "SubText")
		local hit = hitFill(body)
		hover(body, hit)
		hit.MouseButton1Click:Connect(function()
			sfx("Click")
			if THEMES.Custom then PingoUI.SetTheme("Custom") end
		end)
	end
	do
		local outer, body = newCard(CustomTab, "Picker")
		outer.Size = UDim2.new(1, 0, 0, 200)
		local hsv = {h = .6, s = .7, v = 1}
		local svFrame = new("Frame", {Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(200, 150), BorderSizePixel = 0, Parent = body}, {corner(8)})
		svFrame.BackgroundColor3 = Color3.new(1, 0, 0)
		local whiteL = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = svFrame}, {corner(8)})
		new("UIGradient", {Transparency = NumberSequence.new(0, 1), Parent = whiteL})
		local blackL = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(), BorderSizePixel = 0, Parent = svFrame}, {corner(8)})
		new("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = blackL})
		local svCursor = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ZIndex = 4, Parent = svFrame}, {corner(6)})
		new("UIStroke", {Thickness = 2, Color = Color3.new(1, 1, 1), Parent = svCursor})

		local hueFrame = new("Frame", {Position = UDim2.fromOffset(226, 14), Size = UDim2.fromOffset(18, 150), BorderSizePixel = 0, Parent = body}, {corner(6)})
		local hueKeys = {}
		for i = 0, 6 do hueKeys[#hueKeys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)) end
		new("UIGradient", {Rotation = 90, Color = ColorSequence.new(hueKeys), Parent = hueFrame})
		local hueCursor = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(.5, 0, .6, 0), Size = UDim2.new(1, 8, 0, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 4, Parent = hueFrame}, {corner(3)})

		local preview = new("Frame", {Position = UDim2.fromOffset(256, 14), Size = UDim2.fromOffset(64, 64), BorderSizePixel = 0, Parent = body}, {corner(10)})
		local hexLbl = text({Position = UDim2.fromOffset(256, 84), Size = UDim2.fromOffset(100, 18), Text = "", Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = body}, "SubText")

		local function currentColor() return Color3.fromHSV(hsv.h, hsv.s, hsv.v) end
		local function refreshPicker(apply)
			svFrame.BackgroundColor3 = Color3.fromHSV(hsv.h, 1, 1)
			svCursor.Position = UDim2.fromScale(hsv.s, 1 - hsv.v)
			hueCursor.Position = UDim2.fromScale(.5, hsv.h)
			local c = currentColor()
			preview.BackgroundColor3 = c
			hexLbl.Text = string.format("#%02X%02X%02X", c.R * 255, c.G * 255, c.B * 255)
			if apply then PingoUI.SetCustomColor(c) end
		end
		refreshPicker(false)

		local svDrag, hueDrag = false, false
		local function svFromPos(p)
			local a, s = svFrame.AbsolutePosition, svFrame.AbsoluteSize
			hsv.s = math.clamp((p.X - a.X) / math.max(s.X, 1), 0, 1)
			hsv.v = 1 - math.clamp((p.Y - a.Y) / math.max(s.Y, 1), 0, 1)
			refreshPicker(true)
		end
		local function hueFromPos(p)
			local a, s = hueFrame.AbsolutePosition, hueFrame.AbsoluteSize
			hsv.h = math.clamp((p.Y - a.Y) / math.max(s.Y, 1), 0, 1)
			refreshPicker(true)
		end
		svFrame.InputBegan:Connect(function(i) if isPress(i) then svDrag = true; svFromPos(i.Position) end end)
		hueFrame.InputBegan:Connect(function(i) if isPress(i) then hueDrag = true; hueFromPos(i.Position) end end)
		connect(UIS.InputChanged, function(i)
			if isMove(i) then
				if svDrag then svFromPos(i.Position) end
				if hueDrag then hueFromPos(i.Position) end
			end
		end)
		connect(UIS.InputEnded, function(i)
			if isPress(i) then svDrag = false; hueDrag = false end
		end)
	end

	-- ----- SETTINGS: General -----
	local General = createTab(SettingsST, "General", {System = true, List = true})
	win.SizeStepper = General:AddStepper("Menu Size", 60, 140, 100, 10, function(v)
		win.SizeMul = v / 100
		refit(true)
	end, {Format = function(v) return v .. "%" end, Description = "Scale the whole menu"})

	win.OpacySlider = General:AddSlider("Transparent Menu", 0, 100, 0, function(v)
		win.Opacity = v
		tw(Main, .25, {GroupTransparency = (v / 100) * .9})
	end, 1, {Suffix = "%", Description = "0 = solid, 100 = fully see-through", Icon = nil})

	win.VolumeSlider = General:AddSlider("Sounds Volume", 0, 100, 50, function(v)
		win.Volume = v
	end, 1, {Suffix = "%", Description = "Volume of menu sounds"})

	win.LockToggle = General:AddToggle("Lock Menu", false, function(s)
		win.Locked = s
		win:Notify("Lock Menu", s and "Menu is locked." or "Menu unlocked.", 2.5)
	end, {Description = "Disable dragging", Icon = Icons.Lock})

	win.NotifyToggle = General:AddToggle("Notifications", true, function(s)
		win.NotifyOn = s
	end, {Description = "Show pop-up notifications"})

	win.MotionToggle = General:AddToggle("Reduce Motion", false, function(s)
		win.ReduceMotion = s
	end, {Description = "Fewer entrance animations"})

	General:AddButton("Reset Menu Position", function()
		tw(Holder, .6, {Position = UDim2.fromScale(.5, .5)}, QUINT)
	end, {Description = "Move the menu back to center"})

	-- Apply hooks for config
	win.SetSizeFromConfig = function(v)
		win.SizeMul = v
		refit(true)
		win.SizeStepper:Set(math.floor(v * 100 + .5), false)
	end
	win.SetOpacityFromConfig = function(v)
		win.Opacity = v
		win.OpacySlider:Set(v, false)
		tw(Main, .25, {GroupTransparency = (v / 100) * .9})
	end
	win.SetVolumeFromConfig = function(v)
		win.Volume = v
		win.VolumeSlider:Set(v, false)
	end

	-- ----- SETTINGS: About -----
	local About = createTab(SettingsST, "About", {System = true, List = true})
	local function aboutRow(label, value)
		local outer, body = newCard(About, label)
		outer.Size = UDim2.new(1, 0, 0, 56)
		text({Text = label, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(.4, 0, 1, 0), Parent = body}, "SubText")
		local v = text({AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.new(.6, -14, 0, 20), Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = body}, "Text")
		fit(v, 14, 9)
	end
	aboutRow("Update", config.Update or "ThePerfect")
	aboutRow("Name", title)
	aboutRow("Version", version)
	aboutRow("Library", PingoUI.Name .. " " .. PingoUI.Version)

	-- ----- CONFIG: Profiles -----
	local Profiles = createTab(ConfigST, "Profiles", {System = true, List = true})
	do
		local page = Profiles.Page
		local top = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = 1, Parent = page})
		local nameWrap = new("Frame", {Size = UDim2.new(1, -262, 1, 0), BorderSizePixel = 0, Parent = top}, {corner(9)})
		bind(nameWrap, "BackgroundColor3", "Sidebar")
		local nws = new("UIStroke", {Thickness = 1, Parent = nameWrap})
		bind(nws, "Color", "Stroke")
		local nameBox = text({Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Text = "", PlaceholderText = "Config name...", Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = nameWrap}, "Text")
		bind(nameBox, "PlaceholderColor3", "SubText")
		nameBox.Focused:Connect(function() bind(nws, "Color", "Accent", true) end)
		nameBox.FocusLost:Connect(function() bind(nws, "Color", "Stroke", true) end)

		local createB = pill(top, {Text = "Create", Style = "Primary"}, {Size = UDim2.fromOffset(80, 38), Position = UDim2.new(1, -254, 0, 0), Radius = 9, TextSize = 12})
		local saveB = pill(top, {Text = "Save"}, {Size = UDim2.fromOffset(80, 38), Position = UDim2.new(1, -170, 0, 0), Radius = 9, TextSize = 12})
		local folderB = pill(top, {Text = "Folder"}, {Size = UDim2.fromOffset(80, 38), Position = UDim2.new(1, -86, 0, 0), Radius = 9, TextSize = 12})

		local hint = text({
			Text = hasFS and "Tap Load, Auto or Delete on a profile." or "No file access in this executor: profiles last for this session only.",
			Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 2, Parent = page,
		}, "SubText")

		local rowsHolder = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = page})
		new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rowsHolder})

		local emptyLbl = text({Text = "No saved profiles yet", Font = Enum.Font.GothamBold, TextSize = 14, Size = UDim2.new(1, 0, 0, 90), LayoutOrder = 4, Visible = false, Parent = page}, "SubText")

		local refresh
		local function buildRow(n, i, autoName)
			local data = readProfile(n)
			local meta = "Saved profile"
			if data then
				local cnt = 0
				for _ in pairs(data.elements or {}) do cnt = cnt + 1 end
				meta = (data.saved and os.date("%d %b %H:%M", data.saved) or "Saved") .. "  •  " .. cnt .. " settings"
			end
			local outer, body = newCard(Profiles, n)
			outer.Name = "ProfileRow"
			outer.Size = UDim2.new(1, 0, 0, 58)
			outer.LayoutOrder = i
			outer.Parent = rowsHolder
			text({Text = n, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -220, 0, 20), Parent = body}, "Text")
			text({Text = meta, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -220, 0, 16), Parent = body}, "SubText")

			local loadB = pill(body, {Text = "Load", Icon = Icons.Load}, {Size = UDim2.fromOffset(64, 30), Position = UDim2.new(1, -206, .5, -15), Radius = 7, TextSize = 11})
			local autoB = pill(body, {Text = autoName == n and "AUTO ✓" or "Auto", Style = autoName == n and "Primary" or "Default"}, {Size = UDim2.fromOffset(64, 30), Position = UDim2.new(1, -136, .5, -15), Radius = 7, TextSize = 11})
			local delB = pill(body, {Text = "Delete", Style = "Danger", Icon = Icons.Trash}, {Size = UDim2.fromOffset(64, 30), Position = UDim2.new(1, -66, .5, -15), Radius = 7, TextSize = 11})

			loadB.MouseButton1Click:Connect(function()
				if win:LoadConfig(n) then win:Notify("Config loaded", "\"" .. n .. "\" applied.", 3)
				else win:Notify("Load failed", "Could not read \"" .. n .. "\".", 3) end
			end)
			autoB.MouseButton1Click:Connect(function()
				if getAuto() == n then
					setAuto(nil)
					win:Notify("Auto-Load", "Auto-Load removed.", 2.5)
				else
					setAuto(n)
					win:Notify("Auto-Load", "\"" .. n .. "\" will load on start.", 3)
				end
				refresh()
			end)
			delB.MouseButton1Click:Connect(function()
				win:Popup({
					Title = "Delete profile?",
					Text = "\"" .. n .. "\" will be permanently removed.",
					Buttons = {
						{Text = "Cancel"},
						{Text = "Delete", Style = "Danger", Callback = function()
							deleteProfile(n)
							if getAuto() == n then setAuto(nil) end
							refresh()
							win:Notify("Deleted", "\"" .. n .. "\" removed.", 2.5)
						end},
					},
				})
			end)
		end

		refresh = function()
			for _, c in ipairs(rowsHolder:GetChildren()) do
				if c:IsA("Frame") then c:Destroy() end
			end
			local list = listProfiles()
			local autoName = getAuto()
			for i, n in ipairs(list) do buildRow(n, i, autoName) end
			emptyLbl.Visible = #list == 0
		end

		createB.MouseButton1Click:Connect(function()
			local n = sanitize(nameBox.Text)
			if n == "" then win:Notify("Create", "Type a config name first.", 2.5) return end
			if profileExists(n) then win:Notify("Create", "\"" .. n .. "\" already exists.", 3) return end
			if win:SaveConfig(n) then
				nameBox.Text = ""
				refresh()
				win:Notify("Profile created", "\"" .. n .. "\" saved.", 3)
			end
		end)
		saveB.MouseButton1Click:Connect(function()
			local n = sanitize(nameBox.Text)
			if n == "" then win:Notify("Save", "Type the name of the profile to overwrite.", 2.5) return end
			if win:SaveConfig(n) then
				nameBox.Text = ""
				refresh()
				win:Notify("Saved", "\"" .. n .. "\" updated.", 2.5)
			end
		end)
		folderB.MouseButton1Click:Connect(function()
			local path = hasFS and dirPath or "(memory only)"
			if copyText(path) then win:Notify("Folder", "Path copied.", 3) else win:Notify("Folder", path, 5) end
		end)
		refresh()
	end

	-- ---------- THEME HOOK ----------
	table.insert(themeHooks, function()
		for n, rs in pairs(ringList) do
			tw(rs, .25, {Transparency = (n == currentTheme) and 0 or 1})
		end
		if themeDD and themeDD.Get and themeDD:Get() ~= currentTheme then
			themeDD:Set(currentTheme, false)
		end
	end)

	-- ---------- CLEANUP ----------
	function win:SetTheme(name) PingoUI.SetTheme(name) end

	function win:Destroy()
		for _, c in ipairs(win.Conns) do pcall(function() c:Disconnect() end) end
		for _, f in pairs(win.Floats) do pcall(function() f:Destroy() end) end
		for obj in pairs(bound) do
			if obj:IsDescendantOf(gui) then bound[obj] = nil end
		end
		gui:Destroy()
	end

	local unloadHooks = {}
	function win:OnUnload(fn) table.insert(unloadHooks, fn) end

	function win:Unload()
		if win.Unloaded then return end
		win.Unloaded = true
		if win.Opened then win:Toggle(false) end
		task.delay(.4, function()
			for _, fn in ipairs(unloadHooks) do pcall(fn) end
			if config.OnUnload then pcall(config.OnUnload) end
			win:Destroy()
		end)
	end

	-- ---------- INIT ----------
	task.defer(function()
		if not config.StartHidden then win:Toggle(true) end
		task.delay(config.AutoLoadDelay or .6, function()
			if not win.Unloaded then win:LoadAutoConfig() end
		end)
	end)

	return win
end

return PingoUI
