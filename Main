--[[
    Pingo UI Library  |  v1.0.0
    ---------------------------------------------------------------
    local Window = Pingo.CreateWindow("Pingo Hub", "v1.0.0", {
        Theme = "Ruby",                    -- الثيم الابتدائي (يلوّن كل شيء)
        Update = "ThePerfect",
        Key = Enum.KeyCode.RightShift,
        Icon = "rbxassetid://...",         -- صورة زر التشغيل (يسار المستطيل)
        ButtonText = "Pingo",              -- اسم زر التشغيل (يمين المستطيل)
        UnloadText = "Unload Menu", UnloadIcon = "rbxassetid://...",
        HideText = "Hide Menu",     HideIcon = "rbxassetid://...",
        ConfirmUnload = true,              -- نافذة تأكيد قبل الـ Unload
        OnUnload = function() end,         -- يشتغل عند الـ Unload
        LockIcon = ..., SettingsIcon = ..., MinusIcon = 12338394619, PlusIcon = 12338396009,
    })

    local Side = Window:CreateSideTab("Visuals", "rbxassetid://...")
    local Tab  = Side:CreateTab("ESP")

    -- كل العناصر تقبل جدول أخير: {Icon = ..., Description = "...", Tint = false}
    Tab:AddButton("Name", function() end, {Icon = ..., Description = ...})
    Tab:AddToggle("Name", false, function(state) end, {...})
    Tab:AddSlider("Name", min, max, default, function(v) end, increment, {Suffix = "%"})
    Tab:AddTextbox("Name", "placeholder", function(text, enter) end, "default", {...})
    Tab:AddStepper("Name", min, max, default, step, function(v) end, {Format = function(v) return v end})
    Tab:AddLabel("Name", "Value", shimmer, {...})
    Tab:AddPopup("Name", {Title = "..", Text = "..", Icon = .., Buttons = {
        {Text = "Yes", Style = "Primary", Callback = function() end},   -- Primary / Danger / Default
        {Text = "No"}, {Text = "More", Keep = true},                    -- أي عدد أزرار
    }}, {Icon = .., Description = ..})

    Window:Popup({Title = "", Text = "", Icon = "", Buttons = {...}, Dismissable = true})
    Window:Notify("Title", "Text", 6, {Icon = "rbxassetid://...", Buttons = {
        {Text = "Open", Style = "Primary", Callback = function() end}, {Text = "Dismiss"}}})
    Window:Toggle() / Window:SetSizeMultiplier(1.2) / Window:SetLocked(true) / Window:Unload() / Window:Destroy()
]]

local Pingo = {Version = "1.0.0", Name = "Pingo", TintIcons = true}

local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Q = Enum.EasingStyle.Quint
local BACK = Enum.EasingStyle.Back
local GAP = 4
local CELL_H = 64

local ICON_MINUS = 12338394619
local ICON_PLUS = 12338396009
local ICON_SEARCH = "rbxassetid://6031154871"

-- ============================================================
--  HELPERS
-- ============================================================
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function tw(obj, t, props, style, dir)
	if not obj then return end
	local tween = TweenService:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function new(class, props, children)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end

local function icon(i)
	if not i then return nil end
	if type(i) == "number" then return "rbxassetid://" .. i end
	if tostring(i):match("^%d+$") then return "rbxassetid://" .. i end
	return tostring(i)
end

local function merge(o, extra)
	if type(extra) == "table" then
		for k, v in pairs(extra) do
			if o[k] == nil then o[k] = v end
		end
	end
	return o
end

