--[[
    Pingo UI Library | Ultimate Edition (v1.5.0)
    ---------------------------------------------------------------
    - Integrated Theme Engine (32 Themes)
    - Full Config System (Save / Load / Auto-Load)
    - Advanced Dropdown (Searchable, Multi & Max selections)
    - Floating Widgets (Drag & Drop mini controls)
    - Hold Element (0.8s) for Properties Menu (Favourite / Hide / Float)
]]

local Pingo = {Version = "1.5.0", Name = "Pingo", TintIcons = true}

-- Services
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")

-- Constants & Config
local HOLD_TIME = 0.8
local FOLDER = "PingoHub_Configs"
local AUTO_PATH = FOLDER .. "/autoload.txt"
local Q = Enum.EasingStyle.Quint
local BACK = Enum.EasingStyle.Back
local GAP = 4
local CELL_H = 64

-- Icons
local ICONS = {
    Minus = 12338394619,
    Plus = 12338396009,
    Search = "rbxassetid://6031154871",
    Themes = "rbxassetid://88003022051687",
    Config = "rbxassetid://137882818389597",
    Settings = "rbxassetid://9405931578",
    Star = "rbxassetid://5078542968",
}

-- ============================================================
-- HELPERS & FILE SYSTEM
-- ============================================================
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function tw(obj, t, props, style, dir)
    if not obj then return end
    local tween = TweenService:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function new(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    if parent then o.Parent = parent end
    return o
end

local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end

local function icon(i)
    if not i then return nil end
    if type(i) == "number" or tostring(i):match("^%d+$") then return "rbxassetid://" .. i end
    return tostring(i)
end

local function merge(o, extra)
    if type(extra) == "table" then
        for k, v in pairs(extra) do
            if o[k] == nil then o[k] = v end
        end
    end
    return o
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

local function sanitize(s)
    s = tostring(s or ""):gsub("[^%w_%- ]", "")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

-- File System Support with In-Memory Fallback
local FS_OK = writefile ~= nil and readfile ~= nil and isfile ~= nil and makefolder ~= nil and isfolder ~= nil and listfiles ~= nil and delfile ~= nil
local memFS = {}

local function cfgPath(name) return FOLDER .. "/" .. name .. ".json" end

local function fsWrite(path, data)
    if FS_OK then
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        writefile(path, data)
    else
        memFS[path] = data
    end
end

local function fsRead(path)
    if FS_OK then return isfile(path) and readfile(path) or nil end
    return memFS[path]
end

local function fsDelete(path)
    if FS_OK then if isfile(path) then delfile(path) end else memFS[path] = nil end
end

local function fsList()
    local out = {}
    if FS_OK then
        if isfolder(FOLDER) then
            for _, p in ipairs(listfiles(FOLDER)) do
                local n = p:match("([^/\\]+)%.json$")
                if n then table.insert(out, n) end
            end
        end
    else
        for k in pairs(memFS) do
            local n = k:match("^" .. FOLDER .. "/(.+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    return out
end

-- ============================================================
-- THEMES ENGINE (32 Themes)
-- ============================================================
local BASE = {
    Background = rgb(18, 19, 24), Sidebar = rgb(24, 25, 31), Card = rgb(32, 34, 42),
    Off = rgb(55, 58, 70), Text = rgb(240, 240, 245), SubText = rgb(140, 145, 160),
    White = rgb(255, 255, 255), Stroke = rgb(44, 46, 58),
}

local THEME_LIST = {
    {"Ruby", rgb(255, 59, 83), rgb(255, 110, 80)},
    {"Crimson", rgb(220, 40, 60), rgb(255, 70, 110)},
    {"Rose", rgb(255, 100, 140), rgb(255, 150, 170)},
    {"Magenta", rgb(255, 70, 180), rgb(255, 95, 110)},
    {"Coral", rgb(255, 110, 100), rgb(255, 160, 120)},
    {"Tangerine", rgb(255, 130, 37), rgb(255, 190, 60)},
    {"Amber", rgb(255, 176, 0), rgb(255, 215, 80)},
    {"Gold", rgb(255, 200, 40), rgb(255, 235, 120)},
    {"Lime", rgb(110, 255, 70), rgb(50, 230, 140)},
    {"Mint", rgb(120, 255, 190), rgb(90, 230, 230)},
    {"Emerald", rgb(46, 220, 130), rgb(30, 200, 200)},
    {"Teal", rgb(20, 200, 180), rgb(40, 150, 230)},
    {"Cyan", rgb(40, 230, 255), rgb(60, 150, 255)},
    {"Sky", rgb(120, 200, 255), rgb(170, 150, 255)},
    {"Azure", rgb(60, 130, 255), rgb(90, 210, 255)},
    {"Ocean", rgb(0, 190, 210), rgb(40, 110, 255)},
    {"Sapphire", rgb(40, 90, 255), rgb(100, 60, 230)},
    {"Violet", rgb(190, 80, 255), rgb(255, 90, 200)},
    {"Grape", rgb(160, 90, 255), rgb(225, 90, 255)},
    {"Neon", rgb(0, 235, 255), rgb(220, 70, 220)},
    {"Sunset", rgb(255, 115, 90), rgb(255, 160, 20)},
    {"Mono", rgb(200, 200, 205), rgb(120, 122, 130)},
}

local BLACK = Color3.new(0, 0, 0)
local THEMES = {}
for _, t in ipairs(THEME_LIST) do
    local d = {Accent = t[2], Accent2 = t[3], AccentDark = t[2]:Lerp(BLACK, 0.35), Accent2Dark = t[3]:Lerp(BLACK, 0.35)}
    for k, v in pairs(BASE) do d[k] = v end
    THEMES[t[1]] = d
end

local currentTheme = "Ruby"
local function T(key) return THEMES[currentTheme][key] end

local bindings = setmetatable({}, {__mode = "k"})
local gradients = setmetatable({}, {__mode = "k"})
local ringRefreshers = {}

local function bind(obj, prop, key, animate)
    local b = bindings[obj]
    if not b then b = {}; bindings[obj] = b end
    b[prop] = key
    if animate then tw(obj, 0.25, {[prop] = T(key)}) else obj[prop] = T(key) end
    return obj
end

local function unbindTree(root)
    bindings[root] = nil
    gradients[root] = nil
    for _, d in ipairs(root:GetDescendants()) do
        bindings[d] = nil
        gradients[d] = nil
    end
end

local function seq(keys)
    local pts, n = {}, #keys
    for i, k in ipairs(keys) do pts[i] = ColorSequenceKeypoint.new((i - 1) / (n - 1), T(k)) end
    return ColorSequence.new(pts)
end

local function grad(keys, parent, props)
    local g = new("UIGradient", props or {})
    g.Parent = parent
    gradients[g] = keys
    g.Color = seq(keys)
    return g
end

function Pingo.SetTheme(name)
    if not THEMES[name] then return end
    currentTheme = name
    for obj, b in pairs(bindings) do
        if obj.Parent then
            for prop, key in pairs(b) do
                local target = T(key)
                if obj[prop] ~= target then tw(obj, 0.35, {[prop] = target}) end
            end
        end
    end
    for g, keys in pairs(gradients) do if g.Parent then g.Color = seq(keys) end end
    for _, fn in pairs(ringRefreshers) do fn() end
end

local function mkText(class, props, key)
    props.BackgroundTransparency = props.BackgroundTransparency or 1
    props.BorderSizePixel = 0
    props.Font = props.Font or Enum.Font.GothamMedium
    local o = new(class, props)
    bind(o, "TextColor3", key or "Text")
    return o
end

local function candidates()
    local list = {}
    if gethui then pcall(function() table.insert(list, gethui()) end) end
    pcall(function() table.insert(list, game:GetService("CoreGui")) end)
    local lp = Players.LocalPlayer
    if lp then table.insert(list, lp:WaitForChild("PlayerGui")) end
    return list
end

local function header(body, o, rs, rp, regionH)
    regionH = regionH or CELL_H
    rs, rp = rs or 0, rp or 12
    local x = 14
    if o.Icon then
        local img = new("ImageLabel", {Name = "Icon", Image = icon(o.Icon), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0, regionH / 2), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, ZIndex = 2, Parent = body})
        if o.IconColor then img.ImageColor3 = o.IconColor
        elseif o.Tint ~= false and Pingo.TintIcons then bind(img, "ImageColor3", "Accent") end
        x = 46
    end
    local hasDesc = o.Description ~= nil and o.Description ~= ""
    local nameY = hasDesc and (regionH / 2 - 16) or 0
    local nameH = hasDesc and 16 or regionH
    local nameLbl = mkText("TextLabel", {
        Text = tostring(o.Name), Font = Enum.Font.GothamBold, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(x, nameY), Size = UDim2.new(1 - rs, -(x + rp), 0, nameH), Parent = body,
    })
    local descLbl
    if hasDesc then
        descLbl = mkText("TextLabel", {
            Text = tostring(o.Description), Font = Enum.Font.Gotham, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.fromOffset(x, nameY + 17), Size = UDim2.new(1 - rs, -(x + rp), 0, 14), Parent = body,
        }, "SubText")
    end
    return nameLbl, descLbl
end

local function pill(parent, spec, props)
    spec = spec or {}
    props = props or {}
    local style = spec.Style or "Default"
    local b = new("TextButton", {
        Name = "Pill", Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        BackgroundColor3 = Color3.new(1, 1, 1), Size = props.Size or UDim2.fromOffset(100, 32),
        Position = props.Position or UDim2.new(), Parent = parent,
    }, {corner(props.Radius or 8)})
    if style == "Primary" then grad({"Accent", "Accent2"}, b, {Rotation = 15})
    elseif style == "Danger" then new("UIGradient", {Rotation = 15, Color = ColorSequence.new(rgb(225, 45, 70), rgb(255, 80, 105)), Parent = b})
    else
        bind(b, "BackgroundColor3", "Off")
        local st = new("UIStroke", {Thickness = 1, Transparency = 0.3, Parent = b})
        bind(st, "Color", "Stroke")
    end
    local ico, textX = icon(spec.Icon), 0
    if ico then
        new("ImageLabel", {Image = ico, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Parent = b})
        textX = 14
    end
    local lbl = mkText("TextLabel", {Text = tostring(spec.Text or "Button"), Font = Enum.Font.GothamBold, TextSize = props.TextSize or 12, Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -textX, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = b}, style == "Default" and "Text" or "White")
    local sc = new("UIScale", {Parent = b})
    b.MouseEnter:Connect(function() tw(sc, 0.18, {Scale = 1.04}, BACK) end)
    b.MouseLeave:Connect(function() tw(sc, 0.2, {Scale = 1}) end)
    b.MouseButton1Down:Connect(function() tw(sc, 0.08, {Scale = 0.94}) end)
    b.MouseButton1Up:Connect(function() tw(sc, 0.25, {Scale = 1.04}, BACK) end)
    return b, lbl
end

-- ============================================================
-- WINDOW CREATION
-- ============================================================
function Pingo.CreateWindow(title, version, config)
    config = config or {}
    title = title or "Pingo"
    version = version or Pingo.Version
    local updateName = config.Update or "Ultimate"
    local W, H = config.Width or 660, config.Height or 420
    if config.Theme and THEMES[config.Theme] then currentTheme = config.Theme end

    local win = {
        SideTabs = {}, Elements = {}, Conns = {}, Counter = 0, Opened = false,
        SearchText = "", SizeMul = 1, Locked = false, Floats = {}, SelectedConfig = nil, CfgRows = {}
    }

    local function A(signal, fn)
        local c = signal:Connect(fn)
        table.insert(win.Conns, c)
        return c
    end

    -- ScreenGuis
    local guiName = "Pingo_" .. title
    for _, p in ipairs(candidates()) do
        local old = p:FindFirstChild(guiName)
        if old then old:Destroy() end
        local oldFloat = p:FindFirstChild(guiName .. "_Float")
        if oldFloat then oldFloat:Destroy() end
    end

    local gui = new("ScreenGui", {Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
    local floatGui = new("ScreenGui", {Name = guiName .. "_Float", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 998, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})

    for _, p in ipairs(candidates()) do
        pcall(function() gui.Parent = p; floatGui.Parent = p end)
        if gui.Parent == p then break end
    end
    win.Gui, win.FloatGui = gui, floatGui

    local function makeDraggable(handle, target, onTap, canDrag)
        local dragging, moved, startMouse, startPos = false, false, nil, nil
        handle.InputBegan:Connect(function(input)
            if isPress(input) then
                dragging, moved = true, false
                startMouse, startPos = input.Position, target.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        if dragging and not moved and onTap then onTap() end
                        dragging = false
                    end
                end)
            end
        end)
        A(UIS.InputChanged, function(input)
            if dragging and isMove(input) then
                local d = input.Position - startMouse
                if d.Magnitude > 6 then moved = true end
                if moved and (not canDrag or canDrag()) then
                    target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end
        end)
    end

    local function attachHold(hit, onHold, onTap)
        local st = {pressing = false, held = false, moved = false, start = nil, token = 0}
        hit.InputBegan:Connect(function(input)
            if not isPress(input) then return end
            st.pressing, st.held, st.moved = true, false, false
            st.start = input.Position
            st.token = st.token + 1
            local my = st.token
            task.delay(HOLD_TIME, function()
                if st.pressing and st.token == my and not st.moved then
                    st.held = true
                    if onHold then onHold() end
                end
            end)
        end)
        A(UIS.InputChanged, function(input)
            if st.pressing and st.start and isMove(input) and (input.Position - st.start).Magnitude > 8 then
                st.moved = true
            end
        end)
        A(UIS.InputEnded, function(input)
            if isPress(input) then st.pressing = false end
        end)
        hit.MouseButton1Click:Connect(function()
            if st.held or st.moved then return end
            if onTap then onTap() end
        end)
    end

    -- Holder / Main
    local Holder = new("Frame", {Name = "Holder", Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, Parent = gui})
    local fitScale = new("UIScale", {Parent = Holder})
    local function targetScale()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local fit = math.clamp(math.min((vp.X - 20) / W, (vp.Y - 20) / (H + 56)), 0.4, 1)
        return math.clamp(fit * win.SizeMul, 0.3, 1.8)
    end
    local function refit(animate)
        if animate then tw(fitScale, 0.3, {Scale = targetScale()}, Q) else fitScale.Scale = targetScale() end
    end
    refit(false)

    local Main = new("CanvasGroup", {Name = "Main", Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0, GroupTransparency = 1, Parent = Holder}, {corner(12)})
    bind(Main, "BackgroundColor3", "Background")
    local openScale = new("UIScale", {Scale = 0.88, Parent = Main})
    local mainStroke = new("UIStroke", {Thickness = 1.5, Parent = Main})
    bind(mainStroke, "Color", "Stroke")

    -- Sidebar
    local Sidebar = new("Frame", {Name = "Sidebar", Size = UDim2.new(0, 170, 1, 0), BorderSizePixel = 0, Parent = Main})
    bind(Sidebar, "BackgroundColor3", "Sidebar")
    local divider = new("Frame", {Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BorderSizePixel = 0, Parent = Sidebar})
    bind(divider, "BackgroundColor3", "Stroke")

    local dragArea = new("Frame", {Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, Active = true, Parent = Sidebar})
    makeDraggable(dragArea, Holder, nil, function() return not win.Locked end)

    local titleRow = new("Frame", {Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 30), BackgroundTransparency = 1, Parent = Sidebar}, {
        new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder}),
    })
    local titleLbl = mkText("TextLabel", {Text = title, Font = Enum.Font.GothamBold, TextSize = 22, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 30), Parent = titleRow}, "White")
    grad({"Accent", "Accent2"}, titleLbl)
    mkText("TextLabel", {Text = version, Font = Enum.Font.Gotham, TextSize = 11, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 20), Parent = titleRow}, "SubText")

    local navH = H - 62
    local Nav = new("Frame", {Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, -1, 1, -62), BackgroundTransparency = 1, Parent = Sidebar})
    local Pill = new("Frame", {Name = "Pill", Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, 38), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Visible = false, Parent = Nav}, {corner(9)})
    grad({"AccentDark", "Accent2Dark"}, Pill)

    local function movePill(y)
        Pill.Position = UDim2.fromOffset(10, y)
        Pill.Visible = true
    end

    -- Content
    local Content = new("Frame", {Name = "Content", Position = UDim2.fromOffset(170, 0), Size = UDim2.new(1, -170, 1, 0), BackgroundTransparency = 1, Parent = Main})
    local SearchBar = new("Frame", {Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 38), BorderSizePixel = 0, Parent = Content}, {corner(8)})
    bind(SearchBar, "BackgroundColor3", "Sidebar")
    local searchStroke = new("UIStroke", {Thickness = 1, Parent = SearchBar})
    bind(searchStroke, "Color", "Stroke")
    local searchIcon = new("ImageLabel", {Image = ICONS.Search, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Parent = SearchBar})
    bind(searchIcon, "ImageColor3", "SubText")

    local SearchBox = mkText("TextBox", {Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -48, 1, 0), Text = "", PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = SearchBar}, "Text")
    bind(SearchBox, "PlaceholderColor3", "SubText")

    local TabBarHolder = new("Frame", {Position = UDim2.fromOffset(16, 60), Size = UDim2.new(1, -32, 0, 36), BackgroundTransparency = 1, Parent = Content})
    local PagesHolder = new("Frame", {Position = UDim2.fromOffset(16, 106), Size = UDim2.new(1, -32, 1, -118), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Content})

    local SearchPage = new("ScrollingFrame", {Name = "SearchPage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false, Parent = PagesHolder}, {
        new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8)}),
        new("UIGridLayout", {CellSize = UDim2.new(0.5, -8, 0, CELL_H), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder}),
    })

    -- Search Logic & Refresh
    function win:_refresh()
        local q = string.lower(win.SearchText or ""):gsub("^%s+", ""):gsub("%s+$", "")
        for _, e in ipairs(win.Elements) do
            if e.Star then e.Star.Visible = e.Favourite == true end
            if e.Frame then
                if e.Hidden then
                    e.Frame.Visible = false
                elseif q == "" then
                    e.Frame.Parent = e.Page
                    e.Frame.Visible = true
                else
                    local match = string.find(string.lower(e.Name), q, 1, true) ~= nil
                    e.Frame.Parent = match and SearchPage or e.Page
                    e.Frame.Visible = match
                end
            end
        end
    end

    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        win.SearchText = SearchBox.Text
        if SearchBox.Text ~= "" then
            TabBarHolder.Visible = false
            SearchPage.Visible = true
        else
            TabBarHolder.Visible = true
            SearchPage.Visible = false
        end
        win:_refresh()
    end)

    -- Context Menu (Properties)
    function win:_closeContext()
        if win.ActiveMenu then win.ActiveMenu:Destroy(); win.ActiveMenu = nil end
    end

    function win:_showContext(title, items, pos)
        win:_closeContext()
        local ov = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 100, Parent = gui})
        ov.MouseButton1Click:Connect(function() win:_closeContext() end)
        win.ActiveMenu = ov

        local panel = new("Frame", {Position = UDim2.fromOffset(pos.X, pos.Y), Size = UDim2.fromOffset(160, 30 + #items * 32), BorderSizePixel = 0, ZIndex = 101, Parent = ov}, {corner(8)})
        bind(panel, "BackgroundColor3", "Sidebar")
        bind(new("UIStroke", {Thickness = 1, Parent = panel}), "Color", "Stroke")

        mkText("TextLabel", {Text = string.upper(title), Font = Enum.Font.GothamBold, TextSize = 10, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 18), Parent = panel}, "SubText")
        for i, it in ipairs(items) do
            local btn = new("TextButton", {Position = UDim2.fromOffset(6, 26 + (i - 1) * 32), Size = UDim2.new(1, -12, 0, 28), AutoButtonColor = false, Text = "  " .. it.Text, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel}, {corner(6)})
            bind(btn, "BackgroundColor3", "Card")
            bind(btn, "TextColor3", "Text")
            btn.MouseButton1Click:Connect(function()
                win:_closeContext()
                if it.Run then it.Run() end
            end)
        end
    end

    function win:_elementMenu(rec)
        local items = {
            {Text = rec.Favourite and "Unfavourite" or "Favourite", Run = function()
                rec.Favourite = not rec.Favourite
                win:_refresh()
            end},
            {Text = rec.Hidden and "Unhide" or "Hide", Run = function()
                rec.Hidden = not rec.Hidden
                win:_refresh()
            end},
        }
        if rec.Kind == "Toggle" or rec.Kind == "Slider" or rec.Kind == "Button" then
            if not rec.Floating then
                table.insert(items, {Text = "Floating Widget", Run = function() win:_makeFloat(rec) end})
            else
                table.insert(items, {Text = "Remove Float", Run = function() win:_removeFloat(rec) end})
            end
        end
        local p = rec.Card.AbsolutePosition
        win:_showContext(rec.Name, items, Vector2.new(p.X + 100, p.Y + 20))
    end

    -- Floating Widgets System
    function win:_makeFloat(rec)
        if rec.Floating then return end
        local fl = {X = 100 + (#win.Floats * 20), Y = 100 + (#win.Floats * 20), Locked = false}
        rec.Floating = fl

        local isSlider = rec.Kind == "Slider"
        local W = isSlider and 150 or 120

        local frame = new("Frame", {Size = UDim2.fromOffset(W, 36), Position = UDim2.fromOffset(fl.X, fl.Y), BorderSizePixel = 0, ZIndex = 50, Parent = floatGui}, {corner(8)})
        bind(frame, "BackgroundColor3", "Sidebar")
        bind(new("UIStroke", {Thickness = 1.5, Parent = frame}), "Color", "Accent")
        fl.Frame = frame

        local lbl = mkText("TextLabel", {Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = rec.Name, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame})

        local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = frame})
        makeDraggable(hit, frame, nil, function() fl.X, fl.Y = frame.Position.X.Offset, frame.Position.Y.Offset end)

        hit.MouseButton1Click:Connect(function()
            if rec.Kind == "Button" and rec.Fire then rec.Fire()
            elseif rec.Kind == "Toggle" and rec.Set then rec.Set(not rec.Get()) end
        end)

        table.insert(win.Floats, rec)
    end

    function win:_removeFloat(rec)
        if rec.Floating and rec.Floating.Frame then
            rec.Floating.Frame:Destroy()
        end
        rec.Floating = nil
        for i, r in ipairs(win.Floats) do if r == rec then table.remove(win.Floats, i) break end end
    end

    -- Card Base
    local function newCard(name)
        win.Counter = win.Counter + 1
        local outer = new("Frame", {Name = tostring(name), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = win.Counter})
        local body = new("Frame", {Name = "Body", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = outer}, {corner(8)})
        bind(body, "BackgroundColor3", "Card")
        local st = new("UIStroke", {Name = "CardStroke", Thickness = 1, Transparency = 0.35, Parent = body})
        bind(st, "Color", "Stroke")

        local star = new("ImageLabel", {Name = "Star", Image = ICONS.Star, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Visible = false, Parent = body})
        bind(star, "ImageColor3", "Accent")

        return body, star
    end

    local function finish(tab, body, name)
        local outer = body.Parent
        outer.Parent = tab.Page
        table.insert(tab.Cards, outer)
    end

    -- Tabs & SideTabs
    local function createTab(st, name, opts)
        opts = opts or {}
        local tab = {Name = name, SideTab = st, Cards = {}, Index = #st.Tabs + 1}
        local btn = new("TextButton", {Name = name, Text = name, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = st.TabInner})
        bind(btn, "TextColor3", "SubText")
        tab.Button = btn

        local group = new("CanvasGroup", {Name = st.Name .. "_" .. name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1, Visible = false, Parent = PagesHolder})
        local page = new("ScrollingFrame", {Name = "Page", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = group}, {
            new("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8)}),
            new("UIGridLayout", {CellSize = opts.CellSize or UDim2.new(0.5, -8, 0, CELL_H), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder}),
        })
        tab.Group, tab.Page = group, page
        table.insert(st.Tabs, tab)

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(st.Tabs) do
                t.Group.Visible = (t == tab)
                bind(t.Button, "TextColor3", (t == tab) and "White" or "SubText")
            end
            st.ActiveTab = tab
        end)

        -- Elements API
        function tab:AddButton(a, callback, extra)
            local o = type(a) == "table" and a or merge({Name = a, Callback = callback}, extra)
            local body, star = newCard(o.Name)
            header(body, o, 0, 14)
            local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = body})
            local rec = {Name = o.Name, Kind = "Button", Card = body, Star = star, Page = page, Frame = body.Parent}
            rec.Fire = function() if o.Callback then task.spawn(o.Callback) end end
            attachHold(hit, function() win:_elementMenu(rec) end, rec.Fire)
            table.insert(win.Elements, rec)
            finish(tab, body, o.Name)
            return rec
        end

        function tab:AddToggle(a, default, callback, extra)
            local o = type(a) == "table" and a or merge({Name = a, Default = default, Callback = callback}, extra)
            local state = o.Default == true
            local body, star = newCard(o.Name)
            header(body, o, 0, 64)
            local sw = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(40, 22), BorderSizePixel = 0, Parent = body}, {corner(11)})
            bind(sw, "BackgroundColor3", state and "Accent" or "Off")
            local knob = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(16, 16), Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sw}, {corner(8)})
            local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = body})
            local rec = {Name = o.Name, Kind = "Toggle", Card = body, Star = star, Page = page, Frame = body.Parent}

            local function apply(v, fire)
                state = v
                bind(sw, "BackgroundColor3", state and "Accent" or "Off", true)
                tw(knob, 0.2, {Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
                if fire and o.Callback then task.spawn(o.Callback, state) end
            end
            rec.Set = function(v) apply(v == true, true) end
            rec.Get = function() return state end

            attachHold(hit, function() win:_elementMenu(rec) end, function() apply(not state, true) end)
            table.insert(win.Elements, rec)
            finish(tab, body, o.Name)
            return rec
        end

        function tab:AddSlider(a, mn, mx, default, callback, increment, extra)
            local o = type(a) == "table" and a or merge({Name = a, Min = mn, Max = mx, Default = default, Callback = callback, Increment = increment}, extra)
            local min, max = o.Min or 0, o.Max or 100
            local inc = o.Increment or 1
            local body, star = newCard(o.Name)
            header(body, o, 0, 84, 44)

            local valLbl = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4), Size = UDim2.fromOffset(68, 20), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(default or min), Parent = body}, "Accent")
            local track = new("Frame", {Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 0, 6), BorderSizePixel = 0, Parent = body}, {corner(3)})
            bind(track, "BackgroundColor3", "Off")
            local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track}, {corner(3)})
            grad({"Accent", "Accent2"}, fill)

            local value = min
            local rec = {Name = o.Name, Kind = "Slider", Card = body, Star = star, Page = page, Frame = body.Parent}

            local function apply(v, fire)
                v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
                value = v
                valLbl.Text = tostring(value)
                local pct = (max == min) and 0 or (value - min) / (max - min)
                tw(fill, 0.15, {Size = UDim2.fromScale(pct, 1)})
                if fire and o.Callback then task.spawn(o.Callback, value) end
            end

            rec.Set = function(v) apply(v, true) end
            rec.Get = function() return value end
            apply(o.Default or min, false)

            local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = body})
            local dragging = false
            hit.InputBegan:Connect(function(i) if isPress(i) then dragging = true; apply(min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1), true) end end)
            A(UIS.InputChanged, function(i) if dragging and isMove(i) then apply(min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1), true) end end)
            A(UIS.InputEnded, function(i) if isPress(i) then dragging = false end end)

            attachHold(hit, function() win:_elementMenu(rec) end, nil)
            table.insert(win.Elements, rec)
            finish(tab, body, o.Name)
            return rec
        end

        function tab:AddDropdown(o)
            o = o or {}
            local options = o.Options or {}
            local multi = o.Multi == true
            local maxSel = multi and (o.Max or math.huge) or 1
            local body, star = newCard(o.Name)
            header(body, o, 0, 120)

            local selLbl = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -30, 0, 32), Size = UDim2.fromOffset(100, 20), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, Text = "None", Parent = body}, "SubText")
            local arrow = mkText("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, 32), Size = UDim2.fromOffset(14, 14), Text = "▼", Font = Enum.Font.GothamBold, TextSize = 10, Parent = body}, "Accent")

            local dropFrame = new("Frame", {Position = UDim2.fromOffset(0, CELL_H), Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, BackgroundTransparency = 1, Parent = body})
            local searchBox = mkText("TextBox", {Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 24), PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 11, Parent = dropFrame}, "Text")
            bind(searchBox, "BackgroundColor3", "Sidebar")

            local list = new("ScrollingFrame", {Position = UDim2.fromOffset(10, 32), Size = UDim2.new(1, -20, 1, -36), BackgroundTransparency = 1, ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = dropFrame}, {
                new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder})
            })

            local selected, buttons, open = {}, {}, false
            local rec = {Name = o.Name, Kind = "Dropdown", Card = body, Star = star, Page = page, Frame = body.Parent}

            local function values()
                local out = {}
                for _, n in ipairs(options) do if selected[n] then table.insert(out, n) end end
                return out
            end

            local function render()
                local vals = values()
                selLbl.Text = #vals == 0 and "None" or (multi and (#vals .. " Selected") or tostring(vals[1]))
                for _, b in ipairs(buttons) do bind(b.Btn, "BackgroundColor3", selected[b.Name] and "Accent" or "Sidebar") end
            end

            local function setOpen(v)
                open = v
                local openH = CELL_H + 130
                tw(body.Parent, 0.3, {Size = UDim2.new(0.5, -8, 0, open and openH or CELL_H)})
                tw(body, 0.3, {Size = UDim2.new(1, 0, 0, open and openH or CELL_H)})
                tw(dropFrame, 0.3, {Size = UDim2.new(1, 0, 0, open and 130 or 0)})
                tw(arrow, 0.3, {Rotation = open and 180 or 0})
            end

            for _, name in ipairs(options) do
                local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 22), Text = "  " .. tostring(name), Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, Parent = list}, {corner(4)})
                bind(btn, "BackgroundColor3", "Sidebar")
                bind(btn, "TextColor3", "Text")
                btn.MouseButton1Click:Connect(function()
                    if multi then
                        if selected[name] then selected[name] = nil
                        elseif #values() < maxSel then selected[name] = true end
                    else
                        selected = {[name] = true}
                        setOpen(false)
                    end
                    render()
                    if o.Callback then task.spawn(o.Callback, multi and values() or values()[1]) end
                end)
                table.insert(buttons, {Name = name, Btn = btn})
            end

            local hit = new("TextButton", {Size = UDim2.new(1, 0, 0, CELL_H), BackgroundTransparency = 1, Text = "", Parent = body})
            attachHold(hit, function() win:_elementMenu(rec) end, function() setOpen(not open) end)

            table.insert(win.Elements, rec)
            finish(tab, body, o.Name)
            return rec
        end

        return tab
    end

    local topCount = 0
    local function createSideTab(name, iconId, bottom)
        local st = {Name = name, Tabs = {}}
        topCount = topCount + 1
        st.Y = 2 + (topCount - 1) * 42

        local btn = new("TextButton", {Name = name, Position = UDim2.fromOffset(10, st.Y), Size = UDim2.new(1, -20, 0, 38), Text = "", AutoButtonColor = false, BackgroundTransparency = 1, ZIndex = 2, Parent = Nav})
        local ico = icon(iconId)
        if ico then
            local im = new("ImageLabel", {Image = ico, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, ZIndex = 3, Parent = btn})
            bind(im, "ImageColor3", "Text")
        end
        mkText("TextLabel", {Text = name, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -46, 1, 0), ZIndex = 3, Parent = btn})

        st.TabBar = new("CanvasGroup", {Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, Visible = false, Parent = TabBarHolder}, {corner(8)})
        bind(st.TabBar, "BackgroundColor3", "Sidebar")
        st.TabInner = new("Frame", {Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), BackgroundTransparency = 1, Parent = st.TabBar})

        btn.MouseButton1Click:Connect(function()
            for _, o in ipairs(win.SideTabs) do o.TabBar.Visible = (o == st) end
            movePill(st.Y)
            if #st.Tabs > 0 then
                st.Tabs[1].Group.Visible = true
                st.ActiveTab = st.Tabs[1]
            end
        end)

        table.insert(win.SideTabs, st)
        function st:CreateTab(tabName) return createTab(st, tabName) end
        return st
    end

    function win:CreateSideTab(name, iconId)
        local st = createSideTab(name, iconId)
        if #win.SideTabs == 1 then movePill(st.Y); st.TabBar.Visible = true end
        return st
    end

    -- Config Tab Initialization
    local SettingsSide = win:CreateSideTab("Settings", ICONS.Settings)
    local ConfigTab = SettingsSide:CreateTab("Config")
    local ThemesTab = SettingsSide:CreateTab("Themes")

    -- Config UI Layout
    local cfgBar = new("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, Parent = ConfigTab.Page})
    local nameBox = mkText("TextBox", {Size = UDim2.new(0.5, -5, 1, 0), PlaceholderText = "Config Name...", Text = "", Parent = cfgBar}, "Text")
    bind(nameBox, "BackgroundColor3", "Sidebar")

    local saveBtn, saveLbl = pill(cfgBar, {Text = "Save", Style = "Primary"}, {Size = UDim2.new(0.25, -5, 1, 0), Position = UDim2.new(0.5, 5, 0, 0)})
    local loadBtn, loadLbl = pill(cfgBar, {Text = "Load", Style = "Default"}, {Size = UDim2.new(0.25, -5, 1, 0), Position = UDim2.new(0.75, 5, 0, 0)})

    local function refreshConfigs()
        for _, r in ipairs(win.CfgRows) do r:Destroy() end
        win.CfgRows = {}
        for _, cfgName in ipairs(fsList()) do
            local card, star = newCard(cfgName)
            header(card, {Name = cfgName, Description = "Profile"}, 0, 14)
            local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = card})
            hit.MouseButton1Click:Connect(function()
                nameBox.Text = cfgName
                win.SelectedConfig = cfgName
            end)
            finish(ConfigTab, card, cfgName)
            table.insert(win.CfgRows, card.Parent)
        end
    end

    saveBtn.MouseButton1Click:Connect(function()
        local name = sanitize(nameBox.Text)
        if name == "" then return end
        local data = {}
        for _, e in ipairs(win.Elements) do
            if e.Get then data[e.Name] = e.Get() end
        end
        fsWrite(cfgPath(name), HttpService:JSONEncode(data))
        refreshConfigs()
    end)

    loadBtn.MouseButton1Click:Connect(function()
        local name = sanitize(nameBox.Text)
        local raw = fsRead(cfgPath(name))
        if not raw then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(data) == "table" then
            for _, e in ipairs(win.Elements) do
                if data[e.Name] ~= nil and e.Set then e.Set(data[e.Name]) end
            end
        end
    end)

    refreshConfigs()

    -- Themes Tab Grid
    for _, info in ipairs(THEME_LIST) do
        local tname = info[1]
        local body = newCard(tname)
        mkText("TextLabel", {Text = tname, Font = Enum.Font.GothamBold, TextSize = 12, Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 20), Parent = body})
        local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = body})
        hit.MouseButton1Click:Connect(function() Pingo.SetTheme(tname) end)
        finish(ThemesTab, body, tname)
    end

    -- Toggle & Unload
    function win:Toggle(state)
        if state == nil then state = not win.Opened end
        win.Opened = state
        Holder.Visible = state
        if state then tw(openScale, 0.3, {Scale = 1}); tw(Main, 0.3, {GroupTransparency = 0}) end
    end

    A(UIS.InputBegan, function(input, gp)
        if gp then return end
        if input.KeyCode == (config.Key or Enum.KeyCode.RightShift) then win:Toggle() end
    end)

    task.defer(function() win:Toggle(true) end)
    return win
end

return Pingo
